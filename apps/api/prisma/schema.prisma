// ---------------------------------------------------------------------------
// Owner 2026-10-02 — admin growth & support tools. Status/kind columns are
// short strings validated by the DTOs (no new enum types: a new value of an
// existing enum can't be used in the same migration transaction). User/admin ids are plain UUID
// columns so these tables don't add back-relations to `User`.
// ---------------------------------------------------------------------------

// Free subscription under a contract (blogger attorneys): 3–12 months,
// optionally with assistant seats. SubscriptionAccessService treats an
// unrevoked grant inside [starts_at, ends_at) as an active subscription.
model ContractGrant {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  months          Int       @db.SmallInt
  assistant_seats Int       @default(0) @db.SmallInt
  starts_at       DateTime  @db.Timestamptz
  ends_at         DateTime  @db.Timestamptz
  // Contract reference / blogger handle, shown to admins only.
  contract_ref    String?   @db.VarChar(200)
  note            String?   @db.VarChar(1000)
  created_by      String    @db.Uuid
  revoked_at      DateTime? @db.Timestamptz
  revoked_by      String?   @db.Uuid
  revoke_reason   String?   @db.VarChar(500)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz

  @@index([user_id, ends_at])
  @@index([ends_at])
  @@map("contract_grants")
}

// Owner 2026-10-05: an attorney asks for more assistant seats than the
// global limit; an admin approves (sets attorney_profiles.
// assistant_seat_limit) or rejects.
model SeatLimitRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attorney_id     String    @db.Uuid
  requested_seats Int       @db.SmallInt
  note            String?   @db.VarChar(1000)
  // pending | approved | rejected
  status          String    @default("pending") @db.VarChar(20)
  granted_seats   Int?      @db.SmallInt
  decision_note   String?   @db.VarChar(500)
  decided_by      String?   @db.Uuid
  decided_at      DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz

  @@index([status, created_at], map: "seat_limit_requests_status_created_idx")
  @@index([attorney_id, created_at], map: "seat_limit_requests_attorney_created_idx")
  @@map("seat_limit_requests")
}

// Promo codes: percent / fixed amount off, or free days of subscription.
model PromoCode {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Upper-case, unique.
  code             String    @unique @db.VarChar(40)
  description      String?   @db.VarChar(300)
  // percent | amount | free_days
  discount_type    String    @db.VarChar(16)
  percent_off      Int?      @db.SmallInt
  amount_off_cents Int?
  free_days        Int?
  // all | attorney | client
  audience         String    @default("attorney") @db.VarChar(16)
  // any | monthly | yearly | promotion
  applies_to       String    @default("any") @db.VarChar(16)
  max_redemptions  Int?
  redeemed_count   Int       @default(0)
  starts_at        DateTime? @db.Timestamptz
  expires_at       DateTime? @db.Timestamptz
  active           Boolean   @default(true)
  // Owner 2026-10-05: «удалить» a code that was already used archives it
  // (history of payments keeps pointing at it); unused codes are deleted.
  archived_at      DateTime? @db.Timestamptz
  stripe_coupon_id String?
  created_by       String    @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz

