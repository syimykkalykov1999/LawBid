  waiting_since        DateTime?    @db.Timestamptz
  /// My note pinned on the chat ("send him the documents").
  note                 String?      @db.VarChar(280)
  pinned_at            DateTime?    @db.Timestamptz
  /// Owner 2026-10-02: "deleted" from my list (only for me); a new message
  /// brings the chat back. The history itself is never erased.
  hidden_at            DateTime?    @db.Timestamptz
  created_at           DateTime     @default(now()) @db.Timestamptz
  updated_at           DateTime     @updatedAt @db.Timestamptz

  @@id([conversation_id, user_id])
  @@index([user_id])
  @@map("conversation_participants")
}

/// OQ-041 (owner 2026-09-30): an in-app audio call between the two chat
/// members (WebRTC; the server relays signaling, never the audio).
model Call {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String       @db.Uuid
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  caller_id       String       @db.Uuid
  caller          User         @relation("CallCaller", fields: [caller_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  callee_id       String       @db.Uuid
  callee          User         @relation("CallCallee", fields: [callee_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  status          CallStatus   @default(ringing)
  answered_at     DateTime?    @db.Timestamptz
  ended_at        DateTime?    @db.Timestamptz
  duration_sec    Int?
  end_reason      String?
  /// Owner 2026-10-05: a video call (camera on both sides).
  video           Boolean      @default(false)
  created_at      DateTime     @default(now()) @db.Timestamptz
  updated_at      DateTime     @updatedAt @db.Timestamptz

  @@index([callee_id, status])
  @@index([caller_id, status])
  @@index([conversation_id, created_at])
  @@index([status, created_at])
  @@map("calls")
}

model Message {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id       String       @db.Uuid
  conversation          Conversation @relation(fields: [conversation_id], references: [id], onDelete: Restrict)
  // NULL for system messages.
  sender_id             String?      @db.Uuid
  sender                User?        @relation("MessageSender", fields: [sender_id], references: [id], onDelete: Restrict)
  type                  MessageType
  // Server/moderation/legal only (§1.6).
  body_original         String
  body_display          String
  contact_masked        Boolean      @default(false)
  // Client-generated idempotency key.
  client_message_id     String
  // OQ-040 voice messages: the audio file, its length, 0–100 bars for the
  // bubble and when the recipient first played it (Telegram's blue dot).
  file_id               String?      @db.Uuid
  file                  File?        @relation("MessageVoice", fields: [file_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  duration_ms           Int?
  waveform              Int[]        @default([])
  // OQ-047: the original name of an attached document (≤200, CHECK).
  file_name             String?
  // OQ-048: sent by an assistant on the attorney's behalf.
  sent_by_membership_id String?      @db.Uuid
  sent_by_name          String?      @db.VarChar(80)
  listened_at           DateTime?    @db.Timestamptz
  // Owner 2026-10-01: a sticker message.
  sticker_id            String?      @db.Uuid
  sticker               Sticker?     @relation(fields: [sticker_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "messages_sticker_fkey")
  deleted_at            DateTime?    @db.Timestamptz
  created_at            DateTime     @default(now()) @db.Timestamptz
  updated_at            DateTime     @updatedAt @db.Timestamptz

  @@unique([conversation_id, sender_id, client_message_id])
  @@index([file_id])
  @@index([sticker_id])
  @@index([conversation_id, created_at(sort: Desc)])
  // docs/06 §5.1: anonymization scrubs a user's messages by sender.
  @@index([sender_id])
  @@map("messages")
}

model Notification {
