model AdminProfile {
  user_id     String    @id @db.Uuid
  user        User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  admin_role  AdminRole
  // Per-area access for non-super admins: {"users":"view","support":"manage"}.
  // Money and API keys are never grantable (hard-denied in the API).
