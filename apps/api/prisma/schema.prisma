// Owner 2026-10-05: partner (affiliate) program. A partner is a user the
// admin pays per referred attorney who buys a subscription and per
// referred client who hires (plus an optional monthly base). Attribution
// reuses referral_codes / referrals; this is the pay side.
model Partner {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String    @unique @db.Uuid
  // active | paused | ended
  status              String    @default("active") @db.VarChar(16)
  // How the admin calls them ("blogger Ivan"); admin only.
  label               String?   @db.VarChar(120)
  note                String?   @db.VarChar(1000)
  // null = program default (app_config partners.program).
  attorney_rate_cents Int?
  client_rate_cents   Int?
  monthly_base_cents  Int       @default(0)
  // null = program default; case_published | bid_accepted
  client_rule         String?   @db.VarChar(24)
  hold_days           Int?      @db.SmallInt
  created_by          String?   @db.Uuid
  // Owner 2026-10-05: partner without an app account (user is a placeholder
  // row, users.placeholder_kind = external_partner): who they are and how
  // to reach them, admin only. Cleared when a real account is linked.
  external_name       String?   @db.VarChar(120)
  external_contact    String?   @db.VarChar(200)
  // Owner 2026-10-05 («Продвижение»): may create demo accounts for videos.
  demo_access         Boolean   @default(false)
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @updatedAt @db.Timestamptz
  ended_at            DateTime? @db.Timestamptz
  // Owner 2026-10-05 (legal): the partner rules (FTC disclosure, no spam,
  // independent contractor, ...) accepted in the app — when, which
  // version (PARTNER_TERMS_VERSION) and from which IP.
  terms_accepted_at   DateTime? @db.Timestamptz
  terms_version       String?   @db.VarChar(16)
  terms_ip            String?   @db.VarChar(45)
  // A W-9 (or W-8) on file; required before the first payout when
  // partners.program.requireW9 is on (IRS 1099 reporting).
  w9_received_at      DateTime? @db.Timestamptz

  commissions PartnerCommission[]
  leads       OutreachLead[]

  @@index([status, created_at])
  @@map("partners")
}

// One accrual (or payout adjustment) of a partner. `event_ref` makes an
// accrual idempotent per qualifying event. held → approved (after the
// anti-fraud hold or by an admin) → paid; reversed on refund / rejection.
model PartnerCommission {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partner_id       String    @db.Uuid
  partner          Partner   @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  partner_user_id  String    @db.Uuid
  referral_id      String?   @db.Uuid
  referred_user_id String?   @db.Uuid
  // attorney_subscription | client_qualified | monthly_base | adjustment
  kind             String    @db.VarChar(32)
  // Negative for a reversal of an already paid commission.
  amount_cents     Int
  // held | approved | paid | reversed
  status           String    @default("held") @db.VarChar(16)
  // "referral:<id>:attorney_subscription", "base:<partnerId>:2026-10", ...
  event_ref        String    @unique @db.VarChar(120)
  // Payroll period YYYY-MM the accrual belongs to.
  period           String    @db.VarChar(7)
  // null while held = manual hold (released only by an admin).
  hold_until       DateTime? @db.Timestamptz
  approved_at      DateTime? @db.Timestamptz
  approved_by      String?   @db.Uuid
  paid_at          DateTime? @db.Timestamptz
  paid_by          String?   @db.Uuid
  payout_ref       String?   @db.VarChar(120)
  reversed_at      DateTime? @db.Timestamptz
  reversed_reason  String?   @db.VarChar(300)
  note             String?   @db.VarChar(300)
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz

  @@index([partner_id, created_at(sort: Desc)])
  @@index([status, hold_until])
  @@index([referred_user_id])
  @@index([period, status])
  @@map("partner_commissions")
}

/// Owner 2026-10-05: outreach (Привлечение). A lead is a lawyer or a
/// prospective client the team cold-calls or emails; assigned to a
/// partner (employee) whose referral link the lead is invited with.
/// status: new | working | contacted | replied | registered | paid | lost.
/// source: csv | manual | ny_registry. kind: attorney | client.
model OutreachLead {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                  String    @default("attorney") @db.VarChar(10)
  first_name            String?   @db.VarChar(80)
  last_name             String?   @db.VarChar(80)
  company               String?   @db.VarChar(160)
  state_code            String?   @db.VarChar(2)
  city                  String?   @db.VarChar(80)
  practice              String?   @db.VarChar(80)
  // Digits only (E.164 without "+"); unique when present.
  phone                 String?   @unique @db.VarChar(20)
  // Lower-cased; unique when present.
  email                 String?   @unique @db.VarChar(254)
  source                String    @default("manual") @db.VarChar(20)
  source_ref            String?   @db.VarChar(64)
  status                String    @default("new") @db.VarChar(16)
  partner_id            String?   @db.Uuid
  partner               Partner?  @relation(fields: [partner_id], references: [id], onDelete: SetNull)
  converted_user_id     String?   @db.Uuid
  unsubscribe_token     String    @unique @db.VarChar(48)
  unsubscribed_at       DateTime? @db.Timestamptz
  last_activity_at      DateTime? @db.Timestamptz
  next_action_at        DateTime? @db.Timestamptz
  note                  String?   @db.VarChar(2000)
  // Owner 2026-10-05 (legal): do-not-contact (TCPA / DNC). Reason:
  // manual | not_interested | wrong_number | unsubscribed | suppression |
  // retention. While set, phone and email are hidden and no call/email
  // may be logged or sent.
  do_not_contact_at     DateTime? @db.Timestamptz
  do_not_contact_reason String?   @db.VarChar(24)
  // Where the contact came from and on what basis we may reach out
  // (required for CSV imports and for client leads).
  source_note           String?   @db.VarChar(300)
  // Cold emails sent to this lead (cap + cooldown in outreach settings).
  emails_sent           Int       @default(0) @db.Integer
  last_email_at         DateTime? @db.Timestamptz
  created_by            String    @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamptz
  updated_at            DateTime  @updatedAt @db.Timestamptz

  activities OutreachActivity[]

  @@index([partner_id, status, created_at])
  @@index([status, created_at])
  @@index([state_code, kind])
  @@index([converted_user_id])
  @@index([next_action_at])
  @@index([do_not_contact_at])
  @@map("outreach_leads")
}

/// One touch on a lead: call | email | note | status | assign | system.
/// outcome (calls): no_answer | voicemail | talked | interested |
/// not_interested | callback | wrong_number; (emails): sent | failed.
model OutreachActivity {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id        String       @db.Uuid
  lead           OutreachLead @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  partner_id     String?      @db.Uuid
  actor_admin_id String?      @db.Uuid
  kind           String       @db.VarChar(12)
  outcome        String?      @db.VarChar(24)
  body           String?      @db.VarChar(4000)
  meta           Json?
  created_at     DateTime     @default(now()) @db.Timestamptz

  @@index([lead_id, created_at])
  @@index([partner_id, kind, created_at])
  @@index([created_at])
  @@map("outreach_activities")
}

/// Cold-email templates: {{first_name}} {{last_name}} {{company}}
/// {{sender_name}} {{link}} (the partner's referral link). kind:
/// attorney | client | any.
model OutreachTemplate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(80)
  kind       String   @default("any") @db.VarChar(10)
  subject    String   @db.VarChar(200)
  body       String   @db.VarChar(8000)
  active     Boolean  @default(true)
  created_by String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  @@index([active, kind])
  @@map("outreach_templates")
}

/// Owner 2026-10-05 (legal): outreach stop-list — phones (digits only) and
/// e-mails (lower-cased) that must never be called or written to, from
/// the admin's manual list and from deleted do-not-contact leads.
model OutreachSuppression {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // phone | email
  kind       String   @db.VarChar(8)
  value      String   @db.VarChar(254)
  note       String?  @db.VarChar(200)
  created_by String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz

  @@unique([kind, value])
  @@map("outreach_suppressions")
}

// Paid case promotion (~$10/day): the case is boosted in attorneys' feeds.
// Owner 2026-10-05: also posts (Instagram-style boost, no subscription):
// target_type = case | post; the owner picks a daily budget and days, the
// budget buys target_impressions at the admin's CPM, and an optional
// audience (role, states, countries, topics) narrows who sees a post.
model CasePromotion {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // case | post
  target_type         String    @default("case") @db.VarChar(8)
  case_id             String?   @db.Uuid
  post_id             String?   @db.Uuid
  user_id             String    @db.Uuid
  days                Int       @db.SmallInt
  // The chosen daily budget (= price per day).
  price_cents_per_day Int
  total_cents         Int
  // pending_payment | pending_review | active | paused | finished |
  // canceled | refunded | rejected
  status              String    @db.VarChar(20)
  starts_at           DateTime? @db.Timestamptz
  ends_at             DateTime? @db.Timestamptz
  stripe_checkout_id  String?   @unique
  payment_id          String?   @db.Uuid
  promo_code_id       String?   @db.Uuid
  // Granted for free by an admin (no payment).
  granted_by          String?   @db.Uuid
  canceled_by         String?   @db.Uuid
  cancel_reason       String?   @db.VarChar(500)
  impressions         Int       @default(0)
  // Owner 2026-10-05: delivery. cpm_cents frozen at purchase; null target
  // = no cap (older rows). reach = distinct people shown it.
  cpm_cents           Int?
  target_impressions  Int?
  reach               Int       @default(0)
  clicks              Int       @default(0)
  audience            Json?
  // Owner 2026-10-15 (Boost): what the advertiser wants (views | clicks |
  // messages | followers) and the button under the ad: more | message |
  // profile | download | call, with its link / phone in cta_value.
  goal                String?   @db.VarChar(12)
  cta_type            String?   @db.VarChar(12)
  cta_value           String?   @db.VarChar(500)
  // Refunded part (admin cancel with refund).
  refunded_cents      Int       @default(0)
  // Who approved it (null = automatic) and when.
  reviewed_by         String?   @db.Uuid
  reviewed_at         DateTime? @db.Timestamptz
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @updatedAt @db.Timestamptz

  views PromotionView[]
  daily PromotionDaily[]

  @@index([status, ends_at])
  @@index([case_id])
  @@index([post_id])
  @@index([target_type, status, ends_at])
  @@index([user_id, created_at(sort: Desc)])
  @@map("case_promotions")
}

// Owner 2026-10-05: who saw a promotion — unique reach, the per-person
// daily frequency cap and clicks. One row per (promotion, viewer).
// Owner 2026-10-15: a promotion's numbers by day (UTC date) — the bars of
// its statistics.
model PromotionDaily {
  promotion_id String        @db.Uuid
  promotion    CasePromotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  day_key      String        @db.VarChar(10)
  impressions  Int           @default(0)
  reach        Int           @default(0)
  clicks       Int           @default(0)

  @@id([promotion_id, day_key])
  @@map("promotion_daily")
}

model PromotionView {
  promotion_id  String        @db.Uuid
  promotion     CasePromotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  user_id       String        @db.Uuid
  impressions   Int           @default(0)
  // Impressions on day_key (UTC date) for the daily cap.
  day_key       String        @db.VarChar(10)
  day_count     Int           @default(0)
  clicked       Boolean       @default(false)
  first_seen_at DateTime      @default(now()) @db.Timestamptz
  last_seen_at  DateTime      @default(now()) @db.Timestamptz

  @@id([promotion_id, user_id])
  @@index([user_id, last_seen_at(sort: Desc)])
  @@map("promotion_views")
}

// Support tickets from the app (any user) answered in the admin.
model SupportTicket {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  subject           String    @db.VarChar(200)
  // account | billing | verification | case | bug | abuse | other
  category          String    @default("other") @db.VarChar(20)
  // open | waiting_user | resolved | closed
  status            String    @default("open") @db.VarChar(16)
  // low | normal | high | urgent
  priority          String    @default("normal") @db.VarChar(8)
  assignee_id       String?   @db.Uuid
  unread_by_admin   Boolean   @default(true)
  unread_by_user    Boolean   @default(false)
  last_message_at   DateTime  @default(now()) @db.Timestamptz
  resolved_at       DateTime? @db.Timestamptz
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @updatedAt @db.Timestamptz
  // Owner 2026-10-05 (support 24/7): when the ticket was given to someone,
  // the team's first public answer and who gave it, who resolved it.
  assigned_at       DateTime? @db.Timestamptz
  first_response_at DateTime? @db.Timestamptz
  first_response_by String?   @db.Uuid
  resolved_by       String?   @db.Uuid
  // The answer the user is waiting for is due by sla_due_at (null = the
  // ball is on the user's side); sla_breached_at once it was missed.
  sla_due_at        DateTime? @db.Timestamptz
  sla_breached_at   DateTime? @db.Timestamptz
  // Owner 2026-10-05: the asker's country, copied at creation, so support
  // staff assigned to a country see only its tickets.
  country_code      String    @default("US") @db.Char(2)

  @@index([status, last_message_at(sort: Desc)])
  @@index([country_code, status])
  @@index([user_id, last_message_at(sort: Desc)])
  @@index([assignee_id, status])
  @@index([sla_due_at])
  @@map("support_tickets")
}

model SupportMessage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id       String   @db.Uuid
  // Exactly one of author_user_id (the app user) / author_admin_id.
  author_user_id  String?  @db.Uuid
  author_admin_id String?  @db.Uuid
  // Admin-only note, never shown to the user.
  internal        Boolean  @default(false)
  // Owner 2026-10-05: an automatic answer (after hours, "we got it"):
  // neither author id is set; shown as "LawBid Support".
  auto            Boolean  @default(false)
  body            String   @db.VarChar(5000)
  created_at      DateTime @default(now()) @db.Timestamptz

  @@index([ticket_id, created_at])
  @@map("support_messages")
}

/// Owner 2026-10-05: ready answers for support («Шаблоны ответов»).
/// `{name}` in the body becomes the user's first name.
model SupportMacro {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String   @db.VarChar(120)
  body       String   @db.VarChar(5000)
  /// null = any category.
  category   String?  @db.VarChar(20)
  active     Boolean  @default(true)
  uses       Int      @default(0)
  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  @@index([active, title])
  @@map("support_macros")
}

/// Owner 2026-10-05: a support agent's shift switch. New tickets go to the
/// agents on shift, the one with the fewest open tickets first.
model SupportAgent {
  admin_id   String   @id @db.Uuid
  on_shift   Boolean  @default(false)
  /// Open tickets at which auto-assignment skips this agent.
  max_open   Int      @default(25)
  updated_at DateTime @updatedAt @db.Timestamptz

  @@map("support_agents")
}

/// Owner 2026-10-05: «Лучший сотрудник» — a prize given to an employee for
/// a period and a department. A bonus becomes a payroll accrual.
model StaffReward {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// "2026-10" (month) or "2026-W41" (week).
  period      String   @db.VarChar(20)
  /// verification · moderation · support · finance
  department  String   @db.VarChar(24)
  admin_id    String   @db.Uuid
  rank        Int      @default(1)
  score       Int      @default(0)
  prize       String   @default("") @db.VarChar(200)
  bonus_cents Int      @default(0)
  currency    String   @default("usd") @db.VarChar(3)
  /// The payroll accrual created for the bonus, when there is one.
  accrual_id  String?  @db.Uuid
  /// Given by the period-end job (true) or by hand.
  auto        Boolean  @default(false)
  created_by  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz

  @@unique([period, department, admin_id])
  @@index([admin_id, created_at(sort: Desc)])
  @@map("staff_rewards")
}

// Admin overrides of the built-in transactional emails, per locale.
// Missing row (or enabled=false) = the built-in text is sent.
model EmailTemplate {
  key        String   @db.VarChar(64)
  locale     String   @db.VarChar(5)
  subject    String   @db.VarChar(200)
  text_body  String
  html_body  String?
  enabled    Boolean  @default(true)
  updated_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  @@id([key, locale])
  @@map("email_templates")
}

// Owner 2026-10-01: Telegram-style sticker packs. owner_user_id NULL =
// official (admin panel); status `hidden` = taken down by moderation.
model StickerPack {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_user_id String?           @db.Uuid
  owner         User?             @relation("StickerPackOwner", fields: [owner_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "sticker_packs_owner_fkey")
  title         String            @db.VarChar(64)
  short_name    String            @unique @db.VarChar(40)
  is_official   Boolean           @default(false)
  status        String            @default("active") @db.VarChar(16)
  sticker_count Int               @default(0)
  install_count Int               @default(0)
  created_at    DateTime          @default(now()) @db.Timestamptz
  updated_at    DateTime          @default(now()) @updatedAt @db.Timestamptz
  deleted_at    DateTime?         @db.Timestamptz
  stickers      Sticker[]
  installs      UserStickerPack[]

  @@index([owner_user_id, created_at(sort: Desc)], map: "sticker_packs_owner_idx")
  @@index([is_official, status, install_count(sort: Desc)], map: "sticker_packs_official_idx")
  @@map("sticker_packs")
}

model Sticker {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pack_id    String              @db.Uuid
  pack       StickerPack         @relation(fields: [pack_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "stickers_pack_fkey")
  file_id    String              @unique @db.Uuid
  file       File                @relation(fields: [file_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "stickers_file_fkey")
  emoji      String              @default("🙂") @db.VarChar(16)
  position   Int                 @default(0)
  created_at DateTime            @default(now()) @db.Timestamptz
  deleted_at DateTime?           @db.Timestamptz
  messages   Message[]
  recent     UserRecentSticker[]

  @@index([pack_id, position], map: "stickers_pack_position_idx")
  @@map("stickers")
}

model UserStickerPack {
  user_id      String      @db.Uuid
  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_sticker_packs_user_fkey")
  pack_id      String      @db.Uuid
  pack         StickerPack @relation(fields: [pack_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_sticker_packs_pack_fkey")
  position     Int         @default(0)
  installed_at DateTime    @default(now()) @db.Timestamptz

  @@id([user_id, pack_id])
  @@index([pack_id], map: "user_sticker_packs_pack_idx")
  @@map("user_sticker_packs")
}

model UserRecentSticker {
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_recent_stickers_user_fkey")
  sticker_id String   @db.Uuid
  sticker    Sticker  @relation(fields: [sticker_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_recent_stickers_sticker_fkey")
  used_at    DateTime @default(now()) @db.Timestamptz

  @@id([user_id, sticker_id])
  @@index([user_id, used_at(sort: Desc)], map: "user_recent_stickers_used_idx")
  @@map("user_recent_stickers")
}

/// Owner 2026-10-02: the paid verified badge of a client (gold). Documents
/// → approval in the admin → a $10/month subscription; the badge shows
/// only while approved AND the subscription is paid (cancel or revoke
/// removes it). One row per client.
model ClientVerification {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String    @unique @db.Uuid
  user                   User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_verifications_user_fkey")
  /// pending · approved · rejected · revoked
  status                 String    @default("pending") @db.VarChar(16)
  /// File ids (verification_document / verification_selfie), private bucket.
  document_file_ids      Json      @default("[]")
  note                   String?   @db.VarChar(500)
  submitted_at           DateTime  @default(now()) @db.Timestamptz
  reviewed_at            DateTime? @db.Timestamptz
  reviewed_by            String?   @db.Uuid
  reject_reason          String?   @db.VarChar(500)
  revoke_reason          String?   @db.VarChar(500)
  stripe_checkout_id     String?   @db.VarChar(255)
  stripe_subscription_id String?   @unique @db.VarChar(255)
  /// none · active · past_due · canceled
  sub_status             String    @default("none") @db.VarChar(16)
  current_period_end     DateTime? @db.Timestamptz
  cancel_at_period_end   Boolean   @default(false)
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz

  @@index([status, submitted_at(sort: Desc)], map: "client_verifications_queue_idx")
  @@map("client_verifications")
}

/// Owner 2026-10-03: plan prices set in the admin (Billing → Prices).
/// One active row per kind; a change inserts a new row (history). Stripe
/// prices are immutable, so each row has its own Stripe price per mode
/// (test / live / fake), created when first needed. Existing subscribers
/// keep the price they bought unless the admin moves them.
model PlanPrice {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// monthly · seat · yearly · client_badge, or a plan code / seat.<plan code>
  /// (owner 2026-10-05, plan builder).
  kind               String   @db.VarChar(64)
  amount_cents       Int
  currency           String   @default("usd") @db.VarChar(3)
  active             Boolean  @default(true)
  /// {"test": "price_…", "live": "price_…", "fake": "price_fake_…"}
  stripe_price_ids   Json     @default("{}")
  /// {"test": "prod_…", "live": "prod_…"}
  stripe_product_ids Json     @default("{}")
  note               String?  @db.VarChar(300)
  /// Owner 2026-10-07: the strikethrough "old price" ($149 → $99). Shown
  /// only while show_discount is on and it is above amount_cents.
  compare_at_cents   Int?
  show_discount      Boolean  @default(false)
  created_by         String?  @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz

  @@index([kind, active, created_at(sort: Desc)], map: "plan_prices_kind_idx")
  @@map("plan_prices")
}

/// Owner 2026-10-05: staff on payroll ("Зарплаты"): an admin of the panel
/// or anyone else, with a fixed monthly amount. Super admin, the deputy
/// and admins with the payroll area manage it; every change is audited.
model PayrollEmployee {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The admin account this person uses, when they have one.
  admin_user_id          String?          @db.Uuid
  /// Owner 2026-10-05: any LawBid account paid through payroll (a partner
  /// blogger, …); commissions from other modules land on this person.
  user_id                String?          @unique @db.Uuid
  name                   String           @db.VarChar(120)
  role_title             String           @default("") @db.VarChar(120)
  amount_cents           Int
  currency               String           @default("usd") @db.VarChar(3)
  /// How the money goes: bank transfer details, Zelle, cash… (free text).
  method_note            String           @default("") @db.VarChar(300)
  /// For the Stripe Connect invite (optional).
  email                  String?          @db.VarChar(254)
  /// Stripe Connect Express account (payroll_stripe_payouts).
  stripe_account_id      String?          @db.VarChar(64)
  /// Stripe says the bank account / card is linked and payouts work.
  stripe_payouts_enabled Boolean          @default(false)
  active                 Boolean          @default(true)
  created_by             String?          @db.Uuid
  created_at             DateTime         @default(now()) @db.Timestamptz
  updated_at             DateTime         @default(now()) @db.Timestamptz
  payouts                PayrollPayout[]
  accruals               PayrollAccrual[]

  @@index([active, name])
  @@map("payroll_employees")
}

/// One payment to a person: fixed salary plus accrued commissions. Recorded
/// by hand (bank, Zelle, cash) or sent through Stripe Connect;
/// `batch_id` groups one "Выплатить" run.
model PayrollPayout {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id      String          @db.Uuid
  employee         PayrollEmployee @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  batch_id         String          @db.Uuid
  /// "2026-10" (month) or any label the owner gives the period.
  period           String          @db.VarChar(40)
  amount_cents     Int
  currency         String          @default("usd") @db.VarChar(3)
  /// manual · bank · zelle · cash · other · stripe
  method           String          @default("manual") @db.VarChar(20)
  /// paid · canceled · processing (Stripe transfer in flight) · failed
  status           String          @default("paid") @db.VarChar(16)
  /// Gross = base + commissions; net = gross - fee (what the person gets).
  base_cents       Int             @default(0)
  commission_cents Int             @default(0)
  /// Stripe's cost, taken from the person's payout (owner 2026-10-05).
  fee_cents        Int             @default(0)
  net_cents        Int             @default(0)
  /// Stripe transfer id (method = stripe).
  transfer_id      String?         @db.VarChar(64)
  /// Why the Stripe transfer failed.
  failure          String?         @db.VarChar(300)
  note             String?         @db.VarChar(300)
  cancel_reason    String?         @db.VarChar(500)
  created_by       String?         @db.Uuid
  created_at       DateTime        @default(now()) @db.Timestamptz
  canceled_at      DateTime?       @db.Timestamptz

  @@index([employee_id, created_at(sort: Desc)])
  @@index([period, created_at(sort: Desc)])
  @@index([batch_id])
  @@map("payroll_payouts")
}

/// Owner 2026-10-05: money owed to a person besides the fixed salary — a
/// commission from the partner program, a bonus, an adjustment. Paid with
/// the next «Выплатить»; `event_ref` makes each accrual idempotent.
model PayrollAccrual {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id  String          @db.Uuid
  employee     PayrollEmployee @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  /// partner · admin · …
  source       String          @db.VarChar(24)
  /// commission · bonus · adjustment
  kind         String          @default("commission") @db.VarChar(24)
  event_ref    String          @unique @db.VarChar(120)
  /// Negative for a reversal.
  amount_cents Int
  currency     String          @default("usd") @db.VarChar(3)
  period       String          @db.VarChar(40)
  note         String?         @db.VarChar(300)
  /// pending · paid · canceled
  status       String          @default("pending") @db.VarChar(16)
  payout_id    String?         @db.Uuid
  created_at   DateTime        @default(now()) @db.Timestamptz
  paid_at      DateTime?       @db.Timestamptz
  canceled_at  DateTime?       @db.Timestamptz

  @@index([employee_id, status])
  @@index([payout_id])
  @@map("payroll_accruals")
}

/// Owner 2026-10-05 «Прибыль и резерв»: what the services charge the
/// expense card a month (AWS, database, Twilio, Bunny, …). The monthly
/// split sends this much to the «Расходы» bank before any profit.
model TreasuryExpense {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @db.VarChar(80)
  monthly_cents Int
  /// manual · aws (taken from the AWS budget when it is higher)
  source        String   @default("manual") @db.VarChar(16)
  active        Boolean  @default(true)
  sort          Int      @default(0)
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @default(now()) @db.Timestamptz

  @@index([active, sort])
  @@map("treasury_expenses")
}

/// Owner 2026-10-05: one payout of the monthly split from the platform's
/// Stripe balance to a bank the owner added in Stripe.
model TreasuryPayout {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Idempotency: auto:<period>:<kind> once a month; manual ones are unique.
  key               String   @unique @db.VarChar(80)
  /// YYYY-MM of the run.
  period            String   @db.VarChar(7)
  /// expenses · profit
  kind              String   @db.VarChar(16)
  /// auto · manual
  trigger           String   @default("auto") @db.VarChar(8)
  amount_cents      Int
  currency          String   @default("usd") @db.VarChar(3)
  /// Stripe bank id (null = Stripe's default bank).
  destination_id    String?  @db.VarChar(64)
  destination_label String?  @db.VarChar(80)
  stripe_payout_id  String?  @db.VarChar(64)
  /// pending · in_transit · paid · failed · canceled
  status            String   @default("pending") @db.VarChar(16)
  failure           String?  @db.VarChar(300)
  /// The numbers the amount came from (reserve, expenses, balance).
  plan              Json?
  created_by        String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @default(now()) @db.Timestamptz

  @@index([period, kind])
  @@index([status])
  @@index([created_at(sort: Desc)])
  @@map("treasury_payouts")
}

// Owner 2026-10-05: client → attorney payments through the platform.
// The attorney's own Stripe Connect (Express) account: money settles on
// the attorney's balance (direct charges), the platform keeps only its
// fee (`application_fee_amount`) and never holds the client's funds.
model PayoutAccount {
  user_id              String    @id @db.Uuid
  provider             String    @default("stripe") @db.VarChar(16)
  stripe_account_id    String    @unique
  // pending | onboarding | active | restricted | disabled
  status               String    @default("pending") @db.VarChar(16)
  charges_enabled      Boolean   @default(false)
  payouts_enabled      Boolean   @default(false)
  details_submitted    Boolean   @default(false)
  requirements_due     String[]  @default([])
  disabled_reason      String?   @db.VarChar(200)
  country              String?   @db.VarChar(2)
  // Owner 2026-10-05: the attorney's own default for who covers Stripe's
  // card fee on their invoices (client | attorney | split); null = the
  // admin default for new attorneys applies.
  processing_fee_payer String?   @db.VarChar(16)
  last_synced_at       DateTime? @db.Timestamptz
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @updatedAt @db.Timestamptz

  @@index([status])
  @@map("payout_accounts")
}

// One payment of a client to the accepted attorney of a case (the bid
// amount, a deposit, the balance or any amount). Fee columns are a
// snapshot of the admin's commission settings at creation.
model CasePayment {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id                  String    @db.Uuid
  bid_id                   String?   @db.Uuid
  client_id                String    @db.Uuid
  attorney_id              String    @db.Uuid
  // bid | deposit | balance | custom | invoice
  kind                     String    @db.VarChar(16)
  // The attorney's payment request this pays (kind = invoice).
  request_id               String?   @db.Uuid
  // pending_payment | succeeded | failed | canceled | refunded |
  // partially_refunded | disputed
  status                   String    @db.VarChar(24)
  // What the attorney charges for the work.
  amount_cents             Int
  // The platform's fee (application fee) and the card-processing fee
  // passed to the client (an estimate of Stripe's charge).
  platform_fee_cents       Int       @default(0)
  processing_fee_cents     Int       @default(0)
  client_total_cents       Int
  attorney_net_cents       Int
  // fixed | none; client | attorney
  fee_type                 String    @db.VarChar(16)
  fee_payer                String    @db.VarChar(16)
  // Who covered Stripe's card fee: client | attorney | split.
  processing_fee_payer     String    @default("client") @db.VarChar(16)
  currency                 String    @default("usd") @db.VarChar(3)
  note                     String?   @db.VarChar(200)
  stripe_account_id        String?
  stripe_checkout_id       String?   @unique
  stripe_payment_intent_id String?   @unique
  stripe_charge_id         String?
  receipt_url              String?
  refunded_cents           Int       @default(0)
  // Stripe dispute status while / after a chargeback.
  dispute_status           String?   @db.VarChar(32)
  disputed_at              DateTime? @db.Timestamptz
  paid_at                  DateTime? @db.Timestamptz
  canceled_reason          String?   @db.VarChar(100)
  failure_code             String?   @db.VarChar(100)
  created_at               DateTime  @default(now()) @db.Timestamptz
  updated_at               DateTime  @updatedAt @db.Timestamptz

  @@index([case_id, created_at(sort: Desc)])
  @@index([client_id, created_at(sort: Desc)])
  @@index([attorney_id, created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
  @@index([request_id])
  @@map("case_payments")
}

// Owner 2026-10-05: a payment request (invoice) the attorney sends the
// client from the case: an amount, a description, an optional due date.
// Installments = several requests sharing a plan_id. The client pays it in
// two taps; reminders go out before and after the due date.
model PaymentRequest {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id              String    @db.Uuid
  attorney_id          String    @db.Uuid
  client_id            String    @db.Uuid
  // Who actually created it (the attorney or one of their assistants).
  created_by           String    @db.Uuid
  amount_cents         Int
  description          String    @db.VarChar(200)
  due_at               DateTime? @db.Timestamptz
  // Who covers Stripe's fee on this invoice: client | attorney | split.
  // Owner 2026-10-05 03:03: agreed like a bid — the attorney proposes, the
  // client accepts or counters, the attorney answers; paying is possible
  // once agreed (or by accepting the attorney's proposal with the payment).
  processing_fee_payer String    @default("client") @db.VarChar(16)
  // proposed | countered | agreed
  fee_payer_status     String    @default("proposed") @db.VarChar(16)
  // Who made the current proposal: attorney | client.
  fee_payer_by         String    @default("attorney") @db.VarChar(16)
  // Counter-offers so far (the admin caps them like bid rounds).
  fee_payer_rounds     Int       @default(0)
  fee_payer_agreed_at  DateTime? @db.Timestamptz
  // open | paid | canceled | expired
  status               String    @default("open") @db.VarChar(16)
  plan_id              String?   @db.Uuid
  seq                  Int       @default(1)
  total                Int       @default(1)
  payment_id           String?   @unique @db.Uuid
  paid_at              DateTime? @db.Timestamptz
  canceled_at          DateTime? @db.Timestamptz
  last_reminded_at     DateTime? @db.Timestamptz
  reminders_sent       Int       @default(0)
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @updatedAt @db.Timestamptz

  @@index([case_id, created_at(sort: Desc)])
  @@index([client_id, status, due_at])
  @@index([attorney_id, created_at(sort: Desc)])
  @@index([status, due_at])
  @@map("payment_requests")
}

// Owner 2026-10-05: the client as a Stripe customer on one attorney's
// connected account, so Checkout can offer their saved card next time.
model ConnectedCustomer {
  client_id          String   @db.Uuid
  stripe_account_id  String
  stripe_customer_id String
  created_at         DateTime @default(now()) @db.Timestamptz

  @@id([client_id, stripe_account_id])
  @@map("connected_customers")
}

// A refund of a case payment, started by the attorney (the app), an admin
// or Stripe (a lost dispute).
model CasePaymentRefund {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id        String   @db.Uuid
  amount_cents      Int
  reason            String   @db.VarChar(500)
  // attorney | admin | stripe
  initiated_by_type String   @db.VarChar(16)
  initiated_by      String?  @db.Uuid
  stripe_refund_id  String?  @unique
  // pending | succeeded | failed
  status            String   @db.VarChar(16)
  failure_reason    String?
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz

  @@index([payment_id])
  @@map("case_payment_refunds")
}

// Owner 2026-10-05: the document templates library (admin → Content →
// Document templates; app → "Templates"). A template is one clean
// `document_template` file the admin uploaded; `state` NULL = every
// state, `practice_area_id` NULL = any practice. `audience` lawyers =
// attorneys (and their assistants) only. Downloads are counted once per
// user a day.
enum DocumentTemplateAudience {
  everyone
  lawyers

  @@map("document_template_audience")
}

model DocumentTemplate {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  file_id          String                   @unique @db.Uuid
  file             File                     @relation(fields: [file_id], references: [id], onDelete: Restrict)
  file_name        String
  title            String
  description      String                   @default("")
  practice_area_id String?                  @db.Uuid
  practice_area    PracticeArea?            @relation(fields: [practice_area_id], references: [id], onDelete: SetNull)
  state            String?                  @db.Char(2)
  language         String                   @default("en")
  audience         DocumentTemplateAudience @default(everyone)
  is_published     Boolean                  @default(false)
  download_count   Int                      @default(0)
  created_by       String?                  @db.Uuid
  created_at       DateTime                 @default(now()) @db.Timestamptz
  updated_at       DateTime                 @updatedAt @db.Timestamptz
  deleted_at       DateTime?                @db.Timestamptz

  @@index([is_published, deleted_at, created_at])
  @@index([practice_area_id])
  @@map("document_templates")
}

/// Owner 2026-10-05 (plan builder): a subscription plan the admin
/// assembles in Деньги → Планы. `kind` = paid (sold through plan_prices /
/// Stripe) or baseline (what a user with no subscription gets; one per
/// audience, never sold). `entitlements` = {key: value} over the catalog in
/// apps/api/src/modules/plans/entitlement-catalog.ts; `highlights` = the
/// admin's own bullet lines [{en, ru}]. Subscribers keep the entitlements
/// frozen on their subscription row until the admin applies a change.
model Plan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(64)
  /// attorney · client
  audience     String   @db.VarChar(16)
  /// paid · baseline
  kind         String   @default("paid") @db.VarChar(16)
  /// {"en": "...", "ru": "..."}
  name         Json     @default("{}")
  tagline      Json     @default("{}")
  description  Json     @default("{}")
  /// month · year (null for a baseline)
  interval     String?  @db.VarChar(8)
  /// plan_prices.kind that carries this plan's price (null for a baseline).
  price_kind   String?  @db.VarChar(64)
  entitlements Json     @default("{}")
  highlights   Json     @default("[]")
  /// draft · active · archived
  status       String   @default("draft") @db.VarChar(16)
  sort         Int      @default(0)
  /// The plan legacy flows (no planCode given) buy for this audience+interval.
  is_default   Boolean  @default(false)
  created_by   String?  @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz

  subscriptions        Subscription[]
  client_subscriptions ClientSubscription[]

  @@index([audience, status, sort], map: "plans_audience_idx")
  @@map("plans")
}

/// Owner 2026-10-05 (plan builder): a client's paid plan (badge, cases
/// first in the attorneys' feed, …). One row per client, driven by Stripe
/// webhooks like the attorney's `subscriptions` row.
model ClientSubscription {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String    @unique @db.Uuid
  user                   User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan_id                String?   @db.Uuid
  plan                   Plan?     @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  stripe_checkout_id     String?   @db.VarChar(255)
  stripe_subscription_id String?   @unique @db.VarChar(255)
  /// incomplete · trialing · active · past_due · canceled · expired
  status                 String    @default("incomplete") @db.VarChar(16)
  price_cents            Int       @default(0)
  trial_ends_at          DateTime? @db.Timestamptz
  current_period_end     DateTime? @db.Timestamptz
  cancel_at_period_end   Boolean   @default(false)
  canceled_at            DateTime? @db.Timestamptz
  entitlements           Json?
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz

  @@index([status, current_period_end], map: "client_subscriptions_status_idx")
  @@map("client_subscriptions")
}

// Owner 2026-10-05 («Продвижение»): registry of demo accounts. The demo
// user itself (and everything it does) lives in the DEMO database
// (src/common/demo); this row in the real database says who created it,
// when it was last used and the one-time code a blogger without an app
// account enters to get in. Deleting the row deletes the demo user.
model DemoAccount {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // users.id inside the demo database.
  demo_user_id        String    @unique @db.Uuid
  // client | attorney | assistant
  role                String    @db.VarChar(16)
  display_name        String    @db.VarChar(120)
  // Admin's note: "блогер Иван, Instagram".
  label               String?   @db.VarChar(200)
  // The partner (real user) who created it from the app; null when the
  // admin created it for a blogger without an account.
  created_by_user_id  String?   @db.Uuid
  created_by_admin_id String?   @db.Uuid
  invite_code_hash    String?   @unique @db.VarChar(64)
  invite_expires_at   DateTime? @db.Timestamptz
  last_seen_at        DateTime? @db.Timestamptz
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @updatedAt @db.Timestamptz

  @@index([created_by_user_id, created_at])
  @@index([last_seen_at])
  @@map("demo_accounts")
}

/// Owner 2026-10-05 (storage like Telegram): one row a day — how much the
/// files take by type, how much deduplication saved, the biggest tables.
/// The admin «Хранилище» page draws growth from these; the growth alert
/// compares the newest two.
model StorageSnapshot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  day          DateTime @unique @db.Date
  /// Sum of live files as users see them (each copy counted).
  files_bytes  BigInt
  /// What S3 really keeps (shared objects counted once).
  stored_bytes BigInt
  files_count  Int
  /// { purpose: { bytes, count } }
  by_purpose   Json
  /// [{ table, rows, bytes }] — estimates from PostgreSQL statistics.
  db_tables    Json
  db_bytes     BigInt   @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz

  @@map("storage_snapshots")
}

/// Owner 2026-10-05 (docs/CLIENT_FRAUD.md): hashed identity signals of an
/// account — phone, e-mail, Apple / Google subject, on-device key, card,
/// IP, case text. HMAC-SHA256 only, never the value. A sign-in sharing a
/// strong one with a blocked account is refused or held for review.
model IdentityFingerprint {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  /// phone | email | apple | google | device | card | ip | text
  kind          String    @db.VarChar(16)
  hash          String    @db.VarChar(64)
  first_seen_at DateTime  @default(now()) @db.Timestamptz
  last_seen_at  DateTime  @default(now()) @db.Timestamptz
  /// Set when the owner's account was blocked and then deleted: the hash
  /// keeps blocking after the account row is anonymised.
  banned_at     DateTime? @db.Timestamptz

  @@unique([user_id, kind, hash])
  @@index([kind, hash])
  @@index([last_seen_at])
  @@map("identity_fingerprints")
}

/// Owner 2026-10-05: one client's risk score and fraud status
/// (ok | review | restricted | banned), recomputed on every signal.
model ClientFraudProfile {
  user_id        String    @id @db.Uuid
  score          Int       @default(0)
  status         String    @default("ok") @db.VarChar(16)
  /// [{ code, points, count }] — what the score is made of.
  signals        Json      @default("[]")
  /// The blocked account a sign-in matched, if any.
  linked_user_id String?   @db.Uuid
  /// What put the account in the queue: 'score' | 'linked' | 'staff'.
  queue_reason   String?   @db.VarChar(16)
  queued_at      DateTime? @db.Timestamptz
  /// A staff «Снять» freezes the score: automatic actions return only when
  /// the score grows past it.
  cleared_score  Int?
  cleared_by     String?   @db.Uuid
  cleared_at     DateTime? @db.Timestamptz
  computed_at    DateTime  @default(now()) @db.Timestamptz
  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @updatedAt @db.Timestamptz

  @@index([status, score(sort: Desc)])
  @@map("client_fraud_profiles")
}

/// Append-only history of automatic and staff decisions.
model ClientFraudEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid
  kind       String   @db.VarChar(32)
  /// system | admin
  actor_type String   @default("system") @db.VarChar(16)
  actor_id   String?  @db.Uuid
  note       String?  @db.VarChar(500)
  details    Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([user_id, created_at(sort: Desc)])
  @@index([kind, created_at(sort: Desc)])
  @@index([actor_id, created_at(sort: Desc)])
  @@map("client_fraud_events")
}

/// Owner 2026-10-06: «Главный партнёр страны». A business partner abroad
/// promotes LawBid in one country at their own cost and gets a share of
/// that country's net revenue. All money still goes to the owner's Stripe;
/// the share is settled monthly and paid through payroll. Their admin team
/// (the lead + up to `max_admins` staff) carries `country_partner` in
/// admin_profiles.permissions and only sees this country. Only the super
/// admin creates, changes the share, enables payouts or disables.
model CountryPartner {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country_code         String    @db.Char(2)
  /// Company or person (contract party).
  name                 String    @db.VarChar(120)
  contact              String?   @db.VarChar(200)
  /// The partner's own admin account (users.id with an admin profile).
  lead_admin_id        String    @unique @db.Uuid
  /// Share of the country's net revenue, basis points (2000 = 20 %).
  share_bps            Int
  /// active · paused · disabled
  status               String    @default("active") @db.VarChar(16)
  /// Staff the lead may hire (the lead not counted).
  max_admins           Int       @default(10)
  /// Owner switches payouts on per partner; until then settlements wait.
  payouts_enabled      Boolean   @default(false)
  /// Payroll entry the monthly share is accrued to.
  payroll_employee_id  String?   @db.Uuid
  contract_starts_at   DateTime? @db.Timestamptz
  contract_ends_at     DateTime? @db.Timestamptz
  /// Contract version the lead accepted (country_partners.contract in
  /// app_config); null = not accepted yet, the portal asks first.
  contract_version     Int?
  contract_accepted_at DateTime? @db.Timestamptz
  contract_accepted_ip String?   @db.VarChar(64)
  /// [{metric: attorneys|clients|revenue_cents, target, deadline, alerted}]
  goals                Json      @default("[]")
  /// Team accounts suspended by «Отключить» / «Пауза» (restored together).
  suspended_admin_ids  String[]  @default([])
  note                 String?   @db.VarChar(1000)
  created_by           String?   @db.Uuid
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @updatedAt @db.Timestamptz
  disabled_at          DateTime? @db.Timestamptz
  /// Set when the daily sweep switched the partner off because the
  /// contract ended («Договор до»); what was earned before is still paid.
  contract_expired_at  DateTime? @db.Timestamptz

  settlements CountryPartnerSettlement[]

  @@index([country_code, status])
  @@map("country_partners")
}

/// One month of one partner in one currency: the country's paid revenue,
/// refunds, estimated Stripe fees and the partner's share. Paid through
/// payroll (accrual `country_partner:<id>`); its state is read from there.
model CountryPartnerSettlement {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partner_id    String         @db.Uuid
  partner       CountryPartner @relation(fields: [partner_id], references: [id], onDelete: Restrict)
  /// "2026-10"
  period        String         @db.VarChar(7)
  currency      String         @default("usd") @db.VarChar(3)
  gross_cents   Int
  refunds_cents Int            @default(0)
  fees_cents    Int            @default(0)
  net_cents     Int
  share_bps     Int
  amount_cents  Int
  /// held (payouts off / paused) · zero · accrued (sent to payroll)
  status        String         @default("held") @db.VarChar(16)
  /// payroll_accruals.event_ref of the latest send to payroll.
  accrual_ref   String?        @db.VarChar(120)
  created_at    DateTime       @default(now()) @db.Timestamptz
  updated_at    DateTime       @updatedAt @db.Timestamptz

  @@unique([partner_id, period, currency])
  @@index([status, period])
  @@map("country_partner_settlements")
}

/// Owner 2026-10-13 (contacts sync, like Instagram): "this person's phone
/// number is in my address book". Written from SHA-256 hashes the app
/// uploads; only matches with registered users are kept. The hashes of
/// numbers nobody registered and the raw numbers are never stored.
/// Deleted with the owner's DELETE /contacts/sync and on anonymization.
model ContactMatch {
  owner_id   String   @db.Uuid
  owner      User     @relation("ContactOwner", fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contact_matches_owner_fkey")
  matched_id String   @db.Uuid
  matched    User     @relation("ContactMatched", fields: [matched_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contact_matches_matched_fkey")
  created_at DateTime @default(now()) @db.Timestamptz

  @@id([owner_id, matched_id])
  @@index([matched_id])
  @@map("contact_matches")
}

/// Owner 2026-10-13: whether a user syncs contacts, and when last.
model ContactSyncSetting {
  user_id   String    @id @db.Uuid
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contact_sync_settings_user_fkey")
  enabled   Boolean   @default(true)
  synced_at DateTime? @db.Timestamptz

  @@map("contact_sync_settings")
}

/// Owner 2026-10-14: how often an attorney's profile was opened, per day
/// (the attorney's own statistics; one row per attorney and day).
model AttorneyProfileView {
  attorney_id String   @db.Uuid
  day         DateTime @db.Date
  views       Int      @default(0)

  @@id([attorney_id, day])
  @@map("attorney_profile_views")
}

/// Owner 2026-10-14: offers bought on top of the plan's monthly limit.
/// One row per purchase (a hosted one-time checkout); the unspent offers of
/// all paid purchases live in `bid_credits`.
model BidPackPurchase {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String    @db.Uuid
  pack_id            String    @db.VarChar(40)
  bids               Int
  price_cents        Int
  status             String    @default("pending_payment") @db.VarChar(20)
  stripe_checkout_id String?   @unique
  payment_id         String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz
  paid_at            DateTime? @db.Timestamptz

  @@index([user_id, created_at(sort: Desc)])
  @@map("bid_pack_purchases")
}

model BidCredit {
  user_id    String   @id @db.Uuid
  balance    Int      @default(0)
  updated_at DateTime @default(now()) @db.Timestamptz

  @@map("bid_credits")
}

/// Owner 2026-10-14: a firm account. The firm has no bar number of its own:
/// its states are the union of its member lawyers' verified licenses, and a
/// bid goes out from the member who holds a matching license.
model Firm {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String       @db.VarChar(120)
  owner_id   String       @db.Uuid
  created_at DateTime     @default(now()) @db.Timestamptz
  members    FirmMember[]

  @@index([owner_id])
  @@map("firms")
}

/// status: invited (waiting for the lawyer) | active. A lawyer is in at most
/// one firm (unique attorney_id).
model FirmMember {
  firm_id     String   @db.Uuid
  firm        Firm     @relation(fields: [firm_id], references: [id], onDelete: Cascade)
  attorney_id String   @unique @db.Uuid
  role        String   @default("member") @db.VarChar(10)
  status      String   @default("invited") @db.VarChar(10)
  created_at  DateTime @default(now()) @db.Timestamptz

  @@id([firm_id, attorney_id])
  @@map("firm_members")
}

// -----------------------------------------------------------------------
// Owner 2026-10-15: search that understands everyday words. A group is one
// meaning (optionally tied to a practice area) with its words and phrases
// per language; a query naming any of them finds rows of that practice.
// -----------------------------------------------------------------------
model SearchSynonymGroup {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String        @unique @db.VarChar(120)
  practice_area_id String?       @db.Uuid
  practice_area    PracticeArea? @relation(fields: [practice_area_id], references: [id], onDelete: SetNull)
  enabled          Boolean       @default(true)
  source           String        @default("admin") @db.VarChar(12)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @updatedAt @db.Timestamptz(6)

  terms SearchSynonymTerm[]

  @@index([practice_area_id])
  @@map("search_synonym_groups")
}

model SearchSynonymTerm {
  id       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id String             @db.Uuid
  group    SearchSynonymGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  lang     String             @db.VarChar(12)
  term     String             @db.VarChar(120)

  @@unique([group_id, lang, term])
  @@index([term])
  @@map("search_synonym_terms")
}

/// What people typed and how many rows it found (first page), for the
/// admin's "no results" list. Old rows are purged by the nightly job.
model SearchQueryLog {
  id         BigInt   @id @default(autoincrement())
  user_id    String?  @db.Uuid
  q          String   @db.VarChar(100)
  scope      String   @db.VarChar(12)
  lang       String?  @db.VarChar(12)
  results    Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([q])
  @@index([user_id, created_at])
  @@map("search_query_log")
}

/// A result the person opened after a query: the nightly job learns
/// "query → topic" from these.
model SearchClick {
  id               BigInt   @id @default(autoincrement())
  user_id          String   @db.Uuid
  q                String   @db.VarChar(100)
  target_type      String   @db.VarChar(12)
  target_id        String   @db.VarChar(64)
  practice_area_id String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at])
  @@index([q])
  @@map("search_clicks")
}

/// "query → topic" links learned from clicks (rebuilt nightly).
model SearchLearnedLink {
  q                String   @db.VarChar(100)
  practice_area_id String   @db.Uuid
  score            Int
  updated_at       DateTime @default(now()) @db.Timestamptz(6)

  @@id([q, practice_area_id])
  @@map("search_learned_links")
}

/// Owner 2026-10-15: events from the app counted by day (see the migration).
model AppEventDay {
  day    DateTime @db.Date
  name   String   @db.VarChar(40)
  screen String   @default("") @db.VarChar(80)
  count  Int      @default(0)

  @@id([day, name, screen])
  @@map("app_event_days")
}

// -----------------------------------------------------------------------
// Owner 2026-10-15: the app's own crash reports (no paid service): the
// phone sends errors in batches, the admin sees them grouped.
// -----------------------------------------------------------------------
model CrashReport {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fingerprint  String   @db.VarChar(40)
  message      String   @db.VarChar(500)
  stack        String   @db.VarChar(6000)
  fatal        Boolean  @default(false)
  platform     String   @db.VarChar(12)
  app_version  String   @db.VarChar(30)
  build        String   @db.VarChar(20)
  flavor       String   @db.VarChar(12)
  os_version   String   @db.VarChar(40)
  device_model String   @db.VarChar(60)
  device_key   String?  @db.VarChar(80)
  route        String?  @db.VarChar(120)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([fingerprint, created_at(sort: Desc)])
  @@index([created_at])
  @@map("crash_reports")
}

// Owner 2026-10-15: one row per person per day they opened the app (DAU/MAU,
// retention, churn). Written once a day per person from GET /users/me.
model UserActivityDay {
  user_id String   @db.Uuid
  day     DateTime @db.Date

  @@id([user_id, day])
  @@index([day])
  @@map("user_activity_days")
}
