/// Owner 2026-10-05 (legal): a DMCA takedown notice (17 U.S.C. §512(c)(3))
/// with the statutory elements — identification of the work, the location
/// (our target or a URL), contact details, the good-faith statement, the
/// accuracy statement under penalty of perjury and a signature — and the
/// counter-notice (§512(g)) the content's author may file after a removal.
/// new → removed | rejected; removed → counter_received → restored.
model DmcaNotice {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id            String?           @db.Uuid
  report               Report?           @relation(fields: [report_id], references: [id], onDelete: SetNull)
  target_type          ReportTargetType?
  target_id            String?           @db.Uuid
  infringing_url       String?           @db.VarChar(1000)
  complainant_name     String            @db.VarChar(200)
  complainant_email    String            @db.VarChar(254)
  complainant_address  String            @db.VarChar(500)
  complainant_phone    String?           @db.VarChar(40)
  work_description     String            @db.VarChar(4000)
  good_faith           Boolean
  accuracy_sworn       Boolean
  signature            String            @db.VarChar(200)
  // new | removed | rejected | counter_received | restored
  status               String            @default("new") @db.VarChar(24)
  submitted_by_user_id String?           @db.Uuid
  submitted_by         User?             @relation("DmcaSubmitter", fields: [submitted_by_user_id], references: [id], onDelete: SetNull)
  // The content's author at decision time (who gets the strike and may
  // file the counter-notice).
  author_user_id       String?           @db.Uuid
  // {name, address, phone, email, consentJurisdiction, sworn, signature, submittedAt}
  counter              Json?
  decided_by           String?           @db.Uuid
  decided_at           DateTime?         @db.Timestamptz
  decision_note        String?           @db.VarChar(1000)
  created_at           DateTime          @default(now()) @db.Timestamptz
  updated_at           DateTime          @updatedAt @db.Timestamptz

  @@index([status, created_at])
  @@index([submitted_by_user_id])
  @@index([target_type, target_id])
  @@map("dmca_notices")
}

model ModerationAction {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id   String?              @db.Uuid
  report      Report?              @relation(fields: [report_id], references: [id], onDelete: Restrict)
  admin_id    String               @db.Uuid
