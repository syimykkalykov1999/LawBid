  owner_user_id     String           @db.Uuid
  owner             User             @relation("VideoAssetOwner", fields: [owner_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "video_assets_owner_fkey")
  provider          String           @default("bunny")
