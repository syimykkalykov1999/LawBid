// -----------------------------------------------------------------------
// Reference data (docs/02_DATABASE.md §3.1/§3.2) — stage 2.1.
// -----------------------------------------------------------------------

/// Owner 2026-10-05: countries LawBid can work in (ISO 3166-1 alpha-2),
/// switched on one by one in the admin (Система → Страны) like the app
/// languages. A switched-off country takes no new sign-ups, profiles or
/// cases; people already there keep their accounts.
model Country {
  code             String    @id @db.Char(2)
  name             String
  is_enabled       Boolean   @default(false)
  /// E.164 country calling code without "+", e.g. "1", "52".
  calling_code     String
  /// ISO 4217, upper case (USD, CAD, MXN).
  currency         String    @db.Char(3)
  /// Default app language for new people there (i18n code).
  language         String    @default("en")
  /// What a first-level region is called: state | province | region.
  region_kind      String    @default("region")
  timezone         String?
  /// Stripe Connect pays attorneys out in this country.
  stripe_supported Boolean   @default(false)
  sort             Int
  enabled_at       DateTime? @db.Timestamptz
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz

  states   State[]
  users    User[]
  waitlist CountryWaitlist[]

  @@index([is_enabled, sort])
  @@map("countries")
}

/// Owner 2026-10-05: people who tried LawBid in a country that is not
/// switched on yet; they get an e-mail automatically when it is.
model CountryWaitlist {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country_code String    @db.Char(2)
  country      Country   @relation(fields: [country_code], references: [code], onDelete: Cascade)
  email        String
  locale       String    @default("en")
  created_at   DateTime  @default(now()) @db.Timestamptz
  notified_at  DateTime? @db.Timestamptz

  @@unique([country_code, email])
  @@index([country_code, notified_at])
  @@map("country_waitlist")
}

// docs/02_DATABASE.md §3.1: states(code PK char(2), name, is_active
// default true). 50 states + DC; UI names come from i18n `state.<code>`.
model State {
  code         String  @id @db.Char(2)
  name         String
  is_active    Boolean @default(true)
  /// Owner 2026-10-05: states, provinces and other first-level regions of
  /// every country live here; a region is usable only while its country
  /// is switched on. iso_code is the ISO 3166-2 code (US-NY, CA-ON, MX-JAL).
  country_code String  @default("US") @db.Char(2)
  country      Country @relation(fields: [country_code], references: [code], onDelete: Restrict)
  iso_code     String?

  // Reference/seed table — no timestamps, per §3.1's column list.
  client_profiles        ClientProfile[]
  attorney_licenses      AttorneyLicense[]
  verification_documents VerificationDocument[]

  primary_for_cases CaseState[]
  cases_primary     Case[]            @relation("CasePrimaryState")
  bar_registry      StateBarRegistry?

  @@index([country_code])
  @@map("states")
}

// docs/02_DATABASE.md §3.2: two-level tree category -> specialization.
// parent_id is null for a category. code is UQ and follows the §3.2
// generation rule (see prisma/seed/practice-areas.util.ts). Cases and
// attorney selections always reference leaves (enforced in services).
// Owner 2026-10-15: a case may name up to `case.max_practices` topics. The
// first stays in `cases.practice_area_id` (every existing case is already
// «an array of one»); the others are rows here. Attorneys of any of the
// topics see the case.
model CaseExtraPractice {
  case_id          String       @db.Uuid
  case             Case         @relation(fields: [case_id], references: [id], onDelete: Cascade)
  practice_area_id String       @db.Uuid
  practice_area    PracticeArea @relation(fields: [practice_area_id], references: [id], onDelete: Restrict)

  @@id([case_id, practice_area_id])
  @@index([practice_area_id, case_id])
  @@map("case_extra_practices")
}

model PracticeArea {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id String? @db.Uuid
  code      String  @unique
  name_en   String
  i18n_key  String
  sort      Int
  is_active Boolean @default(true)

  parent   PracticeArea?  @relation("PracticeAreaTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children PracticeArea[] @relation("PracticeAreaTree")

  // Reference/seed table — no timestamps, per §3.2's column list.
  attorney_practice_areas  AttorneyPracticeArea[]
  new_case_alert_practices NewCaseAlertPractice[]

  cases                 Case[]
  posts                 Post[]
  document_templates    DocumentTemplate[]
  case_extra_practices  CaseExtraPractice[]
  search_synonym_groups SearchSynonymGroup[]

  @@index([parent_id])
  @@map("practice_areas")
}

// -----------------------------------------------------------------------
// 4.C — Profiles and verification (docs/02_DATABASE.md §4.C) — stage 2.3.
// -----------------------------------------------------------------------

model ClientProfile {
  user_id                  String         @id @db.Uuid
  user                     User           @relation(fields: [user_id], references: [id], onDelete: Restrict)
  state_code               String         @db.Char(2)
  state                    State          @relation(fields: [state_code], references: [code], onDelete: Restrict)
  preferred_languages      String[]
  preferred_contact_method ContactMethod?
  // ≤200 chars (§4.C), CHECK in the migration.
  preferred_contact_note   String?
  // Owner decision 2026-09-29 (OQ-026): clients have @usernames too (same
  // rules as attorneys, one namespace with attorney_profiles — enforced in
  // UsernameRegistry). Nullable: legacy rows get one lazily on first read.
  username                 String?
  username_lower           String?        @unique
  username_changed_at      DateTime?      @db.Timestamptz
  // Owner 2026-09-30 (OQ-038): Instagram-like client profile counters and
  // the attorneys' rating of the client (visible to attorneys and self).
  posts_count              Int            @default(0)
  followers_count          Int            @default(0)
  following_count          Int            @default(0)
  rating_avg               Decimal        @default(0) @db.Decimal(3, 2)
  rating_count             Int            @default(0)
  created_at               DateTime       @default(now()) @db.Timestamptz
  updated_at               DateTime       @updatedAt @db.Timestamptz

  // GIN/inverted (trigram gin_trgm_ops or full-text), created by the stage 2.6
  // migration; declared so Prisma's diff matches the DB.
  @@index([preferred_languages], map: "client_profiles_languages_idx", type: Gin)
  @@map("client_profiles")
}

model AttorneyProfile {
  user_id             String             @id @db.Uuid
  user                User               @relation(fields: [user_id], references: [id], onDelete: Restrict)
  username            String
  username_lower      String             @unique
  // ≤300 chars (§4.C / §6.1), CHECK in the migration.
  bio                 String?
  firm_name           String?
  // Owner 2026-09-30 (OQ-030): several firms; firm_name mirrors the first.
  firm_names          String[]           @default([])
  languages           String[]
  verification_status VerificationStatus @default(unverified)
  verified_at         DateTime?          @db.Timestamptz
  // Owner 2026-09-30 (OQ-029): the name the attorney was verified under;
  // a big later change hides the blue check automatically (no admin).
  verified_first_name String?
  verified_last_name  String?
  name_mismatch       Boolean            @default(false)
  // docs/03_VERIFICATION_PROFILES.md §10 (stage 3.1)
  username_changed_at DateTime?          @db.Timestamptz
  rating_avg          Decimal            @default(0) @db.Decimal(3, 2)
  rating_count        Int                @default(0)
  posts_count         Int                @default(0)
  followers_count     Int                @default(0)
  following_count     Int                @default(0)
  created_at          DateTime           @default(now()) @db.Timestamptz
  updated_at          DateTime           @updatedAt @db.Timestamptz

  licenses                    AttorneyLicense[]
  practice_areas              AttorneyPracticeArea[]
  /// Owner 2026-10-01: true = new-case alerts follow new_case_alert_practices.
  new_case_alerts_custom      Boolean                @default(false)
  /// Owner 2026-10-05: new-case alerts only for urgent cases.
  new_case_alerts_urgent_only Boolean                @default(false)
  new_case_alert_practices    NewCaseAlertPractice[]
  verification_requests       VerificationRequest[]
  // Owner 2026-10-05: a personal assistant limit set by an admin on
  // the attorney's request; null = the global billing.max_assistant_seats.
  assistant_seat_limit        Int?                   @db.SmallInt
  // Owner 2026-10-05 (attorney trust levels): 0 self-attested, 1 license
  // confirmed (registry / staff), 2 identity confirmed (Stripe KYC with a
  // matching name, or staff-checked documents), 3 both. Recomputed by
  // AttorneyTrustService from events; `trust_badge` is the blue check
  // (level >= trust.min_level_badge, verified, no name mismatch).
  trust_level                 Int                    @default(0) @db.SmallInt
  trust_badge                 Boolean                @default(false)
  trust                       AttorneyTrust?
  trust_events                AttorneyTrustEvent[]

  // GIN/inverted (trigram gin_trgm_ops or full-text), created by the stage 2.6
  // migration; declared so Prisma's diff matches the DB.
  @@index([languages], map: "attorney_profiles_languages_idx", type: Gin)
  @@map("attorney_profiles")
}

model AttorneyLicense {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attorney_id         String          @db.Uuid
  attorney            AttorneyProfile @relation(fields: [attorney_id], references: [user_id], onDelete: Restrict)
  state_code          String          @db.Char(2)
  state               State           @relation(fields: [state_code], references: [code], onDelete: Restrict)
  bar_number          String
  license_status      LicenseStatus   @default(pending)
  expires_at          DateTime?       @db.Date
  verified_at         DateTime?       @db.Timestamptz
  verified_by         String?         @db.Uuid
  verifier            User?           @relation("LicenseVerifier", fields: [verified_by], references: [id], onDelete: Restrict)
  auto_check_result   Json?
  // docs/03_VERIFICATION_PROFILES.md §10 (stage 3.1)
  rejection_code      String?
  rejection_note      String?
  /// Owner 2026-10-05: the state registry disagreed with a self-attested
  /// license (name_mismatch / not_found / not_active). The license stays
  /// verified; the flag puts it on the admin's "registry" list.
  registry_flag       String?
  registry_flagged_at DateTime?       @db.Timestamptz
  created_at          DateTime        @default(now()) @db.Timestamptz
  updated_at          DateTime        @updatedAt @db.Timestamptz

  // One license can't be attached to two accounts (§4.C, §5.1).
  @@unique([state_code, bar_number])
  @@index([attorney_id])
  @@index([registry_flag])
  @@index([state_code, license_status])
  // Nightly license-expiry job (docs/03 §9, stage 4.1 migration).
  @@index([license_status, expires_at])
  @@map("attorney_licenses")
}

model AttorneyPracticeArea {
  attorney_id      String          @db.Uuid
  attorney         AttorneyProfile @relation(fields: [attorney_id], references: [user_id], onDelete: Cascade)
  practice_area_id String          @db.Uuid
  practice_area    PracticeArea    @relation(fields: [practice_area_id], references: [id], onDelete: Restrict)
  created_at       DateTime        @default(now()) @db.Timestamptz

  @@id([attorney_id, practice_area_id])
  @@index([practice_area_id, attorney_id])
  @@map("attorney_practice_areas")
}

/// Owner 2026-10-01: the qualifications that send "new case" alerts when
/// the attorney chose their own list (attorney_profiles.new_case_alerts_custom).
/// A category covers its subcategories.
model NewCaseAlertPractice {
  attorney_id      String          @db.Uuid
  attorney         AttorneyProfile @relation(fields: [attorney_id], references: [user_id], onDelete: Cascade, map: "new_case_alert_practices_attorney_fkey", onUpdate: NoAction)
  practice_area_id String          @db.Uuid
  practice_area    PracticeArea    @relation(fields: [practice_area_id], references: [id], onDelete: Cascade, map: "new_case_alert_practices_area_fkey", onUpdate: NoAction)
  created_at       DateTime        @default(now()) @db.Timestamptz

  @@id([attorney_id, practice_area_id])
  @@index([practice_area_id, attorney_id], map: "new_case_alert_practices_area_idx")
  @@map("new_case_alert_practices")
}

model VerificationRequest {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attorney_id          String                    @db.Uuid
  attorney             AttorneyProfile           @relation(fields: [attorney_id], references: [user_id], onDelete: Restrict)
  status               VerificationRequestStatus
  provider             VerificationProvider      @default(manual)
  provider_ref         String?
  submitted_at         DateTime?                 @db.Timestamptz
  reviewed_by          String?                   @db.Uuid
  reviewer             User?                     @relation("VerificationReviewer", fields: [reviewed_by], references: [id], onDelete: Restrict)
  reviewed_at          DateTime?                 @db.Timestamptz
  rejection_reason     String?
  admin_note           String?
  // docs/03_VERIFICATION_PROFILES.md §10 (stage 3.1)
  info_request_message String?
  // ≤500 chars, CHECK in the migration
  applicant_comment    String?
  rejection_code       String?
  // Owner 2026-10-04: sworn self-attestation of the license.
  attested_at          DateTime?                 @db.Timestamptz
  attestation_ip       String?
  attestation_version  String?
  created_at           DateTime                  @default(now()) @db.Timestamptz
  updated_at           DateTime                  @updatedAt @db.Timestamptz

  documents VerificationDocument[]
  checks    VerificationCheck[]

  @@index([attorney_id])
  @@index([status, submitted_at])
  @@map("verification_requests")
}

model VerificationDocument {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id String              @db.Uuid
  request    VerificationRequest @relation(fields: [request_id], references: [id], onDelete: Restrict)
  doc_type   VerificationDocType
  file_id    String              @db.Uuid
  file       File                @relation(fields: [file_id], references: [id], onDelete: Restrict)
  state_code String?             @db.Char(2)
  state      State?              @relation(fields: [state_code], references: [code], onDelete: Restrict)
  notes      String?
  // docs/03_VERIFICATION_PROFILES.md §10 (stage 3.1)
  // front | back, for identity documents
  side       String?
  created_at DateTime            @default(now()) @db.Timestamptz
  updated_at DateTime            @updatedAt @db.Timestamptz

  @@index([request_id])
  @@map("verification_documents")
}

model VerificationCheck {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id String                @db.Uuid
  request    VerificationRequest   @relation(fields: [request_id], references: [id], onDelete: Restrict)
  check_type VerificationCheckType
  provider   VerificationProvider
  result     CheckResult
  details    Json
  checked_at DateTime              @db.Timestamptz
  created_at DateTime              @default(now()) @db.Timestamptz

  @@index([request_id])
  @@map("verification_checks")
}

// -----------------------------------------------------------------------
// 4.D — Cases, bids, negotiation, journal (docs/02_DATABASE.md §4.D) and
// 4.E — Reviews — stage 2.4. CHECKs from §6.1 are raw SQL in the
// migration. Legally significant tables use ON DELETE RESTRICT (§1.4).
// -----------------------------------------------------------------------

model Case {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id             String                   @db.Uuid
  client                User                     @relation("CaseClient", fields: [client_id], references: [id], onDelete: Restrict)
  // ≤120 / ≤5000 chars (§6.1), CHECK in the migration.
  title                 String
  description           String
  // Leaf specialization only (enforced in the case service, file 04).
  practice_area_id      String                   @db.Uuid
  practice_area         PracticeArea             @relation(fields: [practice_area_id], references: [id], onDelete: Restrict)
  // Owner 2026-10-15: for "not sure / other": the topic the text names.
  inferred_practice_id  String?                  @db.Uuid
  topic_scanned_at      DateTime?                @db.Timestamptz(6)
  // Denormalized primary state for indexes; must match the is_primary
  // case_states row (service invariant, §4.D).
  primary_state_code    String                   @db.Char(2)
  primary_state         State                    @relation("CasePrimaryState", fields: [primary_state_code], references: [code], onDelete: Restrict)
  city                  String?
  budget_mode           BudgetMode
  budget_cents          Int?
  // Owner 2026-10-04: the client's card cover (`art:0..3` / `icon:<name>`,
  // never a personal photo; null = picked from the id) and urgency
  // (flexible | within_month | soon | urgent | very_urgent | by_date —
  // owner 2026-10-05). `by_date` keeps the date in deadline_at (a
  // calendar date: court hearing, filing deadline…) and what it is in
  // deadline_kind. CHECKs in the migrations.
  cover_key             String?
  urgency               String?
  deadline_at           DateTime?                @db.Date
  deadline_kind         String?
  status                CaseStatus               @default(open)
  accepted_bid_id       String?                  @unique @db.Uuid
  accepted_bid          Bid?                     @relation("CaseAcceptedBid", fields: [accepted_bid_id], references: [id], onDelete: Restrict)
  view_count            Int                      @default(0)
  bids_count            Int                      @default(0)
  // Owner 2026-09-30 (OQ-034): published comments under the case.
  comment_count         Int                      @default(0)
  // OQ-037: times shared.
  share_count           Int                      @default(0)
  shares                CaseShare[]
  comments              CaseComment[]
  last_activity_at      DateTime                 @default(now()) @db.Timestamptz
  stale_prompt_sent_at  DateTime?                @db.Timestamptz
  archived_at           DateTime?                @db.Timestamptz
  client_completed_at   DateTime?                @db.Timestamptz
  attorney_confirmed_at DateTime?                @db.Timestamptz
  auto_close_at         DateTime?                @db.Timestamptz
  closed_at             DateTime?                @db.Timestamptz
  deleted_at            DateTime?                @db.Timestamptz
  // STORED computed column (§5.3): to_tsvector('english', title || ' ' ||
  // description). Read-only.
  search_tsv            Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, f_unaccent(title)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, f_unaccent(description)), 'C'::\"char\"))"))
  // Same text with the 'simple' config: exact words in any language.
  search_tsv_simple     Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, f_unaccent(title)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, f_unaccent(description)), 'C'::\"char\"))"))
  created_at            DateTime                 @default(now()) @db.Timestamptz
  updated_at            DateTime                 @updatedAt @db.Timestamptz

  states              CaseState[]
  // Owner 2026-10-15: topics 2..N of a case (the first is `practice_area_id`).
  extra_practices     CaseExtraPractice[]
  // Owner 2026-09-30 (OQ-031): 0–9 photos; owner + accepted attorney only.
  photos              CasePhoto[]
  attorney_tasks      AttorneyTask[]
  case_tasks          CaseTask[]
  case_updates        CaseUpdate[]
  bid_drafts          BidDraft[]
  invites             CaseInvite[]
  bids                Bid[]                @relation("CaseBids")
  journal             CaseJournal[]
  contact_disclosures ContactDisclosure[]
  contact_issues      ContactIssueReport[]
  disputes            CaseDispute[]
  review              Review?

  conversations  Conversation[]
  client_reviews ClientReview[]

  // Partial indexes (§5.2) and the search_tsv GIN index are raw SQL in the
  // stage 2.6 migration.
  // GIN/inverted (trigram gin_trgm_ops or full-text), created by the stage 2.6
  // migration; declared so Prisma's diff matches the DB.
  @@index([search_tsv], map: "cases_search_tsv_idx", type: Gin)
  @@index([search_tsv_simple], map: "cases_search_tsv_simple_idx", type: Gin)
  // Review-reminder job: status = 'closed' AND closed_at range (docs/03
  // §7, stage 4.1 migration, file-03 DB review).
  @@index([status, closed_at])
  // Owner 2026-10-05: the daily deadline-reminder job.
  @@index([deadline_at])
  @@map("cases")
}

model CaseState {
  case_id    String  @db.Uuid
  case       Case    @relation(fields: [case_id], references: [id], onDelete: Restrict)
  state_code String  @db.Char(2)
  state      State   @relation(fields: [state_code], references: [code], onDelete: Restrict)
  is_primary Boolean @default(false)

  @@id([case_id, state_code])
  @@index([state_code, case_id])
  @@map("case_states")
}

model Bid {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id                 String            @db.Uuid
  case                    Case              @relation("CaseBids", fields: [case_id], references: [id], onDelete: Restrict)
  attorney_id             String            @db.Uuid
  attorney                User              @relation("BidAttorney", fields: [attorney_id], references: [id], onDelete: Restrict)
  status                  BidStatus         @default(active)
  fee_type                FeeType
  amount_cents            Int
  // ≤2000 chars (§6.1), CHECK in the migration.
  message                 String
  start_availability      StartAvailability
  start_date              DateTime?         @db.Date
  estimated_duration_days Int?
  round_count             Int               @default(0) @db.SmallInt
  turn                    PartyRole
  // Owner 2026-09-30: the case's practice is not one of the attorney's.
  outside_practice        Boolean           @default(false)
  // Owner 2026-10-04: no verified licence in the case's states.
  outside_licensed_states Boolean           @default(false)
  decided_at              DateTime?         @db.Timestamptz
  created_at              DateTime          @default(now()) @db.Timestamptz
  updated_at              DateTime          @updatedAt @db.Timestamptz

  accepted_for_case  Case?                @relation("CaseAcceptedBid")
  offers             BidOffer[]
  contact_disclosure ContactDisclosure?
  contact_issues     ContactIssueReport[]

  // One bid per attorney per case (§4.D, §5.1).
  conversations Conversation[]

  @@unique([case_id, attorney_id])
  @@index([case_id, status])
  @@index([attorney_id, status, updated_at(sort: Desc)])
  // docs/04 §11.2 "Мои биды" finished filter (migration file04_scale_indexes).
  @@index([attorney_id, updated_at(sort: Desc), id(sort: Desc)], map: "bids_attorney_updated_idx")
  // docs/06 §8 business counter (active bids) and the hourly lapse job.
  @@index([status])
  @@map("bids")
}

// Negotiation history. Append-only except the pending -> accepted/
// declined/countered/superseded status transition (§4.D).
model BidOffer {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bid_id       String      @db.Uuid
  bid          Bid         @relation(fields: [bid_id], references: [id], onDelete: Restrict)
  round_no     Int         @db.SmallInt
  from_role    PartyRole
  fee_type     FeeType
  amount_cents Int
  message      String?
  status       OfferStatus
  created_at   DateTime    @default(now()) @db.Timestamptz

  @@unique([bid_id, round_no])
  @@map("bid_offers")
}

// Append-only, kept 5 years, hash-chained per case (§4.D). No
// updated_at. retain_until defaults to created_at + 5 years.
model CaseJournal {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id       String           @db.Uuid
  case          Case             @relation(fields: [case_id], references: [id], onDelete: Restrict)
  client_id     String           @db.Uuid
  client        User             @relation("JournalClient", fields: [client_id], references: [id], onDelete: Restrict)
  actor_user_id String?          @db.Uuid
  actor         User?            @relation("JournalActor", fields: [actor_user_id], references: [id], onDelete: Restrict)
  actor_role    UserRole?
  // docs/04_CASES_BIDS.md §14 (stage 4.1): set for events tied to a bid or
  // to the attorney's work, for the attorney's "Case history".
  attorney_id   String?          @db.Uuid
  attorney      User?            @relation("JournalAttorney", fields: [attorney_id], references: [id], onDelete: Restrict)
  event_type    CaseJournalEvent
  payload       Json
  prev_hash     String?
  row_hash      String
  retain_until  DateTime         @default(dbgenerated("(now() + '5 years'::interval)")) @db.Timestamptz
  created_at    DateTime         @default(now()) @db.Timestamptz

  @@index([case_id, created_at])
  @@index([client_id, created_at])
  @@index([attorney_id, created_at])
  @@index([retain_until])
  // docs/06 §5.3: the daily chain check picks the last 24 h of rows.
  @@index([created_at])
  @@map("case_journal")
}

// Append-only (§4.D, §6.2).
model ContactDisclosure {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id      String   @db.Uuid
  case         Case     @relation(fields: [case_id], references: [id], onDelete: Restrict)
  bid_id       String   @unique @db.Uuid
  bid          Bid      @relation(fields: [bid_id], references: [id], onDelete: Restrict)
  client_id    String   @db.Uuid
  client       User     @relation("DisclosureClient", fields: [client_id], references: [id], onDelete: Restrict)
  attorney_id  String   @db.Uuid
  attorney     User     @relation("DisclosureAttorney", fields: [attorney_id], references: [id], onDelete: Restrict)
  fields       String[]
  ip           String?
  device_id    String?
  disclosed_at DateTime @default(now()) @db.Timestamptz

  @@map("contact_disclosures")
}

model ContactIssueReport {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id         String             @db.Uuid
  case            Case               @relation(fields: [case_id], references: [id], onDelete: Restrict)
  bid_id          String             @db.Uuid
  bid             Bid                @relation(fields: [bid_id], references: [id], onDelete: Restrict)
  attorney_id     String             @db.Uuid
  attorney        User               @relation("IssueAttorney", fields: [attorney_id], references: [id], onDelete: Restrict)
  client_id       String             @db.Uuid
  client          User               @relation("IssueClient", fields: [client_id], references: [id], onDelete: Restrict)
  issue_type      ContactIssueType
  note            String?
  status          ContactIssueStatus @default(open)
  resolved_by     String?            @db.Uuid
  resolver        User?              @relation("IssueResolver", fields: [resolved_by], references: [id], onDelete: Restrict)
  resolved_at     DateTime?          @db.Timestamptz
  resolution_note String?
  created_at      DateTime           @default(now()) @db.Timestamptz
  updated_at      DateTime           @updatedAt @db.Timestamptz

  @@index([status, created_at])
  @@map("contact_issue_reports")
}

model CaseDispute {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id         String        @db.Uuid
  case            Case          @relation(fields: [case_id], references: [id], onDelete: Restrict)
  opened_by       String        @db.Uuid
  opener          User          @relation("DisputeOpener", fields: [opened_by], references: [id], onDelete: Restrict)
  reason          String
  status          DisputeStatus @default(open)
  resolved_by     String?       @db.Uuid
  resolver        User?         @relation("DisputeResolver", fields: [resolved_by], references: [id], onDelete: Restrict)
  resolved_at     DateTime?     @db.Timestamptz
  resolution_note String?
  created_at      DateTime      @default(now()) @db.Timestamptz
  updated_at      DateTime      @updatedAt @db.Timestamptz

  @@index([case_id])
  @@map("case_disputes")
}

model Review {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Owner 2026-10-01: null = an open review (anyone, one per author);
  /// set = verified by a closed case.
  case_id       String?      @unique @db.Uuid
  case          Case?        @relation(fields: [case_id], references: [id], onDelete: Restrict)
  /// The author (a client for case reviews; anyone for open ones).
  client_id     String       @db.Uuid
  client        User         @relation("ReviewClient", fields: [client_id], references: [id], onDelete: Restrict)
  attorney_id   String       @db.Uuid
  attorney      User         @relation("ReviewAttorney", fields: [attorney_id], references: [id], onDelete: Restrict)
  // CHECK 1..5; body ≤ 1000 (§6.1), in the migration.
  rating        Int          @db.SmallInt
  body          String?
  status        ReviewStatus @default(published)
  // docs/03_VERIFICATION_PROFILES.md §10 (stage 3.1)
  edited_at     DateTime?    @db.Timestamptz
  /// Owner 2026-10-01 (Google-style): the attorney's public reply.
  reply         String?      @db.VarChar(1000)
  reply_at      DateTime?    @db.Timestamptz
  helpful_count Int          @default(0)
  /// Owner 2026-10-01: up to 10 `review_photo` files.
  photo_ids     String[]     @default([]) @db.Uuid
  created_at    DateTime     @default(now()) @db.Timestamptz
  updated_at    DateTime     @updatedAt @db.Timestamptz

  helpful_votes ReviewHelpfulVote[]

  @@index([attorney_id, created_at(sort: Desc)])
  // Owner 2026-10-05: the storage cleanup looks photos up by id.
  @@index([photo_ids], map: "reviews_photo_ids_idx", type: Gin)
  @@map("reviews")
}

// -----------------------------------------------------------------------
// Stage 2.5 (docs/02_DATABASE.md §8): 4.F feed/social, 4.G chats,
// 4.H notifications/push, 4.I Stripe subscriptions, 4.J moderation/admin/
// audit. Auxiliary rows (likes, saves, follows, tags, participants,
// media) cascade (§1.4); everything else is RESTRICT. Counters are
// denormalized per §1.5.
// -----------------------------------------------------------------------

model Post {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Attorneys only (checked in the service, file 05).
  author_id            String                   @db.Uuid
  author               User                     @relation("PostAuthor", fields: [author_id], references: [id], onDelete: Restrict)
  // ≤2200 chars (§6.1), CHECK in the migration.
  body                 String
  // Owner 2026-09-30: card title (≤120, CHECK in the migration), the
  // qualification (category or subcategory) and Post / News.
  title                String?
  practice_area_id     String?                  @db.Uuid
  practice_area        PracticeArea?            @relation(fields: [practice_area_id], references: [id], onDelete: Restrict)
  // Owner 2026-10-15: the topic the text itself names (search only).
  inferred_practice_id String?                  @db.Uuid
  topic_scanned_at     DateTime?                @db.Timestamptz(6)
  kind                 PostKind                 @default(post)
  /// Owner 2026-10-01: the post's video (Bunny Stream), one per post.
  video_asset_id       String?                  @unique @db.Uuid
  video_asset          VideoAsset?              @relation(fields: [video_asset_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "posts_video_asset_fkey")
  language             String?
  /// Owner 2026-10-02: "Added location" (reels/posts, like Instagram).
  location_name        String?
  location_lat         Float?
  location_lng         Float?
  /// Owner 2026-10-02: the author can turn comments off.
  comments_enabled     Boolean                  @default(true)
  /// Owner 2026-10-15: the author hides the like / view counter from others.
  hide_likes           Boolean                  @default(false)
  hide_views           Boolean                  @default(false)
  /// Owner 2026-10-05: 'legal' (a law topic, news, or marked by the author)
  /// or 'general' (personal, no law topic). Viewers can hide general posts.
  content_class        String                   @default("general") @db.VarChar(16)
  /// Set by moderation: the author's edits no longer change content_class.
  content_class_locked Boolean                  @default(false)
  status               ContentStatus            @default(published)
  like_count           Int                      @default(0)
  comment_count        Int                      @default(0)
  save_count           Int                      @default(0)
  // Owner 2026-09-30 (OQ-037): times shared (share sheet completed).
  share_count          Int                      @default(0)
  shares               PostShare[]
  // Owner 2026-10-12: views of a video post / reel (one per viewer).
  view_count           Int                      @default(0)
  views                PostView[]
  // Owner 2026-10-12: pinned to the top of the author's profile list, slot
  // 1..3 inside pin_group 'grid' (posts) or 'brief' (text-only). A partial
  // unique index (author, group, slot) is in the migration.
  pin_slot             Int?                     @db.SmallInt
  pin_group            String?
  // docs/05 §3.3, §14 (stage 5.1): "Изменено" after a text edit.
  edited_at            DateTime?                @db.Timestamptz
  deleted_at           DateTime?                @db.Timestamptz
  // STORED computed column (§5.3): to_tsvector('english', body). Read-only.
  search_tsv           Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, f_unaccent(COALESCE(title, ''::text))), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, f_unaccent(body)), 'C'::\"char\"))"))
  // Owner 2026-10-13: the same text in the language-neutral 'simple' config.
  search_tsv_simple    Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('simple'::regconfig, f_unaccent(COALESCE(title, ''::text))), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, f_unaccent(body)), 'C'::\"char\"))"))
  created_at           DateTime                 @default(now()) @db.Timestamptz
  // Explicit write-shard 0..15 (docs/02 §1.1 hot-spot rule): STORED
  // computed column, indexed as (created_shard, created_at). Replaces a
  // USING HASH index, which crashes Prisma's introspection. Read-only.
  created_shard        Int                      @default(0) @db.SmallInt
  updated_at           DateTime                 @updatedAt @db.Timestamptz

  media       PostMedia[]
  attachments PostAttachment[]
  tags        PostTag[]
  comments    Comment[]
  likes       PostLike[]
  reposts     PostRepost[]

  // GIN/inverted (trigram gin_trgm_ops or full-text), created by the stage 2.6
  // migration; declared so Prisma's diff matches the DB.
  @@index([search_tsv], map: "posts_search_tsv_idx", type: Gin)
  @@index([search_tsv_simple], map: "posts_search_tsv_simple_idx", type: Gin)
  @@index([practice_area_id, created_at(sort: Desc)])
  @@index([kind, created_at(sort: Desc)])
  @@index([content_class, created_at(sort: Desc)])
  @@map("posts")
}

/// Owner decision 2026-09-30 (OQ-031): up to 9 photos per case, stored in
/// the private documents bucket; visible to the case owner and the
/// attorney whose bid was accepted — never in the feed or to other bidders.
model CasePhoto {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id        String   @db.Uuid
  case           Case     @relation(fields: [case_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  file_id        String   @db.Uuid
  file           File     @relation(fields: [file_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  position       Int      @db.SmallInt
  /// Owner 2026-10-13: a short note on each file (≤500), who added it and
  /// where it came from: the case itself, a task submission or an update.
  description    String?  @db.VarChar(500)
  source         String   @default("case")
  source_id      String?  @db.Uuid
  /// The checklist line of a for-client task this file answers.
  source_item_id String?  @db.Uuid
  /// A "Sample": a form to fill / an example of what to send.
  is_sample      Boolean  @default(false)
  added_by       String?  @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz

  @@unique([case_id, position])
  @@index([file_id])
  @@index([source, source_id])
  @@map("case_photos")
}

/// Owner 2026-10-13: a task of the case workspace. `shared` is the
/// attorney's work the client sees (only the attorney ticks it);
/// `for_client` asks the client for something (the client reads it,
/// answers with a note and files and may add more after "Done" until the
/// attorney closes it). Private tasks live in attorney_tasks (the planner).
model CaseTask {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id     String          @db.Uuid
  case        Case            @relation(fields: [case_id], references: [id], onDelete: Cascade)
  kind        String
  title       String          @db.VarChar(200)
  description String?
  created_by  String          @db.Uuid
  /// open | done
  status      String          @default("open")
  done_at     DateTime?       @db.Timestamptz
  done_by     String?         @db.Uuid
  /// Closed by the attorney: the client can no longer add.
  closed_at   DateTime?       @db.Timestamptz
  /// Owner 2026-10-13: the day the task is due (both sides see it).
  due_at      DateTime?       @db.Timestamptz
  created_at  DateTime        @default(now()) @db.Timestamptz
  updated_at  DateTime        @default(now()) @updatedAt @db.Timestamptz
  events      CaseTaskEvent[]
  items       CaseTaskItem[]

  @@index([case_id, created_at])
  @@map("case_tasks")
}

/// A line of a for-client task's checklist ("Passport", "Translation"):
/// ticked by the client when answered, with its own file and note.
model CaseTaskItem {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id    String    @db.Uuid
  task       CaseTask  @relation(fields: [task_id], references: [id], onDelete: Cascade)
  position   Int       @db.SmallInt
  title      String    @db.VarChar(200)
  done_at    DateTime? @db.Timestamptz
  done_by    String?   @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz

  @@index([task_id, position])
  @@map("case_task_items")
}

