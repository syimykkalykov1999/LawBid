  /// [{ name, label, secret, required }]
  fields      Json     @default("[]")
  created_by  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz

  @@map("integration_custom_providers")
}

/// Owner 2026-10-01: Bunny Stream video of a post.
enum VideoAssetStatus {
  awaiting_upload
  processing
  ready
  failed
  rejected
  deleted

  @@map("video_asset_status")
}

model VideoAsset {
