// -----------------------------------------------------------------------
// 4.A — Users, auth, consents, files (docs/02_DATABASE.md §4.A)
// -----------------------------------------------------------------------

model User {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable: docs/01_FOUNDATION_AUTH.md §11 "Guard-логика навигации" treats "no role yet"
  // as a real intermediate state ("нет роли → /onboarding/role") -- a user exists
  // from the moment OTP/social login succeeds (stage 1.4), but role is
  // chosen afterward during onboarding step 2, not at creation. Added in
  // stage 1.4 (docs/CHANGELOG.md) -- the stage 1.3 migration is not
  // modified, only extended, per .cursorrules.
  role                  UserRole?
  status                UserStatus @default(active)
  first_name            String?
  last_name             String?
  avatar_file_id        String?    @db.Uuid
  avatar_file           File?      @relation("UserAvatar", fields: [avatar_file_id], references: [id], onDelete: Restrict)
  // UQ (docs/02 §4.A, §5.1). A plain unique index already admits any
  // number of NULLs in CockroachDB, which is exactly the §8 stage-2.2
  // acceptance ("несколько NULL допускаются"); a partial index can't be
  // expressed in Prisma 6 and would be dropped as drift by the next
  // `migrate dev`, so @unique is used instead.
  email                 String?    @unique
  email_verified_at     DateTime?  @db.Timestamptz
  phone_e164            String?    @unique
  phone_verified_at     DateTime?  @db.Timestamptz
  ui_language           String     @default("en")
  theme                 ThemePref  @default(system)
  suspended_reason      String?
  last_active_at        DateTime?  @db.Timestamptz
  deletion_requested_at DateTime?  @db.Timestamptz
  deleted_at            DateTime?  @db.Timestamptz
  anonymized_at         DateTime?  @db.Timestamptz
  // STORED computed column (§5.3): lower(first_name || ' ' || last_name),
  // trigram GIN-indexed. Read-only — never write it.
  full_name_lower       String?    @default(dbgenerated("lower((COALESCE(first_name, ''::STRING) || ' '::STRING) || COALESCE(last_name, ''::STRING))"))
  created_at            DateTime   @default(now()) @db.Timestamptz
  updated_at            DateTime   @updatedAt @db.Timestamptz

  identifiers          UserIdentifier[]
  sessions             Session[]
  auth_events          AuthEvent[]
  consents             UserConsent[]
  onboarding_state     OnboardingState?
  feature_flag_updates FeatureFlag[]
  files                File[]           @relation("FileOwner")

  client_profile         ClientProfile?
  attorney_profile       AttorneyProfile?
  licenses_verified      AttorneyLicense[]     @relation("LicenseVerifier")
  verifications_reviewed VerificationRequest[] @relation("VerificationReviewer")

  cases_as_client         Case[]               @relation("CaseClient")
  bids_as_attorney        Bid[]                @relation("BidAttorney")
  journal_as_client       CaseJournal[]        @relation("JournalClient")
  journal_as_actor        CaseJournal[]        @relation("JournalActor")
  disclosures_as_client   ContactDisclosure[]  @relation("DisclosureClient")
  disclosures_as_attorney ContactDisclosure[]  @relation("DisclosureAttorney")
  issues_as_attorney      ContactIssueReport[] @relation("IssueAttorney")
  issues_as_client        ContactIssueReport[] @relation("IssueClient")
  issues_resolved         ContactIssueReport[] @relation("IssueResolver")
  disputes_opened         CaseDispute[]        @relation("DisputeOpener")
  disputes_resolved       CaseDispute[]        @relation("DisputeResolver")
  reviews_as_client       Review[]             @relation("ReviewClient")
  reviews_as_attorney     Review[]             @relation("ReviewAttorney")

  posts                    Post[]                    @relation("PostAuthor")
  comments                 Comment[]                 @relation("CommentAuthor")
  post_likes               PostLike[]                @relation("PostLiker")
  comment_likes            CommentLike[]             @relation("CommentLiker")
  following                Follow[]                  @relation("Follower")
  followers                Follow[]                  @relation("Followee")
  saved_items              SavedItem[]
  conversations_attorney   Conversation[]            @relation("ConversationAttorney")
  conversations_client     Conversation[]            @relation("ConversationClient")
  conversation_memberships ConversationParticipant[]
  messages_sent            Message[]                 @relation("MessageSender")
  notifications            Notification[]
  notification_settings    NotificationSetting[]
  quiet_hours              NotificationQuietHours?
  push_tokens              PushToken[]
  stripe_customer          StripeCustomer?
  subscription             Subscription?
  payments                 Payment[]
  reports_filed            Report[]                  @relation("Reporter")
  reports_handled          Report[]                  @relation("ReportHandler")
  moderation_actions       ModerationAction[]        @relation("ModerationAdmin")
  admin_profile            AdminProfile?
  audit_entries            AuditLog[]                @relation("AuditAdmin")
  data_requests_handled    DataAccessRequest[]       @relation("DataRequestHandler")
  data_access_entries      DataAccessLog[]           @relation("DataAccessAdmin")

  // Trigram GIN on full_name_lower is a *partial* index (raw SQL): Prisma's
  // CockroachDB connector can't declare gin_trgm_ops, and ignores partial
  // indexes in its diff.
  @@map("users")
}

// docs/02_DATABASE.md §4.A (stage 2.2). Binary content lives only in S3
// (§1.6); this row is the reference. Soft delete via deleted_at.
model File {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_user_id String      @db.Uuid
  owner         User        @relation("FileOwner", fields: [owner_user_id], references: [id], onDelete: Restrict)
  purpose       FilePurpose
  s3_bucket     String
  s3_key        String      @unique
  mime          String
  size_bytes    BigInt
  sha256        String
  width         Int?
  height        Int?
  scan_status   ScanStatus  @default(pending)
  is_public     Boolean     @default(false)
  deleted_at    DateTime?   @db.Timestamptz
  created_at    DateTime    @default(now()) @db.Timestamptz
  updated_at    DateTime    @updatedAt @db.Timestamptz

  avatar_of User[] @relation("UserAvatar")

  verification_documents VerificationDocument[]

  post_media PostMedia[]

  @@index([owner_user_id])
  @@map("files")
}

model UserIdentifier {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String         @db.Uuid
  user         User           @relation(fields: [user_id], references: [id], onDelete: Restrict)
  provider     IdentifierType
  provider_uid String
  verified_at  DateTime?      @db.Timestamptz
  created_at   DateTime       @default(now()) @db.Timestamptz
  updated_at   DateTime       @updatedAt @db.Timestamptz

  @@unique([provider, provider_uid])
  @@index([user_id])
  @@map("user_identifiers")
}

model Session {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  user    User   @relation(fields: [user_id], references: [id], onDelete: Restrict)

  // Stable across refresh rotation (docs/01_FOUNDATION_AUTH.md §10.4): one
  // chain = one device/login. Each `Session` row is one refresh-token
  // generation within that chain; `id` therefore changes every rotation,
  // but `session_chain_id` does not. The JWT `sid` claim, `GET
  // /auth/sessions`, and `DELETE /auth/sessions/:id` all key off the chain
  // id, not the row id, so the "active devices" list stays stable and
  // "revoke the whole chain on refresh-token reuse" is a single indexed
  // UPDATE (`WHERE session_chain_id = ? AND revoked_at IS NULL`) instead of
  // walking `replaced_by_session_id` back through the rotation history.
  // Added in stage 1.4 (docs/CHANGELOG.md), additive to the stage 1.3
  // migration — that migration is not modified, only extended.
  session_chain_id String @db.Uuid

  device_id              String?
  device_name            String?
  platform               String?
  app_version            String?
  ip                     String?
  user_agent             String?
  refresh_hash           String    @unique
  last_used_at           DateTime? @db.Timestamptz
  expires_at             DateTime  @db.Timestamptz
  revoked_at             DateTime? @db.Timestamptz
  revoked_reason         String?
  // Audit trail of rotation order within a chain — NOT used for revocation
  // logic anymore (see session_chain_id above), kept as a bare pointer
  // (not an enforced FK) purely for forensic "what replaced what" queries.
  replaced_by_session_id String?   @db.Uuid
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @updatedAt @db.Timestamptz

  // Partial index sessions(user_id) WHERE revoked_at IS NULL is raw SQL,
  // stage 2.6 (docs/02_DATABASE.md §5.2). This plain index covers lookups
  // until then.
  push_tokens PushToken[]

  // (user_id) WHERE revoked_at IS NULL: partial index, raw SQL (2.6).
  @@index([session_chain_id])
  @@map("sessions")
}

model AuthEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?  @db.Uuid
  user            User?    @relation(fields: [user_id], references: [id], onDelete: Restrict)
  event_type      String
  success         Boolean
  identifier_hash String?
  ip              String?
  device_id       String?
  user_agent      String?
  meta            Json?
  created_at      DateTime @default(now()) @db.Timestamptz
  // Explicit write-shard 0..15 (docs/02 §1.1 hot-spot rule): STORED
  // computed column, indexed as (created_shard, created_at). Replaces a
  // USING HASH index, which crashes Prisma's introspection. Read-only.
  created_shard   Int      @default(dbgenerated("mod(fnv32(id::STRING), 16)::INT2")) @db.Int2

  // Append-only (docs/02_DATABASE.md §6.2) — no updated_at, and the
  // lawbid_app DB role gets INSERT/SELECT only (raw SQL grant, stage 2.6).
  // Hash-sharded (created_at) index is also raw SQL, stage 2.6 (§5.2).
  @@index([user_id, created_at(sort: Desc)])
  @@index([created_shard, created_at], map: "auth_events_created_at_idx")
  @@map("auth_events")
}

model LegalDocument {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doc_type     LegalDocType
  version      String
  locale       String
  content_url  String?
  content_md   String?
  published_at DateTime?    @db.Timestamptz
  is_current   Boolean
  created_at   DateTime     @default(now()) @db.Timestamptz
  updated_at   DateTime     @updatedAt @db.Timestamptz

  consents UserConsent[]

  @@unique([doc_type, version, locale])
  @@map("legal_documents")
}

model UserConsent {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String         @db.Uuid
  user         User           @relation(fields: [user_id], references: [id], onDelete: Restrict)
  consent_type ConsentType
  document_id  String?        @db.Uuid
  document     LegalDocument? @relation(fields: [document_id], references: [id], onDelete: Restrict)
  granted      Boolean
  ip           String?
  device_id    String?
  created_at   DateTime       @default(now()) @db.Timestamptz

  // Append-only (docs/02_DATABASE.md §6.2) — no updated_at. Current
  // consent state = latest row per (user_id, consent_type).
  @@index([user_id, consent_type, created_at(sort: Desc)])
  @@map("user_consents")
}

model OnboardingState {
  user_id      String    @id @db.Uuid
  user         User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  current_step String?
  completed_at DateTime? @db.Timestamptz
  data         Json?
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz

  @@map("onboarding_state")
}

model BlockedEmailDomain {
  domain String @id
  reason String

  // Reference/seed table (docs/02_DATABASE.md §3.3) — no timestamps, same
  // minimal shape as states/practice_areas (§3.1/3.2).
  @@map("blocked_email_domains")
}

// -----------------------------------------------------------------------
// 4.B — Config and translations (docs/02_DATABASE.md §4.B)
// feature_flags + i18n_* were modeled in stage 1.3; app_config is added
// here in stage 1.8 (docs/01_FOUNDATION_AUTH.md §15, "Этап 1.8: Feature
// flags и обязательное обновление") — see migration
// 20260923010000_stage_1_8_app_config.
// -----------------------------------------------------------------------

model FeatureFlag {
  key             String   @id
  enabled         Boolean
  rollout_percent Int      @default(100)
  description     String?
  updated_by      String?  @db.Uuid
  updated_by_user User?    @relation(fields: [updated_by], references: [id], onDelete: Restrict)
  updated_at      DateTime @updatedAt @db.Timestamptz

  // No created_at — docs/02_DATABASE.md §4.B lists only key/enabled/
  // rollout_percent/description/updated_by/updated_at for this table.
  @@map("feature_flags")
}

// docs/02_DATABASE.md §4.B: "app_config: key text PK, value jsonb,
// updated_at. Ключи: min_app_version_ios, min_app_version_android,
// soft_update_version_ios, soft_update_version_android." A generic
// key->jsonb store (like feature_flags) rather than four dedicated
// columns, matching the doc's own shape and letting a later stage add
// more app_config keys without a migration.
model AppConfig {
  key        String   @id
  value      Json
  updated_at DateTime @updatedAt @db.Timestamptz

  // No created_at, no updated_by — docs/02_DATABASE.md §4.B lists only
  // key/value/updated_at for this table (unlike feature_flags, it has no
  // updated_by FK either).
  @@map("app_config")
}

model I18nLanguage {
  code        String  @id
  name_native String
  is_active   Boolean
  is_rtl      Boolean @default(false)
  sort        Int

  translations   I18nTranslation[]
  bundle_version I18nBundleVersion?

  // Reference/seed table (docs/02_DATABASE.md §3.3) — no timestamps, same
  // minimal shape as states/practice_areas (§3.1/3.2).
  @@map("i18n_languages")
}

model I18nKey {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  translations I18nTranslation[]

  @@map("i18n_keys")
}

model I18nTranslation {
  key_id     String       @db.Uuid
  i18n_key   I18nKey      @relation(fields: [key_id], references: [id], onDelete: Restrict)
  lang       String
  language   I18nLanguage @relation(fields: [lang], references: [code], onDelete: Restrict)
  value      String
  version    Int
  updated_at DateTime     @updatedAt @db.Timestamptz

  // No created_at — docs/02_DATABASE.md §4.B lists only key_id/lang/value/
  // version/updated_at for this table.
  @@id([key_id, lang])
  @@map("i18n_translations")
}

model I18nBundleVersion {
  lang       String       @id
  language   I18nLanguage @relation(fields: [lang], references: [code], onDelete: Restrict)
  version    Int
  updated_at DateTime     @updatedAt @db.Timestamptz

  // No created_at — docs/02_DATABASE.md §4.B lists only lang/version/
  // updated_at for this table.
  @@map("i18n_bundle_versions")
}

// -----------------------------------------------------------------------
// Reference data (docs/02_DATABASE.md §3.1/§3.2) — stage 2.1.
// -----------------------------------------------------------------------

// docs/02_DATABASE.md §3.1: states(code PK char(2), name, is_active
// default true). 50 states + DC; UI names come from i18n `state.<code>`.
model State {
  code      String  @id @db.Char(2)
  name      String
  is_active Boolean @default(true)

  // Reference/seed table — no timestamps, per §3.1's column list.
  client_profiles        ClientProfile[]
  attorney_licenses      AttorneyLicense[]
  verification_documents VerificationDocument[]

  primary_for_cases CaseState[]
  cases_primary     Case[]      @relation("CasePrimaryState")

  @@map("states")
}

// docs/02_DATABASE.md §3.2: two-level tree category -> specialization.
// parent_id is null for a category. code is UQ and follows the §3.2
// generation rule (see prisma/seed/practice-areas.util.ts). Cases and
// attorney selections always reference leaves (enforced in services).
model PracticeArea {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id String? @db.Uuid
  code      String  @unique
  name_en   String
  i18n_key  String
  sort      Int
  is_active Boolean @default(true)

  parent   PracticeArea?  @relation("PracticeAreaTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children PracticeArea[] @relation("PracticeAreaTree")

  // Reference/seed table — no timestamps, per §3.2's column list.
  attorney_practice_areas AttorneyPracticeArea[]

  cases Case[]

  @@index([parent_id])
  @@map("practice_areas")
}

// -----------------------------------------------------------------------
// 4.C — Profiles and verification (docs/02_DATABASE.md §4.C) — stage 2.3.
// -----------------------------------------------------------------------

model ClientProfile {
  user_id                  String         @id @db.Uuid
  user                     User           @relation(fields: [user_id], references: [id], onDelete: Restrict)
  state_code               String         @db.Char(2)
  state                    State          @relation(fields: [state_code], references: [code], onDelete: Restrict)
  preferred_languages      String[]
  preferred_contact_method ContactMethod?
  // ≤200 chars (§4.C), CHECK in the migration.
  preferred_contact_note   String?
  created_at               DateTime       @default(now()) @db.Timestamptz
  updated_at               DateTime       @updatedAt @db.Timestamptz

  // GIN/inverted (trigram gin_trgm_ops or full-text), created by the stage 2.6
  // migration; declared so Prisma's diff matches the DB.
  @@index([preferred_languages], map: "client_profiles_languages_idx", type: Gin)
  @@map("client_profiles")
}

model AttorneyProfile {
  user_id             String             @id @db.Uuid
  user                User               @relation(fields: [user_id], references: [id], onDelete: Restrict)
  username            String
  username_lower      String             @unique
  // ≤300 chars (§4.C / §6.1), CHECK in the migration.
  bio                 String?
  firm_name           String?
  languages           String[]
  verification_status VerificationStatus @default(unverified)
  verified_at         DateTime?          @db.Timestamptz
  rating_avg          Decimal            @default(0) @db.Decimal(3, 2)
  rating_count        Int                @default(0)
  posts_count         Int                @default(0)
  followers_count     Int                @default(0)
  following_count     Int                @default(0)
  created_at          DateTime           @default(now()) @db.Timestamptz
  updated_at          DateTime           @updatedAt @db.Timestamptz

  licenses              AttorneyLicense[]
  practice_areas        AttorneyPracticeArea[]
  verification_requests VerificationRequest[]

  // GIN/inverted (trigram gin_trgm_ops or full-text), created by the stage 2.6
  // migration; declared so Prisma's diff matches the DB.
  @@index([languages], map: "attorney_profiles_languages_idx", type: Gin)
  @@map("attorney_profiles")
}

model AttorneyLicense {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attorney_id       String          @db.Uuid
  attorney          AttorneyProfile @relation(fields: [attorney_id], references: [user_id], onDelete: Restrict)
  state_code        String          @db.Char(2)
  state             State           @relation(fields: [state_code], references: [code], onDelete: Restrict)
  bar_number        String
  license_status    LicenseStatus   @default(pending)
  expires_at        DateTime?       @db.Date
  verified_at       DateTime?       @db.Timestamptz
  verified_by       String?         @db.Uuid
  verifier          User?           @relation("LicenseVerifier", fields: [verified_by], references: [id], onDelete: Restrict)
  auto_check_result Json?
  created_at        DateTime        @default(now()) @db.Timestamptz
  updated_at        DateTime        @updatedAt @db.Timestamptz

  // One license can't be attached to two accounts (§4.C, §5.1).
  @@unique([state_code, bar_number])
  @@index([attorney_id])
  @@index([state_code, license_status])
  @@map("attorney_licenses")
}

model AttorneyPracticeArea {
  attorney_id      String          @db.Uuid
  attorney         AttorneyProfile @relation(fields: [attorney_id], references: [user_id], onDelete: Cascade)
  practice_area_id String          @db.Uuid
  practice_area    PracticeArea    @relation(fields: [practice_area_id], references: [id], onDelete: Restrict)
  created_at       DateTime        @default(now()) @db.Timestamptz

  @@id([attorney_id, practice_area_id])
  @@index([practice_area_id, attorney_id])
  @@map("attorney_practice_areas")
}

model VerificationRequest {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attorney_id      String                    @db.Uuid
  attorney         AttorneyProfile           @relation(fields: [attorney_id], references: [user_id], onDelete: Restrict)
  status           VerificationRequestStatus
  provider         VerificationProvider      @default(manual)
  provider_ref     String?
  submitted_at     DateTime?                 @db.Timestamptz
  reviewed_by      String?                   @db.Uuid
  reviewer         User?                     @relation("VerificationReviewer", fields: [reviewed_by], references: [id], onDelete: Restrict)
  reviewed_at      DateTime?                 @db.Timestamptz
  rejection_reason String?
  admin_note       String?
  created_at       DateTime                  @default(now()) @db.Timestamptz
  updated_at       DateTime                  @updatedAt @db.Timestamptz

  documents VerificationDocument[]
  checks    VerificationCheck[]

  @@index([attorney_id])
  @@index([status, submitted_at])
  @@map("verification_requests")
}

model VerificationDocument {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id String              @db.Uuid
  request    VerificationRequest @relation(fields: [request_id], references: [id], onDelete: Restrict)
  doc_type   VerificationDocType
  file_id    String              @db.Uuid
  file       File                @relation(fields: [file_id], references: [id], onDelete: Restrict)
  state_code String?             @db.Char(2)
  state      State?              @relation(fields: [state_code], references: [code], onDelete: Restrict)
  notes      String?
  created_at DateTime            @default(now()) @db.Timestamptz
  updated_at DateTime            @updatedAt @db.Timestamptz

  @@index([request_id])
  @@map("verification_documents")
}

model VerificationCheck {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id String                @db.Uuid
  request    VerificationRequest   @relation(fields: [request_id], references: [id], onDelete: Restrict)
  check_type VerificationCheckType
  provider   VerificationProvider
  result     CheckResult
  details    Json
  checked_at DateTime              @db.Timestamptz
  created_at DateTime              @default(now()) @db.Timestamptz

  @@index([request_id])
  @@map("verification_checks")
}

// -----------------------------------------------------------------------
// 4.D — Cases, bids, negotiation, journal (docs/02_DATABASE.md §4.D) and
// 4.E — Reviews — stage 2.4. CHECKs from §6.1 are raw SQL in the
// migration. Legally significant tables use ON DELETE RESTRICT (§1.4).
// -----------------------------------------------------------------------

model Case {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id             String                   @db.Uuid
  client                User                     @relation("CaseClient", fields: [client_id], references: [id], onDelete: Restrict)
  // ≤120 / ≤5000 chars (§6.1), CHECK in the migration.
  title                 String
  description           String
  // Leaf specialization only (enforced in the case service, file 04).
  practice_area_id      String                   @db.Uuid
  practice_area         PracticeArea             @relation(fields: [practice_area_id], references: [id], onDelete: Restrict)
  // Denormalized primary state for indexes; must match the is_primary
  // case_states row (service invariant, §4.D).
  primary_state_code    String                   @db.Char(2)
  primary_state         State                    @relation("CasePrimaryState", fields: [primary_state_code], references: [code], onDelete: Restrict)
  city                  String?
  budget_mode           BudgetMode
  budget_cents          Int?
  status                CaseStatus               @default(open)
  accepted_bid_id       String?                  @unique @db.Uuid
  accepted_bid          Bid?                     @relation("CaseAcceptedBid", fields: [accepted_bid_id], references: [id], onDelete: Restrict)
  view_count            Int                      @default(0)
  bids_count            Int                      @default(0)
  last_activity_at      DateTime                 @default(now()) @db.Timestamptz
  stale_prompt_sent_at  DateTime?                @db.Timestamptz
  archived_at           DateTime?                @db.Timestamptz
  client_completed_at   DateTime?                @db.Timestamptz
  attorney_confirmed_at DateTime?                @db.Timestamptz
  auto_close_at         DateTime?                @db.Timestamptz
  closed_at             DateTime?                @db.Timestamptz
  deleted_at            DateTime?                @db.Timestamptz
  // STORED computed column (§5.3): to_tsvector('english', title || ' ' ||
  // description). Read-only.
  search_tsv            Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::STRING, (title || ' '::STRING) || description)"))
  created_at            DateTime                 @default(now()) @db.Timestamptz
  updated_at            DateTime                 @updatedAt @db.Timestamptz

  states              CaseState[]
  bids                Bid[]                @relation("CaseBids")
  journal             CaseJournal[]
  contact_disclosures ContactDisclosure[]
  contact_issues      ContactIssueReport[]
  disputes            CaseDispute[]
  review              Review?

  conversations Conversation[]

  // Partial indexes (§5.2) and the search_tsv GIN index are raw SQL in the
  // stage 2.6 migration.
  // GIN/inverted (trigram gin_trgm_ops or full-text), created by the stage 2.6
  // migration; declared so Prisma's diff matches the DB.
  @@index([search_tsv], map: "cases_search_tsv_idx", type: Gin)
  @@map("cases")
}

model CaseState {
  case_id    String  @db.Uuid
  case       Case    @relation(fields: [case_id], references: [id], onDelete: Restrict)
  state_code String  @db.Char(2)
  state      State   @relation(fields: [state_code], references: [code], onDelete: Restrict)
  is_primary Boolean @default(false)

  @@id([case_id, state_code])
  @@index([state_code, case_id])
  @@map("case_states")
}

model Bid {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id                 String            @db.Uuid
  case                    Case              @relation("CaseBids", fields: [case_id], references: [id], onDelete: Restrict)
  attorney_id             String            @db.Uuid
  attorney                User              @relation("BidAttorney", fields: [attorney_id], references: [id], onDelete: Restrict)
  status                  BidStatus         @default(active)
  fee_type                FeeType
  amount_cents            Int
  // ≤2000 chars (§6.1), CHECK in the migration.
  message                 String
  start_availability      StartAvailability
  start_date              DateTime?         @db.Date
  estimated_duration_days Int?
  round_count             Int               @default(0) @db.Int2
  turn                    PartyRole
  decided_at              DateTime?         @db.Timestamptz
  created_at              DateTime          @default(now()) @db.Timestamptz
  updated_at              DateTime          @updatedAt @db.Timestamptz

  accepted_for_case  Case?                @relation("CaseAcceptedBid")
  offers             BidOffer[]
  contact_disclosure ContactDisclosure?
  contact_issues     ContactIssueReport[]

  // One bid per attorney per case (§4.D, §5.1).
  conversations Conversation[]

  @@unique([case_id, attorney_id])
  @@index([case_id, status])
  @@index([attorney_id, status, updated_at(sort: Desc)])
  @@map("bids")
}

// Negotiation history. Append-only except the pending -> accepted/
// declined/countered/superseded status transition (§4.D).
model BidOffer {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bid_id       String      @db.Uuid
  bid          Bid         @relation(fields: [bid_id], references: [id], onDelete: Restrict)
  round_no     Int         @db.Int2
  from_role    PartyRole
  fee_type     FeeType
  amount_cents Int
  message      String?
  status       OfferStatus
  created_at   DateTime    @default(now()) @db.Timestamptz

  @@unique([bid_id, round_no])
  @@map("bid_offers")
}

// Append-only, kept 5 years, hash-chained per case (§4.D). No
// updated_at. retain_until defaults to created_at + 5 years.
model CaseJournal {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id       String           @db.Uuid
  case          Case             @relation(fields: [case_id], references: [id], onDelete: Restrict)
  client_id     String           @db.Uuid
  client        User             @relation("JournalClient", fields: [client_id], references: [id], onDelete: Restrict)
  actor_user_id String?          @db.Uuid
  actor         User?            @relation("JournalActor", fields: [actor_user_id], references: [id], onDelete: Restrict)
  actor_role    UserRole?
  event_type    CaseJournalEvent
  payload       Json
  prev_hash     String?
  row_hash      String
  retain_until  DateTime         @default(dbgenerated("now() + '5 years'::INTERVAL")) @db.Timestamptz
  created_at    DateTime         @default(now()) @db.Timestamptz

  @@index([case_id, created_at])
  @@index([client_id, created_at])
  @@index([retain_until])
  @@map("case_journal")
}

// Append-only (§4.D, §6.2).
model ContactDisclosure {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id      String   @db.Uuid
  case         Case     @relation(fields: [case_id], references: [id], onDelete: Restrict)
  bid_id       String   @unique @db.Uuid
  bid          Bid      @relation(fields: [bid_id], references: [id], onDelete: Restrict)
  client_id    String   @db.Uuid
  client       User     @relation("DisclosureClient", fields: [client_id], references: [id], onDelete: Restrict)
  attorney_id  String   @db.Uuid
  attorney     User     @relation("DisclosureAttorney", fields: [attorney_id], references: [id], onDelete: Restrict)
  fields       String[]
  ip           String?
  device_id    String?
  disclosed_at DateTime @default(now()) @db.Timestamptz

  @@map("contact_disclosures")
}

model ContactIssueReport {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id         String             @db.Uuid
  case            Case               @relation(fields: [case_id], references: [id], onDelete: Restrict)
  bid_id          String             @db.Uuid
  bid             Bid                @relation(fields: [bid_id], references: [id], onDelete: Restrict)
  attorney_id     String             @db.Uuid
  attorney        User               @relation("IssueAttorney", fields: [attorney_id], references: [id], onDelete: Restrict)
  client_id       String             @db.Uuid
  client          User               @relation("IssueClient", fields: [client_id], references: [id], onDelete: Restrict)
  issue_type      ContactIssueType
  note            String?
  status          ContactIssueStatus @default(open)
  resolved_by     String?            @db.Uuid
  resolver        User?              @relation("IssueResolver", fields: [resolved_by], references: [id], onDelete: Restrict)
  resolved_at     DateTime?          @db.Timestamptz
  resolution_note String?
  created_at      DateTime           @default(now()) @db.Timestamptz
  updated_at      DateTime           @updatedAt @db.Timestamptz

  @@index([status, created_at])
  @@map("contact_issue_reports")
}

model CaseDispute {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id         String        @db.Uuid
  case            Case          @relation(fields: [case_id], references: [id], onDelete: Restrict)
  opened_by       String        @db.Uuid
  opener          User          @relation("DisputeOpener", fields: [opened_by], references: [id], onDelete: Restrict)
  reason          String
  status          DisputeStatus @default(open)
  resolved_by     String?       @db.Uuid
  resolver        User?         @relation("DisputeResolver", fields: [resolved_by], references: [id], onDelete: Restrict)
  resolved_at     DateTime?     @db.Timestamptz
  resolution_note String?
  created_at      DateTime      @default(now()) @db.Timestamptz
  updated_at      DateTime      @updatedAt @db.Timestamptz

  @@index([case_id])
  @@map("case_disputes")
}

model Review {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id     String       @unique @db.Uuid
  case        Case         @relation(fields: [case_id], references: [id], onDelete: Restrict)
  client_id   String       @db.Uuid
  client      User         @relation("ReviewClient", fields: [client_id], references: [id], onDelete: Restrict)
  attorney_id String       @db.Uuid
  attorney    User         @relation("ReviewAttorney", fields: [attorney_id], references: [id], onDelete: Restrict)
  // CHECK 1..5; body ≤ 1000 (§6.1), in the migration.
  rating      Int          @db.Int2
  body        String?
  status      ReviewStatus @default(published)
  created_at  DateTime     @default(now()) @db.Timestamptz
  updated_at  DateTime     @updatedAt @db.Timestamptz

  @@index([attorney_id, created_at(sort: Desc)])
  @@map("reviews")
}

// -----------------------------------------------------------------------
// Stage 2.5 (docs/02_DATABASE.md §8): 4.F feed/social, 4.G chats,
// 4.H notifications/push, 4.I Stripe subscriptions, 4.J moderation/admin/
// audit. Auxiliary rows (likes, saves, follows, tags, participants,
// media) cascade (§1.4); everything else is RESTRICT. Counters are
// denormalized per §1.5.
// -----------------------------------------------------------------------

model Post {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Attorneys only (checked in the service, file 05).
  author_id     String                   @db.Uuid
  author        User                     @relation("PostAuthor", fields: [author_id], references: [id], onDelete: Restrict)
  // ≤2200 chars (§6.1), CHECK in the migration.
  body          String
  language      String?
  status        ContentStatus            @default(published)
  like_count    Int                      @default(0)
  comment_count Int                      @default(0)
  save_count    Int                      @default(0)
  deleted_at    DateTime?                @db.Timestamptz
  // STORED computed column (§5.3): to_tsvector('english', body). Read-only.
  search_tsv    Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::STRING, body)"))
  created_at    DateTime                 @default(now()) @db.Timestamptz
  // Explicit write-shard 0..15 (docs/02 §1.1 hot-spot rule): STORED
  // computed column, indexed as (created_shard, created_at). Replaces a
  // USING HASH index, which crashes Prisma's introspection. Read-only.
  created_shard Int                      @default(dbgenerated("mod(fnv32(id::STRING), 16)::INT2")) @db.Int2
  updated_at    DateTime                 @updatedAt @db.Timestamptz

  media    PostMedia[]
  tags     PostTag[]
  comments Comment[]
  likes    PostLike[]

  // GIN/inverted (trigram gin_trgm_ops or full-text), created by the stage 2.6
  // migration; declared so Prisma's diff matches the DB.
  @@index([search_tsv], map: "posts_search_tsv_idx", type: Gin)
  @@map("posts")
}

model PostMedia {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String    @db.Uuid
  post       Post      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  file_id    String    @db.Uuid
  file       File      @relation(fields: [file_id], references: [id], onDelete: Restrict)
  media_type MediaType @default(image)
  position   Int       @db.Int2
  width      Int?
  height     Int?
  created_at DateTime  @default(now()) @db.Timestamptz

  @@unique([post_id, position])
  @@map("post_media")
}

model Tag {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Without '#', lowercase.
  tag_lower  String   @unique
  created_at DateTime @default(now()) @db.Timestamptz

  posts PostTag[]

  // Trigram GIN on tag_lower: partial index, raw SQL (see User).
  @@map("tags")
}

model PostTag {
  post_id String @db.Uuid
  post    Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)
  tag_id  String @db.Uuid
  tag     Tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([post_id, tag_id])
  @@index([tag_id, post_id])
  @@map("post_tags")
}

model Comment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id           String        @db.Uuid
  post              Post          @relation(fields: [post_id], references: [id], onDelete: Restrict)
  author_id         String        @db.Uuid
  author            User          @relation("CommentAuthor", fields: [author_id], references: [id], onDelete: Restrict)
  // One nesting level: replies to replies are attached to the top-level
  // parent by the service (§4.F).
  parent_comment_id String?       @db.Uuid
  parent            Comment?      @relation("CommentReplies", fields: [parent_comment_id], references: [id], onDelete: Restrict)
  replies           Comment[]     @relation("CommentReplies")
  // ≤1000 chars (§6.1), CHECK in the migration.
  body              String
  status            ContentStatus @default(published)
  like_count        Int           @default(0)
  reply_count       Int           @default(0)
  deleted_at        DateTime?     @db.Timestamptz
  created_at        DateTime      @default(now()) @db.Timestamptz
  updated_at        DateTime      @updatedAt @db.Timestamptz

  likes CommentLike[]

  @@index([post_id, created_at])
  @@index([parent_comment_id, created_at])
  @@map("comments")
}

model PostLike {
  post_id    String   @db.Uuid
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user_id    String   @db.Uuid
  user       User     @relation("PostLiker", fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now()) @db.Timestamptz

  @@id([post_id, user_id])
  @@index([user_id, created_at(sort: Desc)])
  @@map("post_likes")
}

model CommentLike {
  comment_id String   @db.Uuid
  comment    Comment  @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  user_id    String   @db.Uuid
  user       User     @relation("CommentLiker", fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now()) @db.Timestamptz

  @@id([comment_id, user_id])
  @@map("comment_likes")
}

// followee must be an attorney (service check); follower <> followee is a
// CHECK in the migration.
model Follow {
  follower_id String   @db.Uuid
  follower    User     @relation("Follower", fields: [follower_id], references: [id], onDelete: Cascade)
  followee_id String   @db.Uuid
  followee    User     @relation("Followee", fields: [followee_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now()) @db.Timestamptz

  @@id([follower_id, followee_id])
  @@index([followee_id, follower_id])
  @@map("follows")
}

// Polymorphic item_id (post or case) — no FK by design.
model SavedItem {
  user_id    String        @db.Uuid
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  item_type  SavedItemType
  item_id    String        @db.Uuid
  created_at DateTime      @default(now()) @db.Timestamptz

  @@id([user_id, item_type, item_id])
  @@index([user_id, item_type, created_at(sort: Desc)])
  @@map("saved_items")
}

model Conversation {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  case_id           String             @db.Uuid
  case              Case               @relation(fields: [case_id], references: [id], onDelete: Restrict)
  attorney_id       String             @db.Uuid
  attorney          User               @relation("ConversationAttorney", fields: [attorney_id], references: [id], onDelete: Restrict)
  client_id         String             @db.Uuid
  client            User               @relation("ConversationClient", fields: [client_id], references: [id], onDelete: Restrict)
  bid_id            String?            @db.Uuid
  bid               Bid?               @relation(fields: [bid_id], references: [id], onDelete: Restrict)
  status            ConversationStatus @default(pre_acceptance)
  contacts_unlocked Boolean            @default(false)
  last_message_at   DateTime?          @db.Timestamptz
  // Bare uuid: an FK here would make conversations <-> messages a cycle
  // on every insert; it's a denormalized pointer for the chat list.
  last_message_id   String?            @db.Uuid
  created_at        DateTime           @default(now()) @db.Timestamptz
  updated_at        DateTime           @updatedAt @db.Timestamptz

  participants ConversationParticipant[]
  messages     Message[]

  @@unique([case_id, attorney_id])
  @@index([client_id, last_message_at(sort: Desc)])
  @@index([attorney_id, last_message_at(sort: Desc)])
  @@map("conversations")
}

model ConversationParticipant {
  conversation_id      String       @db.Uuid
  conversation         Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user_id              String       @db.Uuid
  user                 User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  last_read_message_id String?      @db.Uuid
  muted_until          DateTime?    @db.Timestamptz
  created_at           DateTime     @default(now()) @db.Timestamptz
  updated_at           DateTime     @updatedAt @db.Timestamptz

  @@id([conversation_id, user_id])
  @@index([user_id])
  @@map("conversation_participants")
}

model Message {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id   String       @db.Uuid
  conversation      Conversation @relation(fields: [conversation_id], references: [id], onDelete: Restrict)
  // NULL for system messages.
  sender_id         String?      @db.Uuid
  sender            User?        @relation("MessageSender", fields: [sender_id], references: [id], onDelete: Restrict)
  type              MessageType
  // Server/moderation/legal only (§1.6).
  body_original     String
  body_display      String
  contact_masked    Boolean      @default(false)
  // Client-generated idempotency key.
  client_message_id String
  deleted_at        DateTime?    @db.Timestamptz
  created_at        DateTime     @default(now()) @db.Timestamptz
  updated_at        DateTime     @updatedAt @db.Timestamptz

  @@unique([conversation_id, sender_id, client_message_id])
  @@index([conversation_id, created_at(sort: Desc)])
  @@map("messages")
}

model Notification {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String               @db.Uuid
  user       User                 @relation(fields: [user_id], references: [id], onDelete: Restrict)
  type       NotificationType
  category   NotificationCategory
  payload    Json
  read_at    DateTime?            @db.Timestamptz
  created_at DateTime             @default(now()) @db.Timestamptz

  @@index([user_id, created_at(sort: Desc)])
  @@map("notifications")
}

model NotificationSetting {
  user_id       String               @db.Uuid
  user          User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category      NotificationCategory
  push_enabled  Boolean              @default(true)
  email_enabled Boolean              @default(true)
  updated_at    DateTime             @updatedAt @db.Timestamptz

  @@id([user_id, category])
  @@map("notification_settings")
}

model NotificationQuietHours {
  user_id    String   @id @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  start_time DateTime @db.Time
  end_time   DateTime @db.Time
  timezone   String
  updated_at DateTime @updatedAt @db.Timestamptz

  @@map("notification_quiet_hours")
}

model PushToken {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session_id   String   @db.Uuid
  session      Session  @relation(fields: [session_id], references: [id], onDelete: Cascade)
  fcm_token    String   @unique
  platform     String
  last_seen_at DateTime @default(now()) @db.Timestamptz
  created_at   DateTime @default(now()) @db.Timestamptz

  @@index([user_id])
  @@map("push_tokens")
}

model StripeCustomer {
  user_id            String   @id @db.Uuid
  user               User     @relation(fields: [user_id], references: [id], onDelete: Restrict)
  stripe_customer_id String   @unique
  created_at         DateTime @default(now()) @db.Timestamptz

  @@map("stripe_customers")
}

model Subscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // One row per attorney.
  user_id                String             @unique @db.Uuid
  user                   User               @relation(fields: [user_id], references: [id], onDelete: Restrict)
  stripe_subscription_id String?            @unique
  status                 SubscriptionStatus
  // 39900 at launch.
  price_cents            Int
  trial_started_at       DateTime?          @db.Timestamptz
  trial_ends_at          DateTime?          @db.Timestamptz
  current_period_start   DateTime?          @db.Timestamptz
  current_period_end     DateTime?          @db.Timestamptz
  cancel_at_period_end   Boolean            @default(false)
  canceled_at            DateTime?          @db.Timestamptz
  // One card = one trial.
  card_fingerprint       String?
  created_at             DateTime           @default(now()) @db.Timestamptz
  updated_at             DateTime           @updatedAt @db.Timestamptz

  @@index([status, trial_ends_at])
  @@index([current_period_end])
  @@map("subscriptions")
}

model Payment {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String        @db.Uuid
  user                     User          @relation(fields: [user_id], references: [id], onDelete: Restrict)
  stripe_invoice_id        String?       @unique
  stripe_payment_intent_id String?
  amount_cents             Int
  currency                 String        @default("usd")
  status                   PaymentStatus
  paid_at                  DateTime?     @db.Timestamptz
  failure_code             String?
  created_at               DateTime      @default(now()) @db.Timestamptz
  updated_at               DateTime      @updatedAt @db.Timestamptz

  @@index([user_id, created_at(sort: Desc)])
  @@map("payments")
}

// Existence of the row = event already handled (webhook idempotency).
model StripeWebhookEvent {
  stripe_event_id String    @id
  type            String
  payload         Json
  processed_at    DateTime? @db.Timestamptz
  attempts        Int       @default(0)
  created_at      DateTime  @default(now()) @db.Timestamptz

  @@map("stripe_webhook_events")
}

model Report {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id String           @db.Uuid
  reporter    User             @relation("Reporter", fields: [reporter_id], references: [id], onDelete: Restrict)
  target_type ReportTargetType
  target_id   String           @db.Uuid
  reason      ReportReason
  note        String?
  status      ReportStatus     @default(open)
  handled_by  String?          @db.Uuid
  handler     User?            @relation("ReportHandler", fields: [handled_by], references: [id], onDelete: Restrict)
  handled_at  DateTime?        @db.Timestamptz
  created_at  DateTime         @default(now()) @db.Timestamptz
  updated_at  DateTime         @updatedAt @db.Timestamptz

  actions ModerationAction[]

  @@index([status, created_at])
  @@map("reports")
}

model ModerationAction {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id   String?              @db.Uuid
  report      Report?              @relation(fields: [report_id], references: [id], onDelete: Restrict)
  admin_id    String               @db.Uuid
  admin       User                 @relation("ModerationAdmin", fields: [admin_id], references: [id], onDelete: Restrict)
  target_type ReportTargetType
  target_id   String               @db.Uuid
  action      ModerationActionType
  reason      String?
  created_at  DateTime             @default(now()) @db.Timestamptz

  @@index([target_type, target_id])
  @@map("moderation_actions")
}

model AdminProfile {
  user_id    String    @id @db.Uuid
  user       User      @relation(fields: [user_id], references: [id], onDelete: Restrict)
  admin_role AdminRole
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz

  @@map("admin_profiles")
}

// Append-only (§6.2).
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id      String   @db.Uuid
  admin         User     @relation("AuditAdmin", fields: [admin_id], references: [id], onDelete: Restrict)
  action        String
  target_type   String
  target_id     String?  @db.Uuid
  before        Json?
  after         Json?
  ip            String?
  created_at    DateTime @default(now()) @db.Timestamptz
  // Explicit write-shard 0..15 (docs/02 §1.1 hot-spot rule): STORED
  // computed column, indexed as (created_shard, created_at). Replaces a
  // USING HASH index, which crashes Prisma's introspection. Read-only.
  created_shard Int      @default(dbgenerated("mod(fnv32(id::STRING), 16)::INT2")) @db.Int2

  @@index([admin_id, created_at(sort: Desc)])
  @@index([created_shard, created_at], map: "audit_log_created_at_idx")
  @@map("audit_log")
}

model DataAccessRequest {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_type     DataRequestType
  reference_number String
  agency           String
  received_at      DateTime          @db.Timestamptz
  scope            String
  handled_by       String            @db.Uuid
  handler          User              @relation("DataRequestHandler", fields: [handled_by], references: [id], onDelete: Restrict)
  status           DataRequestStatus
  closed_at        DateTime?         @db.Timestamptz
  notes            String?
  created_at       DateTime          @default(now()) @db.Timestamptz
  updated_at       DateTime          @updatedAt @db.Timestamptz

  access_log DataAccessLog[]

  @@map("data_access_requests")
}

// Append-only (§6.2).
model DataAccessLog {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id  String            @db.Uuid
  request     DataAccessRequest @relation(fields: [request_id], references: [id], onDelete: Restrict)
  admin_id    String            @db.Uuid
  admin       User              @relation("DataAccessAdmin", fields: [admin_id], references: [id], onDelete: Restrict)
  entity_type String
  entity_id   String            @db.Uuid
  accessed_at DateTime          @default(now()) @db.Timestamptz

  @@index([request_id])
  @@map("data_access_log")
}
