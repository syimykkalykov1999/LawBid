NODE_ENV=test
PORT=3000
DATABASE_URL=postgresql://root@localhost:26257/lawbid_test?sslmode=disable
REDIS_URL=redis://localhost:6379

# --- Stage 1.4: auth backend (test defaults — mock providers, fixed OTP) ---
JWT_KEYS=test1:test_secret_at_least_32_characters_long_aaaa
JWT_ACTIVE_KID=test1
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=60
REAUTH_TOKEN_TTL_SECONDS=300
REFRESH_ROTATION_GRACE_SECONDS=10

OTP_CODE_SECRET=test_otp_code_secret_at_least_32_chars_bbbb
OTP_KEY_PEPPER=test_otp_key_pepper_at_least_32_chars_cccc
AUTH_EVENT_PEPPER=test_auth_event_pepper_at_least_32_chars_dddd
OTP_CODE_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
OTP_RATE_LIMIT_PER_IDENTIFIER_PER_HOUR=5
OTP_RATE_LIMIT_PER_IP_PER_HOUR=10
AUTH_OTP_VERIFY_LIMIT_PER_HOUR=10
AUTH_SOCIAL_LIMIT_PER_IP_PER_HOUR=20
AUTH_REFRESH_LIMIT_PER_IP_PER_HOUR=60
OTP_DEV_FIXED_CODE=true

SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025

GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_IDS=

FEATURE_ATTESTATION=false
ADMIN_TOTP_ENC_KEY=test_admin_totp_enc_key_at_least_32_chars_dddd
