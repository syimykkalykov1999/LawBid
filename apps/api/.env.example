NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://root@localhost:26257/lawbid?sslmode=disable
REDIS_URL=redis://localhost:6379
SUBSCRIPTION_PAST_DUE_GRACE_DAYS=3
# Background jobs (src/jobs, BullMQ `cron` queue). true: the API process
# also runs the scheduler + worker; set false on the API service once the
# dedicated worker (node dist/src/worker.js) runs.
JOBS_ENABLED=true
# Monthly disposable-domain refresh source (docs/02 §3.3).
DISPOSABLE_DOMAINS_URL=https://raw.githubusercontent.com/disposable-email-domains/disposable-email-domains/master/disposable_email_blocklist.conf

# --- Stage 1.4: auth backend ---
# Generate real random secrets for local dev too (these placeholders are
# 32+ chars only to satisfy envSchema's length check, not "real enough").
JWT_KEYS=dev1:CHANGE_ME_32_CHARS_MINIMUM_SECRET_A
JWT_ACTIVE_KID=dev1
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=60
REAUTH_TOKEN_TTL_SECONDS=300
REFRESH_ROTATION_GRACE_SECONDS=10

OTP_CODE_SECRET=CHANGE_ME_32_CHARS_MINIMUM_SECRET_B
OTP_KEY_PEPPER=CHANGE_ME_32_CHARS_MINIMUM_SECRET_C
AUTH_EVENT_PEPPER=CHANGE_ME_32_CHARS_MINIMUM_SECRET_D
OTP_CODE_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
OTP_RATE_LIMIT_PER_IDENTIFIER_PER_HOUR=5
OTP_RATE_LIMIT_PER_IP_PER_HOUR=10
AUTH_OTP_VERIFY_LIMIT_PER_HOUR=10
AUTH_SOCIAL_LIMIT_PER_IP_PER_HOUR=20
AUTH_REFRESH_LIMIT_PER_IP_PER_HOUR=60
AUTH_REFRESH_LIMIT_PER_SESSION_PER_HOUR=30
# Universal-link base for magic links in emails (docs/01 §10.2 E). Optional.
APP_LINK_BASE_URL=
# true only in NODE_ENV=development or NODE_ENV=test — envSchema refuses
# to boot with this true in staging/production.
OTP_DEV_FIXED_CODE=true

# =====================================================================
# External credentials — step-by-step guide: docs/KEYS_SETUP.md
# Leave empty until you have the real value. NEVER commit real values:
# .env is gitignored; staging/production read AWS Secrets Manager.
# Formats are validated at boot (src/config/env.schema.ts).
# =====================================================================

# --- SMS (Twilio Messages API) ---
# auto (default) = twilio as soon as SID + token + (from number OR
# messaging service) are all set, otherwise mock. mock | twilio force it.
# staging/production never run on mock: missing creds stop the boot.
SMS_PROVIDER=auto
# Twilio Console → Account Info. Format: AC + 32 hex chars.
TWILIO_ACCOUNT_SID=
# Twilio Console → Account Info → Auth Token. 32 hex chars.
TWILIO_AUTH_TOKEN=
# Sender, E.164 (+15551234567). Or use the Messaging Service below.
TWILIO_FROM_NUMBER=
# Optional instead of FROM_NUMBER (US A2P 10DLC sender pool). MG + 32 hex.
TWILIO_MESSAGING_SERVICE_SID=
# Android SMS Retriever app hash (11 chars) of the release build; enables
# one-tap OTP autofill on Android. Leave empty until the release key exists.
SMS_ANDROID_APP_HASH=

# --- Email (AWS SES) ---
# auto (default) = ses as soon as SES_REGION + SES_FROM_ADDRESS are set.
EMAIL_PROVIDER=auto
# e.g. us-east-1 (region where the sending domain is verified)
SES_REGION=
# "no-reply@your-domain" or "LawBid <no-reply@your-domain>"; the domain
# must be verified in SES.
SES_FROM_ADDRESS=
# Optional. Only for local dev without ~/.aws; deployed envs use an IAM
# role. Both or neither. (Also read by the AWS SDK for S3 later.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Mailhog for the mock email provider (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Social login ---
# Comma-separated; each ends with .apps.googleusercontent.com. Put the
# WEB (server) client id AND the iOS client id here. Empty = Google
# sign-in answers AUTH_PROVIDER_DISABLED.
GOOGLE_CLIENT_IDS=
# Comma-separated iOS bundle ids (com.lawbid.lawbid). Empty = Apple
# sign-in answers AUTH_PROVIDER_DISABLED.
APPLE_BUNDLE_IDS=
# 10 chars, Apple Developer → Membership. Reserved (token revocation).
APPLE_TEAM_ID=

# --- Seed (npx prisma db seed) ---
# Email of the first admin user; no admin is created while empty.
SEED_ADMIN_EMAIL=

# --- Reserved for later stages (validated now, not used yet) ---
# Stripe (stage 6.7). sk_test_… outside production, sk_live_… only in
# production. Publishable key (pk_…) goes to the mobile app config.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# S3 / MinIO (file uploads). Local MinIO from docker-compose.yml:
#   S3_ENDPOINT=http://localhost:9000  S3_ACCESS_KEY_ID=lawbid
#   S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD from docker-compose.yml>
# On AWS: S3_ENDPOINT and S3_*_KEY empty (IAM role).
S3_REGION=
S3_ENDPOINT=
S3_BUCKET_DOCUMENTS=
S3_BUCKET_MEDIA=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Antivirus for uploads (docs/03 stage 3.2): clamd TCP. Empty in
# development/test = built-in EICAR-only dev scanner. PRODUCTION MUST SET
# IT: without a scanner uploads stay scan_status=pending and can never be
# attached (avatar, verification documents, post photos).
CLAMAV_HOST=
CLAMAV_PORT=3310
# POST /files/presign per user per hour.
FILES_PRESIGN_LIMIT_PER_USER_PER_HOUR=60
# Firebase Cloud Messaging (push stage): fields of the service-account
# JSON (Firebase Console → Project settings → Service accounts). All three
# or none. Keep "\n" escapes in the private key, wrap it in double quotes.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

FEATURE_ATTESTATION=false

# --- Cost protection (docs/COST_PROTECTION.md) ---
# Fallback caps; live values come from app_config budget.<provider>.*
BUDGET_SMS_PER_MINUTE_MAX=30
BUDGET_SMS_DAILY_MAX=300
BUDGET_SMS_MONTHLY_MAX=5000
BUDGET_EMAIL_PER_MINUTE_MAX=100
BUDGET_EMAIL_DAILY_MAX=2000
BUDGET_EMAIL_MONTHLY_MAX=30000
BUDGET_ID_CHECK_PER_MINUTE_MAX=5
BUDGET_ID_CHECK_DAILY_MAX=20
BUDGET_ID_CHECK_MONTHLY_MAX=200
BUDGET_STORAGE_PER_MINUTE_MAX=120
BUDGET_STORAGE_DAILY_MAX=5000
BUDGET_STORAGE_MONTHLY_MAX=100000
# Fallback for app_config sms.allowed_country_codes
SMS_ALLOWED_COUNTRY_CODES=US
OTP_RATE_LIMIT_PER_DEVICE_PER_HOUR=10
CONTACT_OTP_LIMIT_PER_USER_PER_HOUR=3
CONTACT_OTP_LIMIT_PER_USER_PER_DAY=10
# 0 locally; 1 in staging/production behind exactly one AWS ALB.
TRUST_PROXY_HOPS=0

# docs/06 §2.1 (stage 6.2): admin TOTP secret encryption key (>=32 chars)
ADMIN_TOTP_ENC_KEY=
ADMIN_PANEL_URL=http://localhost:3001
