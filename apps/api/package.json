{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "seed:demo": "ts-node --transpile-only prisma/seed-demo.ts",
    "seed:perf": "ts-node --transpile-only prisma/seed-perf.ts",
    "seed:economy": "ts-node --transpile-only scripts/seed-economy.ts",
    "seed:i18n": "ts-node --transpile-only prisma/seed.ts --i18n-only",
    "test": "jest",
    "test:fast": "jest --maxWorkers=50%",
    "test:changed": "jest --onlyChanged --maxWorkers=50%",
    "test:related": "jest --findRelatedTests --maxWorkers=50%",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint:fast": "eslint \"{src,apps,libs,test}/**/*.ts\" --cache --cache-location .cache/eslint/ --cache-strategy content",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:sharded": "node scripts/run-e2e-sharded.mjs",
    "test:e2e:two-db": "node scripts/run-e2e-two-db.mjs",
    "db:erd": "ts-node --transpile-only scripts/generate-erd.ts",
    "db:erd:fast": "bash ../../scripts/dev/skip-if-unchanged.sh api-erd apps/api/prisma/schema.prisma apps/api/scripts/generate-erd.ts -- docs/db/ERD.md -- npm run db:erd --workspace apps/api",
    "openapi:export": "nest build && node dist/src/openapi/export-openapi.js",
    "admin:set-credentials": "node dist/src/cli/set-admin-credentials.js",
    "i18n:import": "node dist/src/cli/import-translations.js",
    "flags:sync": "ts-node --transpile-only scripts/sync-flag-defaults.ts",
    "counters:reconcile": "ts-node --transpile-only scripts/counters-reconcile.ts",
    "media:migrate-r2": "ts-node --transpile-only scripts/migrate-public-media-to-r2.ts",
    "media:avatar-previews": "ts-node --transpile-only scripts/backfill-avatar-previews.ts"
  },
  "dependencies": {
    "@aws-sdk/client-application-auto-scaling": "^3.1153.0",
    "@aws-sdk/client-budgets": "^3.1153.0",
    "@aws-sdk/client-cloudwatch": "^3.1153.0",
    "@aws-sdk/client-ecs": "^3.1153.0",
    "@aws-sdk/client-cost-explorer": "^3.1153.0",
    "@aws-sdk/client-elasticache": "^3.1153.0",
    "@aws-sdk/client-kms": "^3.1153.0",
    "@aws-sdk/client-rds": "^3.1153.0",
    "@aws-sdk/client-rekognition": "^3.1153.0",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/client-ses": "^3.1153.0",
    "@aws-sdk/client-sns": "^3.1153.0",
    "@aws-sdk/client-ssm": "^3.1152.0",
    "@aws-sdk/cloudfront-signer": "^3.1153.0",
    "@aws-sdk/s3-presigned-post": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.6",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "6.19.3",
    "@sentry/nestjs": "^11.8.0",
    "@simplewebauthn/server": "^14.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@types/archiver": "^5.3.4",
    "archiver": "^5.3.2",
    "bullmq": "^6.3.17",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "heic-decode": "^2.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.15",
    "livekit-server-sdk": "^2.19.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.7",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pino-http": "^11.0.0",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "stripe": "^22.6.2",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/heic-decode": "^2.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.0.0",
    "autocannon": "^8.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "json-summary",
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 57,
        "branches": 45,
        "functions": 33,
        "lines": 58
      }
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(@nestjs/jwt|jose)/)"
    ],
    "workerIdleMemoryLimit": "1GB"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  }
}
