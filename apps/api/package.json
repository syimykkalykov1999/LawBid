    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nestjs": "^11.14.0",
    "@simplewebauthn/server": "^14.1.0",
    "@smithy/signature-v4": "^5.7.4",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "archiver": "^8.0.0",
    "bidi-js": "^1.1.0",
    "blurhash": "2.0.5",
    "bullmq": "^6.7.7",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.5.1",
    "google-auth-library": "^11.3.4",
    "heic-decode": "^2.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "libphonenumber-js": "^1.13.16",
    "livekit-server-sdk": "^2.20.0",
    "nestjs-pino": "^5.3.2",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pg-logical-replication": "2.6.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "safe-stable-stringify": "^3.0.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "stripe": "^23.1.0",
    "twilio": "^6.3.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.5.1",
    "@prisma/generator-helper": "7.10.1",
    "@types/archiver": "^8.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/heic-decode": "^2.0.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "^7.0.0",
    "autocannon": "^9.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "jest": "^30.4.0",
    "jsqr": "1.4.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!generated/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "json-summary",
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 57,
        "branches": 45,
        "functions": 33,
        "lines": 58
      }
    },
    "testEnvironment": "node",
    "workerIdleMemoryLimit": "1GB",
    "setupFiles": [
      "<rootDir>/../test/setup/fast-kdf.ts"
    ]
  },
  "engines": {
    "node": ">=26.13.1 <27"
  }
}
