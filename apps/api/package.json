{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "seed:demo": "ts-node --transpile-only prisma/seed-demo.ts",
    "seed:perf": "ts-node --transpile-only prisma/seed-perf.ts",
    "seed:economy": "ts-node --transpile-only scripts/seed-economy.ts",
    "seed:i18n": "ts-node --transpile-only prisma/seed.ts --i18n-only",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest",
    "test:fast": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --maxWorkers=50%",
    "test:changed": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --onlyChanged --maxWorkers=50%",
    "test:related": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --findRelatedTests --maxWorkers=50%",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint:fast": "eslint \"{src,apps,libs,test}/**/*.ts\" --cache --cache-location .cache/eslint/ --cache-strategy content",
    "test:watch": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --watch",
    "test:cov": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --config ./test/jest-e2e.json",
    "test:e2e:sharded": "node scripts/run-e2e-sharded.mjs",
    "test:e2e:two-db": "node scripts/run-e2e-two-db.mjs",
    "shard:move": "ts-node --transpile-only scripts/shard-move.ts",
    "arch:baseline": "ts-node --transpile-only scripts/arch-baseline.ts",
    "lists:sort": "node scripts/sort-lists.mjs",
    "db:erd": "ts-node --transpile-only scripts/generate-erd.ts",
    "db:erd:fast": "bash ../../scripts/dev/skip-if-unchanged.sh api-erd apps/api/prisma/schema.prisma apps/api/scripts/generate-erd.ts -- docs/db/ERD.md -- npm run db:erd --workspace apps/api",
    "openapi:export": "nest build && node dist/src/openapi/export-openapi.js",
    "privacy:reapply-erasures": "node dist/src/cli/reapply-erasures.js",
    "breach:affected": "node dist/src/cli/breach-affected.js",
    "admin:set-credentials": "node dist/src/cli/set-admin-credentials.js",
    "i18n:import": "node dist/src/cli/import-translations.js",
    "purge:test-data": "node dist/src/cli/purge-test-data.js",
    "avatars:backfill": "node dist/src/cli/backfill-avatar-variants.js",
    "signatures:backfill": "node dist/src/cli/backfill-signature-images.js",
    "flags:sync": "ts-node --transpile-only scripts/sync-flag-defaults.ts",
    "counters:reconcile": "ts-node --transpile-only scripts/counters-reconcile.ts",
    "media:migrate-r2": "ts-node --transpile-only scripts/migrate-public-media-to-r2.ts",
    "media:avatar-previews": "ts-node --transpile-only scripts/backfill-avatar-previews.ts"
  },
  "dependencies": {
    "@aws-sdk/client-application-auto-scaling": "^3.1171.0",
