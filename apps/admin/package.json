{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "description": "LawBid admin panel (docs/06 §2) — Next.js App Router + TanStack Query; API client types generated from packages/api-contract/openapi.json.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "generate": "openapi-typescript ../../packages/api-contract/openapi.json -o src/lib/api/schema.d.ts",
    "typecheck": "npm run generate && tsc --noEmit",
    "generate:fast": "bash ../../scripts/dev/skip-if-unchanged.sh admin-openapi-types packages/api-contract/openapi.json -- apps/admin/src/lib/api/schema.d.ts -- npm run generate --workspace apps/admin",
    "typecheck:fast": "npm run generate:fast && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "guides:check": "node ../../scripts/guides-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/browser": "^10.76.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/query-async-storage-persister": "^5.106.1",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-persist-client": "^5.106.1",
    "@tanstack/react-virtual": "^3.14.26",
    "blurhash": "^2.0.5",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "motion": "^13.5.0",
    "next": "^16.4.5",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.4.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
