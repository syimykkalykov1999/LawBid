# Base URL of apps/api as reachable from the Next.js server (not the browser).
API_BASE_URL=http://localhost:3000/api/v1
# Set in production: the cookie is only sent over HTTPS.
COOKIE_SECURE=false
# Audit #8: extra connect-src origins of the admin CSP (space separated) —
# the S3 buckets presigned uploads POST to and the media CDN. Set by
# Terraform in production; locally `next dev` allows http: anyway.
ADMIN_CONNECT_SRC=
