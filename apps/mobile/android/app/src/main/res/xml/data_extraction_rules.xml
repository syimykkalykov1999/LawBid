<?xml version="1.0" encoding="utf-8"?>
<!-- Owner 2026-10-22 (checklist §27): Android 12+ (android:dataExtractionRules).
     Same intent as backup_rules.xml: no tokens, no Drift stores, no caches
     in a cloud backup or a device-to-device transfer. The whole app data
     is excluded from both; a fresh install signs in again and re-syncs
     from the server (the refresh token is bound to the device anyway). -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="root" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="root" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
