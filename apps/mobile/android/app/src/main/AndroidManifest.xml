<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Biometric reauth (Phase 4 of the auth networking work,
         docs/CHANGELOG.md): required by local_auth for
         BiometricPrompt/fingerprint on Android. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- docs/03 stage 3.8 verification wizard: in-app camera for license/ID
         photos and the selfie. Android shows no custom prompt text; the
         app explains a refusal in-app (verification.camera.denied.* keys).
         The camera is optional hardware: devices without one can still
         upload license/ID files from storage. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- OQ-040: voice messages; in-app calls. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- android:label comes from the flavor's resValue app_name
         (android/app/build.gradle.kts): "LawBid Dev" / "LawBid Staging" /
         "LawBid" (p12 leaf-1.4). -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Deep links are handled by app_links + DeepLinkController
                 (lib/core/deeplinks), not by Flutter's built-in router
                 deep linking, so a magic sign-in link can verify its code
                 instead of only opening a route. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Custom scheme (docs/01_FOUNDATION_AUTH.md §10.2 E/F magic
                 link): lawbid://auth/email-code?email=…&code=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lawbid" />
            </intent-filter>
            <!-- Android App Links (docs/01_FOUNDATION_AUTH.md §12):
                 https://lawbid.app/case/:id, /lawyer/:username, /post/:id and
                 the magic sign-in link /auth/email-code. Verified against
                 https://<deepLinkHost>/.well-known/assetlinks.json (template:
                 docs/deeplinks/assetlinks.json). The host is the Gradle
                 property lawbid.deepLinkHost (default lawbid.app). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${deepLinkHost}" />
                <data android:pathPrefix="/case/" />
                <data android:pathPrefix="/lawyer/" />
                <data android:pathPrefix="/post/" />
                <data android:path="/auth/email-code" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher (package visibility, API 30+): the update prompt
             opens the store listing (lib/core/app_update). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>
</manifest>
