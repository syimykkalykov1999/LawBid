# docs/06 §7.4 — Fastlane for the store lanes (run from apps/mobile/android
# or apps/mobile/ios). `bundle install` once; CI uses `bundle exec fastlane`.
source "https://rubygems.org"

gem "fastlane", "~> 2.228"

# flutter build ipa runs `pod` inside `bundle exec fastlane`; without it here bundler hides CocoaPods ("installed but broken").
gem "cocoapods"
