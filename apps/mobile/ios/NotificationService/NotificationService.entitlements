<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Owner 2026-10-26: the sender's photo on a chat banner
	     (Communication Notifications). -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<!-- D1-31 (13.11): the app's App Group (group.<app bundle id>), where
	     the app keeps the phone-book names of LawBid contacts.
	     LAWBID_APP_GROUP is set per flavor in NotificationService.xcconfig
	     (this target's own bundle id ends in .NotificationService). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(LAWBID_APP_GROUP)</string>
	</array>
</dict>
</plist>
