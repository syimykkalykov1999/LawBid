<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links (docs/01_FOUNDATION_AUTH.md §12). DEEP_LINK_HOST is
	     a build setting (Flutter/Common.xcconfig, default lawbid.dev); the
	     host must serve docs/deeplinks/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(DEEP_LINK_HOST)</string>
		<!-- Owner 2026-10-22 (passkeys): iOS lets the app create and use
		     passkeys for the domain; the domain's
		     apple-app-site-association file lists the app under
		     "webcredentials" (scripts/seo/well-known.mjs). -->
		<string>webcredentials:$(DEEP_LINK_HOST)</string>
	</array>
	<!-- Push (store release 2026-10-06): without aps-environment iOS never
	     hands the app an APNs token, so FCM has nothing to deliver to.
	     "development" here; the App Store distribution profile signs the
	     archive as "production" on export. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Incoming calls are sent with interruption-level time-sensitive
	     (api notifications/push/fcm-push.sender.ts) so they ring through
	     Focus; iOS drops the level to "active" without this entitlement. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Owner 2026-10-26: chat pushes show the sender's round photo
	     (Communication Notifications, NotificationService extension). -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
</dict>
</plist>
