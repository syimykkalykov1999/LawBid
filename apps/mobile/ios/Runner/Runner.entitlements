<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links (docs/01_FOUNDATION_AUTH.md §12). DEEP_LINK_HOST is
	     a build setting (Flutter/Common.xcconfig, default lawbid.dev); the
	     host must serve docs/deeplinks/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(DEEP_LINK_HOST)</string>
		<!-- Owner 2026-10-22 (passkeys): iOS lets the app create and use
		     passkeys for the domain; the domain's
		     apple-app-site-association file lists the app under
		     "webcredentials" (scripts/seo/well-known.mjs). -->
		<string>webcredentials:$(DEEP_LINK_HOST)</string>
	</array>
	<!-- Push (store release 2026-10-06): without aps-environment iOS never
	     hands the app an APNs token, so FCM has nothing to deliver to.
	     "development" here; the App Store distribution profile signs the
	     archive as "production" on export. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Incoming calls are sent with interruption-level time-sensitive
	     (api notifications/push/fcm-push.sender.ts) so they ring through
	     Focus; iOS drops the level to "active" without this entitlement. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Owner 2026-10-26: chat pushes show the sender's round photo
	     (Communication Notifications, NotificationService extension). -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<!-- 2026-11-08: Firebase App Check on iPhone uses App Attest
	     (core/security/app_check.dart). Without this entitlement iOS refuses
	     the attestation, the app never gets a token and every prod request
	     came in as `missing` (docs/runbooks/APP_CHECK.md). "production" as
	     Firebase asks; App Store / TestFlight builds always use production. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<!-- D1-31 (13.11): the App Group shared with the NotificationService
	     extension — the names saved in the phone book for LawBid contacts
	     (AppDelegate setContactNames → NotificationService ChatContactNames).
	     Without it on BOTH targets each process got its own private store
	     and the saved name never showed. group.<app bundle id>; registered
	     in Apple Developer (docs/runbooks/IOS_CHAT_NOTIFICATIONS.md). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
