<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App privacy manifest (store release 2026-10-06). Must match the App
     Privacy answers in App Store Connect: docs/store/RELEASE_CHECKLIST.md
     §App Privacy. No tracking, no ads, no third-party analytics; every
     data type is linked to the account and used only to run the app.
     OtherDataTypes = attorney license / ID document images and the
     verification selfie. Plugins (Flutter, Firebase, Stripe, …) ship
     their own manifests for the APIs they call. -->
