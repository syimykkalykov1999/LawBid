// Copy to Secrets.xcconfig (same folder, gitignored) and fill in.
// Guide: docs/KEYS_SETUP.md. Included by Common.xcconfig (every flavor configuration).

// Google Cloud Console → APIs & Services → Credentials → your iOS OAuth
// client → "iOS URL scheme" (the client id reversed), e.g.
// com.googleusercontent.apps.123456789012-abcdefg
GOOGLE_REVERSED_CLIENT_ID =

// Optional: Apple Developer → Membership → Team ID (10 chars). Lets
// Xcode sign without picking the team by hand in Signing & Capabilities.
// DEVELOPMENT_TEAM =

// Optional: universal-link domain if not lawbid.app (docs/deeplinks/README.md).
// DEEP_LINK_HOST = lawbid.app
