# docs/06 §7.4 — iOS lanes. Signing certificates/profiles come from the
# App Store Connect API key; the certificate and profile are installed by
# the workflow from secrets and Xcode signs automatically
# (ExportOptions.plist: signingStyle automatic). The owner may switch to
# `match` before the first TestFlight upload (docs/06 §11.2).
default_platform(:ios)

platform :ios do
  desc "Build the prod IPA (release, scheme prod). Env: BUILD_NUMBER (optional; unset = automatic), DART_DEFINES_FILE"
  lane :build do |options|
    flavor = options[:flavor] || "prod"
    # Owner 2026-10-22 (audit #11): the Dart code is obfuscated and its
    # symbols kept in build/symbols/ios (never shipped) so Sentry can turn
    # crash stacks back into readable ones.
    sh("cd ../.. && flutter build ipa --release --flavor #{flavor} -t lib/main_#{flavor}.dart " \
       "--obfuscate --split-debug-info=build/symbols/ios " \
       "#{ENV['BUILD_NUMBER'] ? "--build-number=#{ENV['BUILD_NUMBER']} " : ''}" \
       "--dart-define-from-file=#{ENV.fetch('DART_DEFINES_FILE', "config/#{flavor}.json")} " \
       "--export-options-plist=ios/ExportOptions.plist")
    sentry_symbols if flavor == "prod"
  end

  desc "Upload the last prod build's symbols to Sentry (project lawbid-mobile): " \
       "the dSYMs of the archive (native frames) and the Dart symbols of the " \
       "obfuscated build, via sentry_dart_plugin (pubspec.yaml `sentry:`). Needs " \
       "SENTRY_AUTH_TOKEN and SENTRY_ORG; without them it warns and skips — " \
       "never fails the release."
  lane :sentry_symbols do
    mobile = File.expand_path("../..", __dir__)
    if ENV["SENTRY_AUTH_TOKEN"].to_s.empty? || ENV["SENTRY_ORG"].to_s.empty?
      UI.important("SENTRY_AUTH_TOKEN / SENTRY_ORG not set - symbols not uploaded (docs/runbooks/STORE_RELEASE.md §6)")
      next
    end
    sh("cd \"#{mobile}\" && dart run sentry_dart_plugin")
  end

  desc "Upload the prod IPA to TestFlight (closed beta, docs/06 §11.2). Owner decides when to run."
  lane :testflight_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
    )
    build(flavor: "prod")
    upload_to_testflight(
      api_key: api_key,
      # `flutter build ipa` names the file after the product; take the one it wrote.
      ipa: Dir["../build/ios/ipa/*.ipa"].first,
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("RELEASE_NOTES", ""),
    )
  end

  desc "Upload the store listing in every language (fastlane/metadata/<locale>/*.txt). " \
       "No build, no screenshots, no submission. Auth: App Store Connect API key " \
       "(ASC_KEY_ID/ASC_ISSUER_ID/ASC_KEY_CONTENT) or, on the Mac, the Apple ID in FASTLANE_USER."
  lane :metadata do
    api_key = if ENV["ASC_KEY_ID"]
      app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_content: ENV.fetch("ASC_KEY_CONTENT"),
        is_key_content_base64: true,
      )
    end
    deliver(
      api_key: api_key,
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end

  # Owner 2026-10-25: App Store phased release (docs/runbooks/mobile-staged-rollout.md).
  # Submits a build already in App Store Connect (TestFlight) for review with
  # phased release ON: Apple raises the share of auto-updating users over 7 days
  # (1, 2, 5, 10, 20, 50, 100 %) and releases it automatically once approved.
  # Pausing / resuming / releasing to everyone is done in App Store Connect
  # (fastlane has no action for it): see the runbook. dry_run=true only checks
  # the credentials and the build, nothing is submitted.
  desc "Submit a TestFlight build for review with phased release. Options: build_number, dry_run. Needs the ASC_* key."
  lane :release_phased do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
    )
    build_number = options[:build_number].to_s
    UI.user_error!("build_number is required (the number shown in TestFlight)") if build_number.empty?
    if options[:dry_run].to_s == "true"
      UI.success("dry run: would submit build #{build_number} with phased release")
      next
    end
    deliver(
      api_key: api_key,
      build_number: build_number,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      phased_release: true,
      force: true,
      submission_information: { add_id_info_uses_idfa: false },
    )
  end
end
