# docs/06 §7.4 — iOS lanes. Signing: Xcode cloud-managed signing through the
# App Store Connect API key (ExportOptions.plist: signingStyle automatic).
# Since 2026-11-02 .github/workflows/mobile-release.yml and mobile-testers.yml
# build with `flutter build ios --no-codesign` + `xcodebuild archive/export`
# and upload with `fastlane run upload_to_testflight`; the `build` and
# `testflight_upload` lanes below are for running the same release by hand.
default_platform(:ios)

# Store release in GitHub Actions (owner 2026-11-09, .github/workflows/store-release.yml).
def asc_api_key
  missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT].select { |v| ENV[v].to_s.empty? }
  UI.user_error!("App Store Connect API key secrets missing: #{missing.join(', ')} (environment `release`, docs/runbooks/mobile-testers-ci.md)") unless missing.empty?
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: true,
  )
end

# Release notes in every language: fastlane/metadata/<locale>/release_notes.txt, beside the
# 42-locale listing. en-US is written from RELEASE_NOTES when it is missing; a locale without
# its own file gets the en-US text (App Store requires "What's New" in every listed language).
def ensure_release_notes!
  root = File.expand_path("metadata", __dir__)
  en = File.join(root, "en-US", "release_notes.txt")
  unless File.exist?(en)
    notes = ENV["RELEASE_NOTES"].to_s.strip
    File.write(en, (notes.empty? ? "Improvements and fixes." : notes)[0, 4000])
  end
  text = File.read(en)
  Dir[File.join(root, "*")].select { |d| File.directory?(d) && File.exist?(File.join(d, "name.txt")) }.each do |d|
    f = File.join(d, "release_notes.txt")
    File.write(f, text) unless File.exist?(f)
  end
end

# The version in phased release (the one live or waiting for its 7-day ramp).
def phased_release_of_live_version
  app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
  UI.user_error!("app not found in App Store Connect") if app.nil?
  version = app.get_live_app_store_version
  UI.user_error!("no live App Store version") if version.nil?
  phased = version.fetch_app_store_version_phased_release
  UI.user_error!("version #{version.version_string} has no phased release") if phased.nil?
  [version, phased]
end

platform :ios do
  desc "Build the prod IPA (release, scheme prod). Env: BUILD_NUMBER (optional; unset = automatic), DART_DEFINES_FILE"
  lane :build do |options|
    flavor = options[:flavor] || "prod"
    # Owner 2026-10-22 (audit #11): the Dart code is obfuscated and its
    # symbols kept in build/symbols/ios (never shipped) so Sentry can turn
    # crash stacks back into readable ones.
    sh("cd ../.. && flutter build ipa --release --flavor #{flavor} -t lib/main_#{flavor}.dart " \
       "--obfuscate --split-debug-info=build/symbols/ios " \
       "#{ENV['BUILD_NUMBER'] ? "--build-number=#{ENV['BUILD_NUMBER']} " : ''}" \
       "--dart-define-from-file=#{ENV.fetch('DART_DEFINES_FILE', "config/#{flavor}.json")} " \
       "--export-options-plist=ios/ExportOptions.plist")
    sentry_symbols if flavor == "prod"
  end

  desc "Upload the last prod build's symbols to Sentry (project lawbid-mobile): " \
       "the dSYMs of the archive (native frames) and the Dart symbols of the " \
       "obfuscated build, via sentry_dart_plugin (pubspec.yaml `sentry:`). Needs " \
       "SENTRY_AUTH_TOKEN and SENTRY_ORG; without them it warns and skips — " \
       "never fails the release."
  lane :sentry_symbols do
    mobile = File.expand_path("../..", __dir__)
    if ENV["SENTRY_AUTH_TOKEN"].to_s.empty? || ENV["SENTRY_ORG"].to_s.empty?
      UI.important("SENTRY_AUTH_TOKEN / SENTRY_ORG not set - symbols not uploaded (docs/runbooks/STORE_RELEASE.md §6)")
      next
    end
    sh("cd \"#{mobile}\" && dart run sentry_dart_plugin")
  end

  desc "Upload the prod IPA to TestFlight (closed beta, docs/06 §11.2). Owner decides when to run."
  lane :testflight_upload do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
    )
    build(flavor: "prod")
    upload_to_testflight(
      api_key: api_key,
      # `flutter build ipa` names the file after the product; take the one it wrote.
      ipa: Dir["../build/ios/ipa/*.ipa"].first,
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("RELEASE_NOTES", ""),
    )
  end

  desc "S11-12: submit the TestFlight build to App Store review with a 7-day phased release " \
       "(1-2-5-10-20-50-100 %). Pausing it later: App Store Connect -> the version -> Pause phased release."
  lane :release_phased do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
    )
    deliver(
      api_key: api_key,
      skip_binary_upload: true, skip_screenshots: true, skip_metadata: true,
      submit_for_review: true, automatic_release: true, phased_release: true,
      force: true,
    )
  end

  # --- store-release.yml: beta -> release (phased) -> rollout 100, guard + halt ----------------
  desc "beta: build the prod IPA and upload it to TestFlight (alias of `testflight_upload`). " \
       "In GitHub Actions the Mobile release workflow builds and uploads (cloud-managed signing)."
  lane :beta do
    testflight_upload
  end

  desc "release: submit the newest TestFlight build for review with the release notes of every " \
       "language and a 7-day phased release (1-2-5-10-20-50-100 %), released automatically after review."
  lane :release do
    api_key = asc_api_key
    ensure_release_notes!
    deliver(
      api_key: api_key,
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true, skip_screenshots: true,
      skip_metadata: false, skip_app_version_update: false,
      submit_for_review: true, automatic_release: true, phased_release: true,
      run_precheck_before_submit: false,
      submission_information: { add_id_info_uses_idfa: false },
      force: true,
    )
  end

  desc "rollout: percent:100 releases the phased version to everyone now; percent:50 resumes a paused ramp " \
       "(Apple sets the daily steps itself: 1-2-5-10-20-50-100 %)."
  lane :rollout do |options|
    asc_api_key
    percent = (options[:percent] || "100").to_s
    version, phased = phased_release_of_live_version
    case percent
    when "100" then phased.complete
    when "50" then phased.resume
    else UI.user_error!("percent must be 50 (resume) or 100 (everyone)")
    end
    UI.success("#{version.version_string}: phased release #{percent == '100' ? 'completed' : 'resumed'}")
  end

  desc "halt: pause the phased release (up to 30 days); users who have it keep it."
  lane :halt do
    asc_api_key
    version, phased = phased_release_of_live_version
    phased.pause
    UI.success("#{version.version_string}: phased release paused")
  end

  desc "Upload the store listing in every language (fastlane/metadata/<locale>/*.txt). " \
       "No build, no screenshots, no submission. Auth: App Store Connect API key " \
       "(ASC_KEY_ID/ASC_ISSUER_ID/ASC_KEY_CONTENT) or, on the Mac, the Apple ID in FASTLANE_USER."
  lane :metadata do
    api_key = if ENV["ASC_KEY_ID"]
      app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_content: ENV.fetch("ASC_KEY_CONTENT"),
        is_key_content_base64: true,
      )
    end
    deliver(
      api_key: api_key,
      metadata_path: "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end
end
