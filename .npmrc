# Security research #5 (2026-10-22), A1 — supply chain.
# No package may run code while it is being installed (the Shai-Hulud /
# s1ngularity worms of 2025 spread through npm install scripts). Every
# install script in our tree is optional (prebuilt binaries ship as
# optional platform packages: esbuild, sharp, @parcel/watcher, msgpackr,
# unrs-resolver, fsevents) or run explicitly:
#   - Prisma: `npx prisma generate` downloads the engines itself
#     (apps/api/Dockerfile, api-ci.yml, local setup);
#   - husky (root `prepare`): run `npm run prepare` once after cloning.
ignore-scripts=true
# A version published less than 7 days ago is not picked up by
# `npm install` / `npm update` (npm ≥ 11.10; older npm only warns about the
# key). `npm ci` installs the lock file as is. Dependabot has the same
# cooldown in .github/dependabot.yml.
min-release-age=7
audit=true
fund=false
