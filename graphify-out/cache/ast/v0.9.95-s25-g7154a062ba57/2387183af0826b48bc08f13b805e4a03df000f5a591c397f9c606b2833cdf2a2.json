{"nodes": [{"id": "$graphify-root$_apps_admin_content_guides_stripe_1099_md", "label": "stripe-1099.md", "file_type": "document", "node_kind": "page", "source_file": "apps/admin/content/guides/stripe-1099.md", "source_location": "L1", "frontmatter": {"id": "stripe-1099", "title": "\u041d\u0430\u043b\u043e\u0433\u043e\u0432\u044b\u0435 \u0444\u043e\u0440\u043c\u044b 1099 \u0434\u043b\u044f \u0430\u0434\u0432\u043e\u043a\u0430\u0442\u043e\u0432 (Stripe Connect)", "category": "money", "cost": "\u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u0444\u043e\u0440\u043c \u0438 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0430\u044f \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0430 \u0432\u0445\u043e\u0434\u044f\u0442 \u0432 \u0442\u0430\u0440\u0438\u0444. \u041f\u043e\u0434\u0430\u0447\u0430 \u0432 IRS \u043e\u043a\u043e\u043b\u043e $2.99 \u0437\u0430 \u0444\u043e\u0440\u043c\u0443, \u0432 \u0448\u0442\u0430\u0442 \u043e\u043a\u043e\u043b\u043e $1.49, \u0431\u0443\u043c\u0430\u0436\u043d\u0430\u044f \u043f\u043e\u0447\u0442\u0430 \u043e\u043a\u043e\u043b\u043e $2.99 (\u0446\u0435\u043d\u044b \u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430\u0445 Stripe \u0431\u0435\u0437 \u0434\u0430\u0442\u044b, \u0441\u0432\u0435\u0440\u044c\u0442\u0435).", "time": "30 \u043c\u0438\u043d\u0443\u0442 \u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0443, \u043f\u043e\u0442\u043e\u043c \u043a\u0430\u0436\u0434\u044b\u0439 \u0433\u043e\u0434 \u0441 \u043d\u043e\u044f\u0431\u0440\u044f \u043f\u043e \u044f\u043d\u0432\u0430\u0440\u044c", "verified": "2026-10-25", "sources": ["Stripe - \u043d\u0430\u043b\u043e\u0433\u043e\u0432\u0430\u044f \u043e\u0442\u0447\u0451\u0442\u043d\u043e\u0441\u0442\u044c \u0434\u043b\u044f \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c Connect (\u0421\u0428\u0410) | https://docs.stripe.com/connect/tax-reporting", "Stripe - \u043d\u0430\u0447\u0430\u043b\u043e \u0440\u0430\u0431\u043e\u0442\u044b \u0441 \u043e\u0442\u0447