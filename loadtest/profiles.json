{
  "_comment": "Single source for k6 (open() in k6/lib/profiles.js), the cost estimate and the workflow caps. api_max_tasks / generators must equal infra/envs/loadtest/profiles/<name>.tfvars (scripts/check-profiles.mjs enforces it).",
  "limits": {
    "max_wall_minutes": 120,
    "max_api_tasks": 48,
    "max_generators": 6,
    "abort_error_rate": 0.05,
    "abort_p95_ms": 2000,
    "abort_window_seconds": 60,
    "budgets": {
      "api_p95_ms": 800,
      "api_error_rate": 0.01,
      "cdn_p95_ms": 500,
      "cdn_error_rate": 0.01,
      "ws_connect_p95_ms": 3000,
      "ws_connected_min": 0.95,
      "room_join_min": 0.98,
      "chat_delivery_p95_ms": 2000,
      "chat_delivered_min": 0.98,
      "call_flow_min": 0.95
    }
  },
  "_gates": "P95 / error-rate budgets per scenario (owner rule 2026-10-24). Budget values: limits.budgets, overridden per profile in profiles.<name>.budgets. k6 (lib/profiles.js) turns these into thresholds WITHOUT abortOnFail (the run completes, k6 exits 99, the workflow fails and report.mjs prints the table); the abort rule above stays separate and stops the load. agg: p(95) = trend percentile, rate = Rate metric value. requires: the k6 scenarios that must exist for the gate to apply (any of).",
  "gates": [
    { "id": "api_p95", "label": "API p95 (ms)", "metric": "http_req_duration{scenario:http,kind:api}", "agg": "p(95)", "op": "<", "budget": "api_p95_ms", "requires": ["http"] },
    { "id": "api_errors", "label": "API error rate", "metric": "http_req_failed{scenario:http,kind:api}", "agg": "rate", "op": "<", "budget": "api_error_rate", "requires": ["http"] },
    { "id": "cdn_p95", "label": "CDN p95 (ms)", "metric": "http_req_duration{scenario:http,kind:cdn}", "agg": "p(95)", "op": "<", "budget": "cdn_p95_ms", "requires": ["http"], "needs_assets": true },
    { "id": "cdn_errors", "label": "CDN error rate", "metric": "http_req_failed{scenario:http,kind:cdn}", "agg": "rate", "op": "<", "budget": "cdn_error_rate", "requires": ["http"], "needs_assets": true },
    { "id": "ws_connect_p95", "label": "Socket connect p95 (ms)", "metric": "ws_connect_ms", "agg": "p(95)", "op": "<", "budget": "ws_connect_p95_ms", "requires": ["sockets", "storm"] },
    { "id": "ws_connected", "label": "Socket connects succeeded", "metric": "ws_connected", "agg": "rate", "op": ">", "budget": "ws_connected_min", "requires": ["sockets", "storm"] },
    { "id": "room_join", "label": "Room joins acknowledged", "metric": "room_join_ok", "agg": "rate", "op": ">", "budget": "room_join_min", "requires": ["sockets", "storm"] },
    { "id": "chat_p95", "label": "Chat delivery p95 (ms)", "metric": "chat_delivery_ms", "agg": "p(95)", "op": "<", "budget": "chat_delivery_p95_ms", "requires": ["sockets"] },
    { "id": "chat_delivered", "label": "Chat messages delivered", "metric": "chat_delivered", "agg": "rate", "op": ">", "budget": "chat_delivered_min", "requires": ["sockets"] },
    { "id": "call_flow", "label": "Call flows completed", "metric": "call_flow_ok", "agg": "rate", "op": ">", "budget": "call_flow_min", "requires": ["calls"] }
  ],
