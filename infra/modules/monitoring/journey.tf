# S12-12 + S12-14 (observability round 12).
#
# 1. Synthetic journey canary: a second CloudWatch Synthetics canary that signs in
#    with a dedicated test account, opens the feed and sends one message to a
#    dedicated test chat. It keeps the journey SLIs (login, message, feed) alive
#    at night, when no real person produces 5 events an hour. COST GATE: OFF by
#    default. Price: one run = $0.0012; rate(15 minutes) = 2 880 runs = about $3.5
#    a month (+ a few cents of S3). Ceiling = the schedule below; the existing
#    budget alarms cover the account.
# 2. Alarm -> incident row: every alarm state change in the alerts topic is posted
#    by a tiny Lambda to the API (internal token), which opens / closes a row in
#    system_incidents. The admin «Здоровье системы» timeline then shows alarms next
#    to probe incidents, and the post-mortem does not depend on memory. COST GATE:
#    OFF by default; Lambda: a few invocations a day, below the free tier.

variable "synthetic_journey_enabled" {
  type        = bool
  default     = false
  description = "S12-12: run the synthetic sign-in + feed + message canary. Off = nothing created, nothing billed. Needs synthetic_journey_secret_arn and synthetic_journey_conversation_id (docs/runbooks/slo.md#synthetic)."
}
variable "synthetic_journey_base_url" {
  type        = string
  default     = null
  description = "API origin the journey canary calls, e.g. https://api.example.com (no trailing slash)."
}
variable "synthetic_journey_secret_arn" {
  type        = string
  default     = null
  description = "Secrets Manager secret (JSON {\"identifier\": \"...\", \"password\": \"...\"}) of the dedicated test account. Never an owner or real user account."
}
variable "synthetic_journey_conversation_id" {
  type        = string
  default     = null
  description = "Id of the chat the test account sends its probe message to (a chat between two test accounts)."
}
variable "synthetic_journey_schedule" {
  type        = string
  default     = "rate(15 minutes)"
  description = "How often the journey canary runs. rate(15 minutes) is about 2 880 runs a month = $3.5; rate(5 minutes) is $10.4."
}

variable "alarm_incident_hook_enabled" {
  type        = bool
  default     = false
  description = "S12-14: a Lambda posts alarm state changes to the API (alarm_incident_hook_url) so they appear as incidents. Off = nothing created."
}
variable "alarm_incident_hook_url" {
  type        = string
  default     = null
  description = "https://<api host>/internal/alarm-events"
}
variable "alarm_incident_hook_token" {
  type        = string
  default     = null
  sensitive   = true
  description = "Shared internal token (the API reads the same value from ALARM_HOOK_TOKEN). Generated by the stack module."
}

locals {
  journey_on = var.synthetic_journey_enabled && var.synthetic_journey_base_url != null && var.synthetic_journey_secret_arn != null && var.synthetic_journey_conversation_id != null
  hook_on    = var.alarm_incident_hook_enabled && var.alarm_incident_hook_url != null && var.alarm_incident_hook_token != null
}

# ---- synthetic journey canary ---------------------------------------------------------
resource "aws_s3_bucket" "journey" {
  count         = local.journey_on ? 1 : 0
  bucket        = "${var.name}-journey-${data.aws_caller_identity.current.account_id}"
  force_destroy = true
  tags          = var.tags
}

resource "aws_s3_bucket_public_access_block" "journey" {
  count                   = local.journey_on ? 1 : 0
  bucket                  = aws_s3_bucket.journey[0].id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "journey" {
  count  = local.journey_on ? 1 : 0
  bucket = aws_s3_bucket.journey[0].id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "journey" {
  count  = local.journey_on ? 1 : 0
  bucket = aws_s3_bucket.journey[0].id
  rule {
    id     = "expire-runs"
    status = "Enabled"
    filter {}
    expiration {
      days = 7
    }
    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }
  }
}

resource "aws_iam_role" "journey" {
  count = local.journey_on ? 1 : 0
  name  = "${var.name}-journey-canary"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
  tags = var.tags
}

resource "aws_iam_role_policy" "journey" {
  count = local.journey_on ? 1 : 0
  name  = "journey-canary"
  role  = aws_iam_role.journey[0].id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      { Effect = "Allow", Action = ["s3:PutObject", "s3:GetObject"], Resource = "${aws_s3_bucket.journey[0].arn}/*" },
      { Effect = "Allow", Action = ["s3:GetBucketLocation", "s3:ListAllMyBuckets"], Resource = "*" },
      { Effect = "Allow", Action = ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"], Resource = "arn:aws:logs:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:log-group:/aws/lambda/cwsyn-*" },
      { Effect = "Allow", Action = "cloudwatch:PutMetricData", Resource = "*", Condition = { StringEquals = { "cloudwatch:namespace" = "CloudWatchSynthetics" } } },
      { Effect = "Allow", Action = "secretsmanager:GetSecretValue", Resource = var.synthetic_journey_secret_arn },
    ]
  })
}

data "archive_file" "journey" {
  count       = local.journey_on ? 1 : 0
  type        = "zip"
  output_path = "${path.module}/.journey-${var.name}.zip"
  source {
    filename = "nodejs/node_modules/journey.js"
    content  = <<-JS
      // S12-12: sign in with the test account, open the feed, send one message.
      // Any step that is not 2xx fails the run (and so SuccessPercent).
      const synthetics = require('Synthetics');
      const https = require('https');
      const { SecretsManagerClient, GetSecretValueCommand } = require('@aws-sdk/client-secrets-manager');
      const base = new URL(process.env.JOURNEY_BASE_URL);
      function call(method, path, body, token) {
        return new Promise((resolve, reject) => {
          const payload = body ? JSON.stringify(body) : null;
          const req = https.request(
            { hostname: base.hostname, path, method, timeout: 10000,
              headers: Object.assign({ 'User-Agent': 'LawBid-journey-canary', 'Accept': 'application/json' },
                payload ? { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload) } : {},
                token ? { Authorization: 'Bearer ' + token } : {}) },
            (res) => {
              let data = '';
              res.on('data', (c) => (data += c));
              res.on('end', () => {
                if (res.statusCode < 200 || res.statusCode >= 300) return reject(new Error(method + ' ' + path.split('?')[0] + ' -> HTTP ' + res.statusCode));
                try { resolve(data ? JSON.parse(data) : {}); } catch (e) { resolve({}); }
              });
            });
          req.on('timeout', () => req.destroy(new Error('timeout')));
          req.on('error', reject);
          if (payload) req.write(payload);
          req.end();
        });
      }
      exports.handler = async () => {
        let token;
        await synthetics.executeStep('login', async () => {
          const sm = new SecretsManagerClient({});
          const secret = JSON.parse((await sm.send(new GetSecretValueCommand({ SecretId: process.env.JOURNEY_SECRET_ARN }))).SecretString);
          const out = await call('POST', '/api/v1/auth/password/login', { identifier: secret.identifier, password: secret.password });
          token = (out.data && out.data.accessToken) || out.accessToken;
          if (!token) throw new Error('login: no accessToken');
        });
        await synthetics.executeStep('feed', () => call('GET', '/api/v1/feed?limit=10', null, token));
        await synthetics.executeStep('message', () =>
          call('POST', '/api/v1/conversations/' + process.env.JOURNEY_CONVERSATION_ID + '/messages',
            { clientMessageId: 'canary-' + Date.now(), type: 'text', text: 'canary' }, token));
      };
    JS
  }
}

resource "aws_synthetics_canary" "journey" {
  count                = local.journey_on ? 1 : 0
  name                 = substr(replace("${var.name}-jr", "_", "-"), 0, 21)
  artifact_s3_location = "s3://${aws_s3_bucket.journey[0].bucket}/runs"
  execution_role_arn   = aws_iam_role.journey[0].arn
  handler              = "journey.handler"
  zip_file             = data.archive_file.journey[0].output_path
  runtime_version      = var.canary_runtime
  start_canary         = true
  schedule {
    expression = var.synthetic_journey_schedule
  }
  run_config {
    timeout_in_seconds = 60
    environment_variables = {
      JOURNEY_BASE_URL        = var.synthetic_journey_base_url
      JOURNEY_SECRET_ARN      = var.synthetic_journey_secret_arn
      JOURNEY_CONVERSATION_ID = var.synthetic_journey_conversation_id
    }
  }
  success_retention_period = 1
  failure_retention_period = 7
  tags                     = var.tags
}

resource "aws_cloudwatch_metric_alarm" "journey_canary" {
  count               = local.journey_on ? 1 : 0
  alarm_name          = "${var.name}-journey-canary"
  alarm_description   = "LawBid: Тестовый пользователь не смог пройти путь «вход → лента → сообщение» два раза подряд. Что делать: попробовать самому; CloudWatch → Synthetics → ${var.name}-jr → последний запуск покажет шаг, который упал (login / feed / message). Инструкция: ${var.runbook_base_url}/slo.md#synthetic (EN: The synthetic login + feed + message canary failed twice in a row.)"
  comparison_operator = "LessThanThreshold"
  evaluation_periods  = 2
  datapoints_to_alarm = 2
  period              = 900
  threshold           = 100
  statistic           = "Average"
  metric_name         = "SuccessPercent"
  namespace           = "CloudWatchSynthetics"
  dimensions          = { CanaryName = aws_synthetics_canary.journey[0].name }
  treat_missing_data  = "breaching"
  alarm_actions       = local.ops
  ok_actions          = local.ops
  tags                = var.tags
}

# ---- alarm -> incident row ----------------------------------------------------------
data "archive_file" "alarm_hook" {
  count       = local.hook_on ? 1 : 0
  type        = "zip"
  output_path = "${path.module}/.alarm-hook-${var.name}.zip"
  source {
    filename = "index.js"
    content  = <<-JS
      // S12-14: SNS (CloudWatch alarm state change) -> API incident row.
      // The API answers 2xx even for an alarm it ignores; a failure throws so SNS retries.
      exports.handler = async (event) => {
        for (const rec of event.Records || []) {
          let msg;
          try { msg = JSON.parse(rec.Sns.Message); } catch (e) { continue; }
          if (!msg.AlarmName || !msg.NewStateValue) continue; // not an alarm message (budget, event)
          const res = await fetch(process.env.HOOK_URL, {
            method: 'POST',
            headers: { 'content-type': 'application/json', 'x-internal-token': process.env.HOOK_TOKEN },
            body: JSON.stringify({
              alarmName: msg.AlarmName,
              state: msg.NewStateValue,
              reason: String(msg.NewStateReason || '').slice(0, 500),
              at: msg.StateChangeTime,
            }),
            signal: AbortSignal.timeout(8000),
          });
          if (!res.ok) throw new Error('hook HTTP ' + res.status);
        }
      };
    JS
  }
}

resource "aws_cloudwatch_log_group" "alarm_hook" {
  count             = local.hook_on ? 1 : 0
  name              = "/aws/lambda/${var.name}-alarm-hook"
  retention_in_days = 14
  tags              = var.tags
}

resource "aws_iam_role" "alarm_hook" {
  count = local.hook_on ? 1 : 0
  name  = "${var.name}-alarm-hook"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
  tags = var.tags
}

resource "aws_iam_role_policy" "alarm_hook" {
  count = local.hook_on ? 1 : 0
  name  = "logs"
  role  = aws_iam_role.alarm_hook[0].id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["logs:CreateLogStream", "logs:PutLogEvents"]
      Resource = "${aws_cloudwatch_log_group.alarm_hook[0].arn}:*"
    }]
  })
}

resource "aws_lambda_function" "alarm_hook" {
  count            = local.hook_on ? 1 : 0
  function_name    = "${var.name}-alarm-hook"
  role             = aws_iam_role.alarm_hook[0].arn
  runtime          = "nodejs22.x"
  handler          = "index.handler"
  filename         = data.archive_file.alarm_hook[0].output_path
  source_code_hash = data.archive_file.alarm_hook[0].output_base64sha256
  timeout          = 15
  memory_size      = 128
  environment {
    variables = {
      HOOK_URL   = var.alarm_incident_hook_url
      HOOK_TOKEN = var.alarm_incident_hook_token
    }
  }
  depends_on = [aws_cloudwatch_log_group.alarm_hook]
  tags       = var.tags
}

resource "aws_lambda_permission" "alarm_hook_sns" {
  count         = local.hook_on ? 1 : 0
  statement_id  = "AllowSnsAlerts"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.alarm_hook[0].function_name
  principal     = "sns.amazonaws.com"
  source_arn    = aws_sns_topic.alerts.arn
}

# Only the alerts topic: every paging alarm also publishes there (local.page).
resource "aws_sns_topic_subscription" "alarm_hook" {
  count     = local.hook_on ? 1 : 0
  topic_arn = aws_sns_topic.alerts.arn
  protocol  = "lambda"
  endpoint  = aws_lambda_function.alarm_hook[0].arn
}
