#!/bin/bash
# coturn for LawBid calls (infra/modules/turn). Runs once at first boot.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
# Row 202 (16.11): coturn from its OFFICIAL multi-arch image, pinned by digest
# (4.18.0, 08.09.2026, https://hub.docker.com/r/coturn/coturn), used as is.
# Ubuntu 24.04's apt package is 4.6.1 (2023), years behind upstream.
COTURN_IMAGE="coturn/coturn:4.18.0@sha256:bbefd3e1fdfdc0d58770fe01b581fd8b00d9f3a5580d00acb77cf719a6bc78e3"
apt-get install -y docker.io curl
systemctl enable --now docker
for _ in 1 2 3 4 5; do docker pull "$COTURN_IMAGE" && break; sleep 10; done
docker image inspect "$COTURN_IMAGE" >/dev/null
snap install aws-cli --classic

# The instance's private address for the relay, the public one for clients.
TOKEN="$(curl -sX PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')"
%{ if on_demand ~}
# Owner 2026-11-02 (on-demand): no Elastic IP, the public address is new at every
# start. The config is rewritten before EVERY coturn start (ExecStartPre).
cat > /usr/local/bin/turn-config <<'SCRIPT'
#!/bin/bash
set -euo pipefail
SECRET="$(/snap/bin/aws ssm get-parameter --region ${region} \
  --name ${secret_param} --with-decryption --query Parameter.Value --output text)"
TOKEN="$(curl -sX PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')"
PRIVATE_IP="$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)"
PUBLIC_IP="$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/public-ipv4)"
cat > /etc/turnserver.conf <<CONF
listening-port=3478
tls-listening-port=5349
listening-ip=0.0.0.0
relay-ip=$PRIVATE_IP
external-ip=$PUBLIC_IP/$PRIVATE_IP
min-port=49152
max-port=65535
realm=${realm}
fingerprint
use-auth-secret
static-auth-secret=$SECRET
# CLI is off by default since coturn 4.18 (no-cli is deprecated there).
no-multicast-peers
no-tcp-relay
total-quota=${quota}
user-quota=${user_quota}
max-allocate-lifetime=${max_lifetime}
max-bps=${max_bps}
bps-capacity=0
stale-nonce=600
# stdout -> journal of the coturn unit (journalctl -u coturn), as syslog was.
log-file=stdout
%{ for cidr in denied ~}
denied-peer-ip=${cidr}
%{ endfor ~}
CONF
chmod 640 /etc/turnserver.conf
# The image runs coturn as nobody:nogroup (65534).
chown root:65534 /etc/turnserver.conf
SCRIPT
chmod 755 /usr/local/bin/turn-config
mkdir -p /etc/systemd/system/coturn.service.d
cat > /etc/systemd/system/coturn.service.d/on-demand.conf <<'UNIT'
[Service]
ExecStartPre=+/usr/local/bin/turn-config
UNIT
/usr/local/bin/turn-config
%{ else ~}
SECRET="$(/snap/bin/aws ssm get-parameter --region ${region} \
  --name ${secret_param} --with-decryption --query Parameter.Value --output text)"
# The instance's private address for the relay, the public one for clients.
TOKEN="$(curl -sX PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')"
PRIVATE_IP="$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)"

cat > /etc/turnserver.conf <<CONF
listening-port=3478
tls-listening-port=5349
listening-ip=0.0.0.0
relay-ip=$PRIVATE_IP
external-ip=${external_ip}/$PRIVATE_IP
min-port=49152
max-port=65535
realm=${realm}
fingerprint
use-auth-secret
static-auth-secret=$SECRET
# The API issues logins that live a few minutes (TURN REST API).
# CLI is off by default since coturn 4.18 (no-cli is deprecated there).
no-multicast-peers
no-tcp-relay
total-quota=${quota}
user-quota=${user_quota}
max-allocate-lifetime=${max_lifetime}
max-bps=${max_bps}
bps-capacity=0
stale-nonce=600
# stdout -> journal of the coturn unit (journalctl -u coturn), as syslog was.
log-file=stdout
%{ for cidr in denied ~}
denied-peer-ip=${cidr}
%{ endfor ~}
CONF
chmod 640 /etc/turnserver.conf
# The image runs coturn as nobody:nogroup (65534).
chown root:65534 /etc/turnserver.conf

%{ endif ~}

%{ if tcp_443 ~}
# 26.11: TURN over TCP on 443 for networks that let only 443 out (offices,
# hotels). coturn runs as nobody and cannot bind a port below 1024, so the
# kernel forwards TCP 443 to coturn's 3478 (one REDIRECT rule, restored
# before every coturn start); coturn tells plain TURN and TLS apart on the
# same port by itself (README.turnserver, listening-port note). The relay
# ports and 3478 are unchanged. The API offers turn:<host>:443?transport=tcp
# (admin setting calls.own_turn.port_443).
cat > /etc/systemd/system/turn-443.service <<'UNIT'
[Unit]
Description=Forward TCP 443 to coturn 3478
Before=coturn.service
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/iptables -t nat -C PREROUTING -p tcp --dport 443 -j REDIRECT --to-ports 3478 2>/dev/null || /usr/sbin/iptables -t nat -A PREROUTING -p tcp --dport 443 -j REDIRECT --to-ports 3478'
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now turn-443.service

%{ endif ~}
# coturn as a systemd service around the pinned image. Host network: the
# relay ports 49152-65535 and 3478/5349 are the box's own (the security group
# is unchanged), and turn-report below still counts the relay sockets with ss.
# `docker run` stays in the foreground, so its output lands in
# `journalctl -u coturn` exactly like the apt package's did.
cat > /etc/systemd/system/coturn.service <<UNIT
[Unit]
Description=coturn TURN server (official image, pinned by digest)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
[Service]
ExecStartPre=-/usr/bin/docker rm -f coturn
ExecStart=/usr/bin/docker run --rm --name coturn --network host --log-opt max-size=10m --log-opt max-file=2 -v /etc/turnserver.conf:/etc/coturn/turnserver.conf:ro $COTURN_IMAGE -c /etc/coturn/turnserver.conf
ExecStop=/usr/bin/docker stop -t 10 coturn
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
UNIT
# Allocation count -> CloudWatch (LawBid/TURN, Allocations) once a minute.
# Every allocation binds one UDP relay port in 49152-65535, so counting those
# sockets = counting allocations (no coturn CLI or Prometheus needed).
IID="$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)"
cat > /usr/local/bin/turn-report <<'SCRIPT'
#!/bin/bash
N="$(ss -H -uan | awk '{n=split($4,a,":"); if (a[n] >= 49152) c++} END {print c+0}')"
/snap/bin/aws cloudwatch put-metric-data --region "$1" --namespace LawBid/TURN \
  --metric-name Allocations --dimensions "InstanceId=$2" --value "$N" --unit Count
SCRIPT
chmod 755 /usr/local/bin/turn-report
cat > /etc/systemd/system/turn-report.service <<UNIT
[Service]
Type=oneshot
ExecStart=/usr/local/bin/turn-report ${region} $IID
UNIT
cat > /etc/systemd/system/turn-report.timer <<'UNIT'
[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now turn-report.timer

systemctl enable coturn
systemctl restart coturn
