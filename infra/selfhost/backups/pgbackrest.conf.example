# Copy to /etc/pgbackrest/pgbackrest.conf. Keys come from the environment,
# never from this file: PGBACKREST_REPO1_S3_KEY, PGBACKREST_REPO1_S3_KEY_SECRET.
[global]
repo1-type=s3
repo1-s3-endpoint=minio.internal:9000
repo1-s3-bucket=lawbid-backups
repo1-s3-region=us-east-1
repo1-s3-uri-style=path
# MinIO with our own CA: keep verification on and point at the CA file.
repo1-storage-verify-tls=y
repo1-storage-ca-file=/etc/ssl/lawbid-ca.crt
repo1-path=/pgbackrest
# Same as RDS today: 14 days of point-in-time restore (two weekly fulls).
repo1-retention-full=2
repo1-cipher-type=aes-256-cbc
start-fast=y
log-level-console=info
[lawbid]
pg1-path=/var/lib/postgresql/data
