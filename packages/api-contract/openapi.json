  "info": {
    "title": "LawBid API",
    "description": "LawBid — US legal-services marketplace. See docs/01_FOUNDATION_AUTH.md §7 for response/error format conventions.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "phone",
              "email"
            ]
          },
          "identifier": {
            "type": "string"
          }
        },
        "required": [
          "channel",
          "identifier"
        ]
      },
      "DeviceInfoDto": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "maxLength": 255
          },
          "deviceName": {
            "type": "string",
            "maxLength": 255
          },
          "platform": {
            "type": "string",
            "maxLength": 50
          },
          "appVersion": {
            "type": "string",
            "maxLength": 50
          }
        }
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "phone",
              "email"
            ]
          },
          "identifier": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "deviceInfo": {
            "$ref": "#/components/schemas/DeviceInfoDto"
          }
        },
        "required": [
          "channel",
          "identifier",
          "code"
        ]
      },
      "SocialLoginDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "apple",
              "google"
            ]
          },
          "idToken": {
            "type": "string"
          },
          "nonce": {
            "type": "string"
          },
          "firstName": {
            "type": "string",
            "maxLength": 120
          },
          "lastName": {
            "type": "string",
            "maxLength": 120
          },
          "deviceInfo": {
            "$ref": "#/components/schemas/DeviceInfoDto"
          }
        },
        "required": [
          "provider",
          "idToken",
          "nonce"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          },
          "deviceInfo": {
            "$ref": "#/components/schemas/DeviceInfoDto"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ReauthDto": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "otp"
            ]
          },
          "identifier": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "method",
          "identifier",
          "code"
        ]
      },
      "LinkIdentifierDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "phone",
              "email",
              "apple",
              "google"
            ]
          },
          "identifier": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "idToken": {
            "type": "string"
          },
          "nonce": {
            "type": "string"
          }
        },
        "required": [
          "provider"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "uiLanguage": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          }
        }
      },
      "SetRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "client",
              "attorney"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "SaveOnboardingStepDto": {
        "type": "object",
        "properties": {
          "currentStep": {
            "type": "string",
            "enum": [
              "language",
              "consents",
              "role",
              "profile",
              "contacts",
              "push",
              "verification",
              "tour"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Step-local form data (e.g. client state/languages until the\nclient_profiles table lands in stage 2.3). Merged, not replaced."
          }
        },
        "required": [
          "currentStep"
        ]
      },
      "ContactRequestDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "phone",
              "email"
            ]
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ]
      },
      "ContactVerifyDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "phone",
              "email"
            ]
          },
          "value": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "type",
          "value",
          "code"
        ]
      },
      "ConsentItemDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "terms",
              "privacy",
              "disclaimer",
              "client_contact_sharing",
              "age_18",
              "marketing_email",
              "marketing_push",
              "analytics"
            ]
          },
          "granted": {
            "type": "boolean"
          },
          "documentId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "type",
          "granted"
        ]
      },
      "SaveConsentsDto": {
        "type": "object",
        "properties": {
          "consents": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentItemDto"
            }
          }
        },
        "required": [
          "consents"
        ]
      }
    }
  }
}
