    "/api/v1/i18n/bundle/{lang}": {
      "get": {
        "operationId": "I18nController_getBundle",
        "parameters": [
          {
            "name": "lang",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "GET /i18n/bundle/:lang?since=version. Bypasses the global\nResponseInterceptor's {data:...} envelope deliberately (@Res()\nwithout `passthrough`, per Nest's documented raw-response-control\npattern) — that's the only way to send a spec-correct empty-body 304\nfor a matching ETag (docs/01_FOUNDATION_AUTH.md §9.3: \"Поддержка\nETag/304\"). Every other route in this module returns normally and\ngets the standard envelope.\n\nETag/304 is the plain-GET HTTP-cache path (no `since`): if the\nclient's If-None-Match matches the language's current version, 304\nwith no body. `since` is the separate, explicit delta-poll path\n(§9.3: \"полный или дельта-набор + version\") — it always returns 200\nwith a (possibly empty) JSON body, never a 304, since it's a\nversioned query the client is actively asking for, not a cache\nrevalidation.",
        "tags": [
          "I18n"
        ]
      }
    },
